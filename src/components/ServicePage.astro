---
import Footer from "./Footer.astro";
import Icon from "./icons/Icon.astro";
import AlignTarget from "./icons/glyphs/AlignTarget.astro";
import Assure from "./icons/glyphs/Assure.astro";
import Automation from "./icons/glyphs/Automation.astro";
import Capability from "./icons/glyphs/Capability.astro";
import Charter from "./icons/glyphs/Charter.astro";
import Dialogue from "./icons/glyphs/Dialogue.astro";
import DocCalendar from "./icons/glyphs/DocCalendar.astro";
import DocChart from "./icons/glyphs/DocChart.astro";
import DocReport from "./icons/glyphs/DocReport.astro";
import DocTick from "./icons/glyphs/DocTick.astro";
import Evidence from "./icons/glyphs/Evidence.astro";
import FutureState from "./icons/glyphs/FutureState.astro";
import Gauge from "./icons/glyphs/Gauge.astro";
import Layout from "../layouts/Layout.astro";
import Loop from "./icons/glyphs/Loop.astro";
import Nav from "./Nav.astro";
import Network from "./icons/glyphs/Network.astro";
import Roadmap from "./icons/glyphs/Roadmap.astro";
import RootCause from "./icons/glyphs/RootCause.astro";
import Standardise from "./icons/glyphs/Standardise.astro";
import Transfer from "./icons/glyphs/Transfer.astro";
import "../styles/services.css";

const glyphs = {
  "align-target": AlignTarget,
  assure: Assure,
  automation: Automation,
  capability: Capability,
  charter: Charter,
  dialogue: Dialogue,
  "doc-calendar": DocCalendar,
  "doc-chart": DocChart,
  "doc-report": DocReport,
  "doc-tick": DocTick,
  evidence: Evidence,
  "future-state": FutureState,
  gauge: Gauge,
  loop: Loop,
  network: Network,
  roadmap: Roadmap,
  "root-cause": RootCause,
  standardise: Standardise,
  transfer: Transfer,
} as const;

type GlyphName = keyof typeof glyphs;
type PillarName = "frame" | "plan" | "solve" | "evolve" | "govern" | "scale";

interface Column {
  title: string;
  body: string;
  glyph: GlyphName;
}

interface Deliverable {
  title: string;
  body: string;
  glyph: GlyphName;
}

interface CaseStudy {
  sector: string;
  metric: string;
  caption: string;
  title: string;
  problem: string;
  approach: string;
  outcome: string;
}

interface StepConfig {
  pillar: PillarName;
  eyebrow: string;
  serviceName: string;
  summary: string;
  href?: string;
  linkLabel?: string;
}

interface MethodLink {
  name: string;
  href: string;
  icon: "method-lean-business-analysis" | "method-lean" | "method-lean-six-sigma" | "method-lean-service-design" | "method-lean-agile";
  blurb: string;
}

interface ServicePageData {
  title: string;
  description: string;
  pillar: PillarName;
  eyebrow: string;
  serviceName: string;
  heroTitle: string;
  heroSubhead: string;
  methods?: MethodLink[];
  situationTitle: string;
  situation: string[];
  whyTitle: string;
  whyBody: string[];
  callout: {
    lead: string;
    body: string;
  };
  proofPoints: Column[];
  examineTitle: string;
  examineIntro: string;
  examineItems: Column[];
  deliverablesTitle: string;
  deliverablesIntro: string;
  deliverables: Deliverable[];
  cases: CaseStudy[];
  pathwayTitle: string;
  pathwayIntro: string;
  currentIndex: number;
  nextStepIntro: string;
  currentStep: StepConfig;
  nextStep: StepConfig;
  ctaTitle: string;
  ctaBody: string;
  timeline: string;
  howWeWork: string;
}

interface Props {
  data: ServicePageData;
}

const { data } = Astro.props;
const stations = [
  { key: "FRAME", x: 70, y: 100 },
  { key: "PLAN", x: 250, y: 97 },
  { key: "SOLVE", x: 430, y: 99 },
  { key: "EVOLVE", x: 610, y: 101 },
  { key: "GOVERN", x: 790, y: 98 },
  { key: "SCALE", x: 970, y: 98 },
];
const currentStation = stations[data.currentIndex];
const nextStationIndex = data.currentIndex < stations.length - 1 ? data.currentIndex + 1 : -1;
const nextStation = nextStationIndex >= 0 ? stations[nextStationIndex] : undefined;
const calloutX = Math.min(910, Math.max(130, currentStation.x));
const pointerD = `M${calloutX} 34 L${currentStation.x} ${currentStation.y - 22}`;
const nextSegmentD = nextStation
  ? `M${currentStation.x} ${currentStation.y} Q${(currentStation.x + nextStation.x) / 2} ${((currentStation.y + nextStation.y) / 2) - 5} ${nextStation.x} ${nextStation.y}`
  : "";
const deliverablesCarouselId = `${data.pillar}-deliverables-carousel`;
---

<Layout title={data.title} description={data.description}>
  <Nav />
  <main>
    <section class="service-hero service-reveal">
      <div class="service-hero-inner">
        <div class="service-hero-copy">
          <div class="eyebrow">{data.eyebrow}</div>
          <h1>{data.heroTitle}</h1>
          <p class="service-hero-subhead">{data.heroSubhead}</p>
          <div class="service-actions">
            <a href="/contact/" class="btn-primary">Get in touch</a>
            <a href="/our-work/" class="btn-text"><span class="link-label">View our work</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="service-hero-art" aria-hidden="true">
          <!-- hero art: pillar icon at hero scale, fine-line interim — per-pillar hero scene swaps in here later (artwork-authority) -->
          <span><Icon name={data.pillar} /></span>
        </div>
      </div>
    </section>

    <section class="service-section beige service-reveal">
      <div class="service-inner service-prose">
        <div class="eyebrow">THE SITUATION</div>
        <h2 class="service-title">{data.situationTitle}</h2>
        {data.situation.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="service-section white service-reveal">
      <div class="service-inner">
        <div class="service-head">
          <div class="eyebrow">WHY START HERE</div>
          <h2 class="service-title">{data.whyTitle}</h2>
          {data.whyBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="service-callout">
          <p class="service-callout-lead">{data.callout.lead}</p>
          <p>{data.callout.body}</p>
        </aside>
        <div class="service-columns proof-columns">
          {data.proofPoints.map((item) => {
            const Glyph = glyphs[item.glyph];
            return (
              <article class="service-col">
                <span class="proof-glyph" aria-hidden="true"><Glyph /></span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="service-section beige service-reveal">
      <div class="service-inner">
        <div class="service-head">
          <div class="eyebrow">WHAT WE DO</div>
          <h2 class="service-title">{data.examineTitle}</h2>
          <p>{data.examineIntro}</p>
        </div>
        <div class="service-columns examine-columns">
          {data.examineItems.map((item) => {
            const Glyph = glyphs[item.glyph];
            return (
              <article class="service-col">
                <span class="examine-glyph" aria-hidden="true"><Glyph /></span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="service-section white service-reveal">
      <div class="service-inner">
        <div class="service-head">
          <div class="eyebrow">WHAT YOU RECEIVE</div>
          <h2 class="service-title">{data.deliverablesTitle}</h2>
          <p>{data.deliverablesIntro}</p>
        </div>
        <div class="service-carousel" data-service-carousel>
          <div class="deliverables-index" aria-label="Deliverables index">
            {data.deliverables.map((item, index) => (
              <button
                class:list={["deliverables-index-button", { "is-active": index === 0 }]}
                type="button"
                data-carousel-index={index}
                aria-controls={deliverablesCarouselId}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="deliverables-index-marker" aria-hidden="true"></span>
                <span>{item.title}</span>
              </button>
            ))}
          </div>
          <div class="service-track" id={deliverablesCarouselId} role="region" aria-label={`${data.serviceName} deliverables carousel`}>
            {data.deliverables.map((item) => {
              const Glyph = glyphs[item.glyph];
              return (
                <article class="service-slide">
                  <div class="doc-panel" aria-hidden="true">
                    <!-- placeholder document panel — real mockup image swaps in here later (EQT-274) -->
                    <span><Glyph /></span>
                  </div>
                  <div class="slide-copy">
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </div>
                </article>
              );
            })}
          </div>
          <div class="carousel-controls">
            <div class="carousel-dots" aria-hidden="true">
              {data.deliverables.map((_, index) => <span class:list={["carousel-dot", { "is-active": index === 0 }]}></span>)}
            </div>
            <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Previous deliverable">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19"/></svg>
            </button>
            <button class="carousel-arrow" type="button" data-carousel-next aria-label="Next deliverable">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19"/></svg>
            </button>
          </div>
        </div>
        {data.methods && data.methods.length > 0 && (
          <div class="service-deliverable-methods">
            <span class="eyebrow">THE METHODS BEHIND THIS WORK</span>
            <div class="service-deliverable-method-grid">
              {data.methods.map((method) => (
                <article class="service-deliverable-method">
                  <div class="service-deliverable-method-head">
                    <span class="service-deliverable-method-icon" aria-hidden="true"><Icon name={method.icon} /></span>
                    <a href={method.href} class="btn-text"><span class="link-label">{method.name}</span> <span class="ar">&rsaquo;</span></a>
                  </div>
                  <p>{method.blurb}</p>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="service-section beige service-reveal">
      <div class="service-inner">
        <div class="service-head">
          <div class="eyebrow">OUR WORK</div>
          <h2 class="service-title">Proven in practice.</h2>
        </div>
        <div class="case-list">
          {data.cases.map((item) => (
            <article class="case">
              <div class="case-meta">
                <div class="case-sector">{item.sector}</div>
                <div class="case-number">{item.metric}</div>
                <div class="case-caption">{item.caption}</div>
              </div>
              <div>
                <h3>{item.title}</h3>
                <div class="case-block"><p class="case-label">Problem</p><p>{item.problem}</p></div>
                <div class="case-block"><p class="case-label">Approach</p><p>{item.approach}</p></div>
                <div class="case-block"><p class="case-label">Outcome</p><p>{item.outcome}</p></div>
                <a href="/our-work/" class="btn-text"><span class="link-label">View our work</span> <span class="ar">&rsaquo;</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="service-section white service-reveal">
      <div class="service-inner">
        <div class="service-head">
          <div class="eyebrow">WHERE IT LEADS</div>
          <h2 class="service-title">{data.pathwayTitle}</h2>
          <p>{data.pathwayIntro}</p>
        </div>
        <div class="pathway-box">
          <svg viewBox="0 0 1040 150" role="img" aria-label="FRAME to SCALE progression">
            <path class="hd-f2" d="M70 100 Q300 90 520 99 Q760 109 970 98"/>
            {nextStation && <path class="pathway-next-segment" d={nextSegmentD}/>}
            <text x={calloutX} y="24" text-anchor="middle" class="pathway-label">YOU ARE HERE</text>
            <path class="pathway-pointer" d={pointerD}/>
            {nextStation && <text x={nextStation.x} y="56" text-anchor="middle" class="pathway-next-label">NEXT</text>}
            {stations.map((station, index) => (
              <>
                <circle
                  cx={station.x}
                  cy={station.y}
                  r={index === data.currentIndex ? 11 : 8}
                  fill="#fff"
                  stroke={index === data.currentIndex ? "#C15F3C" : "#26245C"}
                  stroke-width={index === data.currentIndex ? 2.6 : 2}
                />
                {index === data.currentIndex && <circle cx={station.x} cy={station.y} r="4" fill="#C15F3C" />}
                {index === nextStationIndex && <circle cx={station.x} cy={station.y} r="3.2" fill="#26245C" />}
              </>
            ))}
            <g font-family="Montserrat, Arial, sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">
              {stations.map((station, index) => (
                <text x={station.x} y="138" fill={index === data.currentIndex || index === nextStationIndex ? "#26245C" : "#7A8591"}>{station.key}</text>
              ))}
            </g>
          </svg>
        </div>
        <div class="next-grid">
          {[data.currentStep, data.nextStep].map((step, index) => (
            <article class:list={["next-col", index === 0 ? "is-current" : "is-next"]}>
              <div class="next-status">{index === 0 ? "YOU ARE HERE" : "THE NEXT STEP"}</div>
              <span class="next-icon" aria-hidden="true"><Icon name={step.pillar} /></span>
              <div class="next-kicker">{step.eyebrow}</div>
              <h3>{step.serviceName}</h3>
              <p>{step.summary}</p>
              {index === 1 && step.href && step.linkLabel && (
                <a href={step.href} class="btn-text"><span class="link-label">{step.linkLabel}</span> <span class="ar">&rsaquo;</span></a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="service-section beige service-reveal">
      <div class="service-inner">
        <div class="cta-equation">
          <div class="eyebrow light">WORK WITH US</div>
          <h2>{data.ctaTitle}</h2>
          <p>{data.ctaBody}</p>
          <div class="cta-eq-row" aria-label={`Typical ${data.pillar.toUpperCase()} engagement details`}>
            <div class="cta-eq-box">
              <div class="cta-label">Typical timeline</div>
              <div class="cta-value">{data.timeline}</div>
            </div>
            <div class="cta-op" aria-hidden="true">+</div>
            <div class="cta-eq-box">
              <div class="cta-label">How we work</div>
              <div class="cta-value">{data.howWeWork}</div>
            </div>
            <div class="cta-op" aria-hidden="true">=</div>
            <div class="cta-eq-box cta-deliverables">
              <div class="cta-label">What you get</div>
              <ul>
                {data.deliverables.map((item) => <li>{item.title}</li>)}
              </ul>
            </div>
          </div>
          <a href="/contact/" class="btn-primary">Get in touch</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initialiseServiceCarousel(carousel) {
    const track = carousel.querySelector(".service-track");
    if (!track) return;
    const previous = carousel.querySelector("[data-carousel-prev]");
    const next = carousel.querySelector("[data-carousel-next]");
    const dots = Array.from(carousel.querySelectorAll(".carousel-dot"));
    const indexButtons = Array.from(carousel.querySelectorAll("[data-carousel-index]"));
    const firstSlide = track.querySelector(".service-slide");
    const gap = () => parseFloat(window.getComputedStyle(track).columnGap) || 0;
    const step = () => firstSlide ? firstSlide.getBoundingClientRect().width + gap() : track.clientWidth * 0.78;
    const scrollToIndex = (index) => track.scrollTo({ left: index * step(), behavior: "smooth" });
    const sync = () => {
      const index = Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / step())));
      dots.forEach((dot, position) => dot.classList.toggle("is-active", position === index));
      indexButtons.forEach((button, position) => {
        button.classList.toggle("is-active", position === index);
        button.setAttribute("aria-pressed", position === index ? "true" : "false");
      });
    };
    previous?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    indexButtons.forEach((button) => {
      button.addEventListener("click", () => scrollToIndex(Number(button.dataset.carouselIndex || 0)));
    });
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  }

  document.querySelectorAll("[data-service-carousel]").forEach(initialiseServiceCarousel);

  function initialiseServiceReveals() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".service-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("service-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.16 });
    sections.forEach((section) => observer.observe(section));
  }

  initialiseServiceReveals();
</script>
