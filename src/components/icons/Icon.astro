---
/**
 * EQUIBT v6x icon library dispatcher (EQT-272 adopted hand-drawn idiom;
 * supersedes the EQT-251 single-weight set, preserved in git history PR #36).
 *
 * Hand-drawn line-art, navy #26245C, exactly one terracotta #C15F3C accent
 * each, 110px uniform (sized by the page wrapper, e.g. .svc-icon / .ic).
 * All ten icon-slot icons share the same square 64 viewBox (hard rule — no
 * squeeze artifacts). Stroke weight is CODE-authority via .hd / .hd-acc /
 * .hd-f1..f3 in src/styles/base.css — never per-icon overrides.
 *
 * SVGs are hand-vectorised originals; the GPT rasters in Docs/EQUIBT
 * (CANDIDATE_SET_v3 / SECTORS_v2 / HERO_v1 / CTA_v2) are look targets only.
 *
 * Usage: <Icon name="frame" />  ·  <Icon name="financial-services" />
 */
import CtaMotif from "./CtaMotif.astro";
import Evolve from "./Evolve.astro";
import FinancialServices from "./FinancialServices.astro";
import Frame from "./Frame.astro";
import Government from "./Government.astro";
import Govern from "./Govern.astro";
import HeroMotif from "./HeroMotif.astro";
import Manufacturing from "./Manufacturing.astro";
import Plan from "./Plan.astro";
import Scale from "./Scale.astro";
import Solve from "./Solve.astro";
import Utilities from "./Utilities.astro";

const icons = {
  frame: Frame,
  plan: Plan,
  solve: Solve,
  evolve: Evolve,
  govern: Govern,
  scale: Scale,
  "financial-services": FinancialServices,
  government: Government,
  utilities: Utilities,
  manufacturing: Manufacturing,
  "hero-motif": HeroMotif,
  "cta-motif": CtaMotif,
} as const;

interface Props {
  name: keyof typeof icons;
}

const { name } = Astro.props;
const Svg = icons[name];
---
<Svg />
