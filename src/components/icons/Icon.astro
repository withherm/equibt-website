---
/**
 * EQUIBT v6x icon library dispatcher (EQT-251).
 *
 * Single-weight hand-drawn line-art, navy #26245C, one terracotta #C15F3C
 * accent each, 110px uniform (sized by the page wrapper, e.g. .svc-icon / .ic).
 * Stroke classes .hd / .hd-acc / .hd-f1..f3 live in src/styles/base.css.
 *
 * SVG paths are exact lifts from the merged v6x home. Do not redraw here:
 * idiom changes happen as a side-by-side under EQT-251 and swap in only
 * if they clearly beat the originals (Linear comment trail).
 *
 * Usage: <Icon name="frame" />  ·  <Icon name="financial-services" />
 */
import Evolve from "./Evolve.astro";
import FinancialServices from "./FinancialServices.astro";
import Frame from "./Frame.astro";
import Government from "./Government.astro";
import Govern from "./Govern.astro";
import HeroAbout from "./HeroAbout.astro";
import HeroCapabilityStatement from "./HeroCapabilityStatement.astro";
import HeroContact from "./HeroContact.astro";
import HeroEngagementModel from "./HeroEngagementModel.astro";
import HeroHome from "./HeroHome.astro";
import HeroHowWeWork from "./HeroHowWeWork.astro";
import HeroIndustryHub from "./HeroIndustryHub.astro";
import HeroInsights from "./HeroInsights.astro";
import HeroMotif from "./HeroMotif.astro";
import HeroOurWork from "./HeroOurWork.astro";
import HeroServiceHub from "./HeroServiceHub.astro";
import Manufacturing from "./Manufacturing.astro";
import MethodLean from "./MethodLean.astro";
import MethodLeanAgile from "./MethodLeanAgile.astro";
import MethodLeanAgileHero from "./MethodLeanAgileHero.astro";
import MethodLeanBusinessAnalysis from "./MethodLeanBusinessAnalysis.astro";
import MethodLeanBusinessAnalysisHero from "./MethodLeanBusinessAnalysisHero.astro";
import MethodLeanServiceDesign from "./MethodLeanServiceDesign.astro";
import MethodLeanServiceDesignHero from "./MethodLeanServiceDesignHero.astro";
import MethodLeanSixSigma from "./MethodLeanSixSigma.astro";
import MethodLeanSixSigmaHero from "./MethodLeanSixSigmaHero.astro";
import MethodLeanHero from "./MethodLeanHero.astro";
import Plan from "./Plan.astro";
import Scale from "./Scale.astro";
import Solve from "./Solve.astro";
import Utilities from "./Utilities.astro";

const icons = {
  frame: Frame,
  plan: Plan,
  solve: Solve,
  evolve: Evolve,
  govern: Govern,
  scale: Scale,
  "financial-services": FinancialServices,
  government: Government,
  utilities: Utilities,
  manufacturing: Manufacturing,
  "hero-home": HeroHome,
  "hero-service-hub": HeroServiceHub,
  "hero-industry-hub": HeroIndustryHub,
  "hero-our-work": HeroOurWork,
  "hero-insights": HeroInsights,
  "hero-about": HeroAbout,
  "hero-how-we-work": HeroHowWeWork,
  "hero-capability-statement": HeroCapabilityStatement,
  "hero-engagement-model": HeroEngagementModel,
  "hero-contact": HeroContact,
  "hero-motif": HeroMotif,
  "method-lean-business-analysis": MethodLeanBusinessAnalysis,
  "method-lean": MethodLean,
  "method-lean-six-sigma": MethodLeanSixSigma,
  "method-lean-service-design": MethodLeanServiceDesign,
  "method-lean-agile": MethodLeanAgile,
  "method-lean-business-analysis-hero": MethodLeanBusinessAnalysisHero,
  "method-lean-hero": MethodLeanHero,
  "method-lean-six-sigma-hero": MethodLeanSixSigmaHero,
  "method-lean-service-design-hero": MethodLeanServiceDesignHero,
  "method-lean-agile-hero": MethodLeanAgileHero,
} as const;

interface Props {
  name: keyof typeof icons;
}

const { name } = Astro.props;
const Svg = icons[name];
---
<Svg />
