<script>
  // Dropdown + mobile accordion logic
  // Note: hamburger toggle handled by per-page scripts
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  function openItem(item: HTMLElement) {
    const btn = item.querySelector<HTMLButtonElement>('.nav-chevron-btn');
    if (btn) btn.setAttribute('aria-expanded', 'true');
    item.classList.add('is-open');
  }

  function closeItem(item: HTMLElement) {
    const btn = item.querySelector<HTMLButtonElement>('.nav-chevron-btn');
    if (btn) btn.setAttribute('aria-expanded', 'false');
    item.classList.remove('is-open');
  }

  function isMobile() {
    return window.innerWidth <= 760;
  }

  dropdowns.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.nav-chevron-btn');

    // Desktop hover handled by CSS :hover (see base.css). JS handles keyboard only.
    // Desktop: keyboard focus-within open
    item.addEventListener('focusin', () => {
      if (!isMobile()) openItem(item);
    });
    item.addEventListener('focusout', (e: FocusEvent) => {
      if (!isMobile() && !item.contains(e.relatedTarget as Node)) closeItem(item);
    });

    // Mobile: chevron button toggles accordion
    btn?.addEventListener('click', (e) => {
      if (isMobile()) {
        e.preventDefault();
        if (item.classList.contains('is-open')) {
          closeItem(item);
        } else {
          openItem(item);
        }
      }
    });

    // Esc closes
    item.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeItem(item);
        btn?.focus();
      }
    });
  });

  // Close desktop dropdowns on outside click
  document.addEventListener('click', (e) => {
    if (!isMobile()) {
      dropdowns.forEach((item) => {
        if (!item.contains(e.target as Node)) closeItem(item);
      });
    }
  });

  // Close all dropdowns when mobile menu closes
  const navLinks = document.getElementById('nav-links');
  if (navLinks) {
    const observer = new MutationObserver(() => {
      if (!navLinks.classList.contains('is-open')) {
        dropdowns.forEach(closeItem);
      }
    });
    observer.observe(navLinks, { attributes: true, attributeFilter: ['class'] });
  }
</script>
