---
import Footer from "../../components/Footer.astro";
import Icon from "../../components/icons/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import lmiLogo from "../../../brand/assets/logos/lmi/LMI-LOGO-702_MAIN-R1_TRANSPARENT.svg";
import "../../styles/services.css";

const services = [
  { pillar: "frame", kicker: "FRAME · DEFINE", name: "Problem Framing", desc: "Align on the real problem before anything else moves.", href: "/services/frame/" },
  { pillar: "plan", kicker: "PLAN · MEASURE", name: "Operations Diagnostic", desc: "See the full picture before you act.", href: "/services/plan/" },
  { pillar: "solve", kicker: "SOLVE · ANALYSE", name: "Iterative Improvement", desc: "Root cause analysis, solution design, and the capability to keep improving independently.", href: "/services/solve/" },
  { pillar: "evolve", kicker: "EVOLVE · IMPROVE", name: "Rapid Pilot", desc: "Validate the future state before you commit.", href: "/services/evolve/" },
  { pillar: "govern", kicker: "GOVERN · CONTROL", name: "Architecture & Governance", desc: "Build the infrastructure that prevents drift.", href: "/services/govern/" },
  { pillar: "scale", kicker: "SCALE · OPERATE", name: "Operational Embedding", desc: "Scale the proven solution and make it self-sustaining.", href: "/services/scale/" },
];

const svgW = 1040;
const stations = [
  { key: "FRAME", pillar: "frame", x: 70,  y: 100, name: "Problem Framing" },
  { key: "PLAN",  pillar: "plan",  x: 250, y: 97,  name: "Operations Diagnostic" },
  { key: "SOLVE", pillar: "solve", x: 430, y: 99,  name: "Iterative Improvement" },
  { key: "EVOLVE",pillar: "evolve",x: 610, y: 101, name: "Rapid Pilot" },
  { key: "GOVERN",pillar: "govern",x: 790, y: 98,  name: "Architecture & Governance" },
  { key: "SCALE", pillar: "scale", x: 970, y: 98,  name: "Operational Embedding" },
];
---

<Layout
  title="Services | EQUIBT"
  description="EQUIBT's six services span the full improvement cycle: from problem framing through to operational embedding."
>
  <Nav />
  <main>
    <!-- ═══════════════════════════════════════════════════════════════════
         HERO — R1: no CTA button, tighter bottom padding
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="service-hero service-hub-hero service-reveal">
      <div class="service-hero-inner">
        <div>
          <div class="eyebrow">SERVICES</div>
          <h1>Six services. One focus: capability that holds.</h1>
          <p class="service-hero-subhead">EQUIBT works across six connected services. Each can stand alone, but the system is strongest when evidence, capability and control build together. Pick your entry point or tell us the problem and we will tell you where to start.</p>
        </div>
        <div class="service-hero-art" aria-hidden="true">
          <span data-hero-icon><Icon name="hero-service-hub" /></span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         SIX SERVICES
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="service-section beige service-reveal">
      <div class="service-inner">
        <div class="service-hub-list">
          {services.map((svc) => (
            <a href={svc.href} class="service-hub-row">
              <span class="service-hub-icon" aria-hidden="true"><Icon name={svc.pillar} /></span>
              <span class="service-hub-body">
                <span class="service-hub-kicker">{svc.kicker}</span>
                <h3>{svc.name}.</h3>
                <p>{svc.desc}</p>
                <span class="btn-text"><span class="link-label">Explore {svc.pillar.toUpperCase()}</span> <span class="ar">&rsaquo;</span></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         PATHWAY — R2: hover/focus labels; R7: no visible DMAICO
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="service-section white service-reveal">
      <div class="service-inner">
        <div class="service-head">
          <div class="eyebrow">THE PATHWAY</div>
          <h2 class="service-title">Six services, one connected system.</h2>
          <p class="service-head-note">Each service maps to a phase of the improvement cycle. You can enter at any phase and exit when the work is yours. The system is strongest when evidence, capability and control build together.</p>
        </div>
        <div class="pathway-box">
          <svg viewBox="0 0 1040 150" role="img" aria-label="Six-service improvement pathway">
            <path class="pathway-line hd-f2" d="M70 100 Q300 90 520 99 Q760 109 970 98"/>
            {stations.map((station) => {
              const approxHalfW = Math.ceil(station.name.length * 3.5);
              const lx = Math.max(approxHalfW + 4, Math.min(svgW - approxHalfW - 4, station.x));
              const ptrY1 = station.y - 66;
              const ptrY2 = station.y - 22;
              return (
                <a href={`/services/${station.pillar}/`} class="station-link" aria-label={`${station.key}: ${station.name}`}>
                  <circle class="station-ring" cx={station.x} cy={station.y}/>
                  <circle class="station-core" cx={station.x} cy={station.y}/>
                  <text class="station-label" x={station.x} y="138">{station.key}</text>
                  <g class="station-tooltip" aria-hidden="true">
                    <text class="stt-label" x={lx} y={station.y - 76}>{station.name}</text>
                    <path class="stt-ptr" d={`M${station.x} ${ptrY1} L${station.x} ${ptrY2}`}/>
                  </g>
                </a>
              );
            })}
          </svg>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         CLOSING CTA
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="service-section beige cta-light-hub service-reveal">
      <div class="service-inner service-hub-cta-grid">
        <div>
          <div class="eyebrow">WORK WITH US</div>
          <h2 class="service-title">Tell us the problem. We will tell you where to start.</h2>
          <p>We work across all six services, but every engagement starts with the problem that matters most. Tell us where performance is drifting and we will tell you straight whether there is a process fix worth scoping.</p>
          <a href="/contact/" class="btn-primary">Get in touch</a>
        </div>
        <div class="service-hub-cta-art" aria-hidden="true">
          <Icon name="hero-motif" />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════
         LMI CAPABILITY TRAINING — R5: stacked handover band, after CTA
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="service-section white service-hub-lmi service-reveal">
      <div class="service-inner">
        <div class="eyebrow">CAPABILITY TRAINING</div>
        <h2 class="service-title">Build lean, AI-capable teams.</h2>
        <p class="service-hub-lmi-copy">Lean Methods Institute contextualises structured Lean and AI training to your sector, not generic case studies. Your team builds the capability to run the improved process without us, so the work holds after we leave.</p>
        <a href="https://leanmethods.com.au" class="service-hub-lmi-logo-link" aria-label="Lean Methods Institute">
          <img src={lmiLogo.src} class="service-hub-lmi-logo-img" alt="Lean Methods Institute" loading="lazy" />
        </a>
        <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const navToggle = document.querySelector(".nav-toggle");
  const navLinks = document.getElementById("nav-links");
  navToggle?.addEventListener("click", () => {
    const expanded = navToggle.getAttribute("aria-expanded") === "true";
    navToggle.setAttribute("aria-expanded", String(!expanded));
    navLinks?.classList.toggle("is-open");
    document.body.classList.toggle("nav-open");
  });

  function initialiseReveal() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".service-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("service-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.16 });
    sections.forEach((section) => observer.observe(section));
  }

  function syncNavHeight() {
    const nav = document.querySelector(".site-nav");
    if (!nav) return;
    document.documentElement.style.setProperty("--nav-h", nav.offsetHeight + "px");
  }

  syncNavHeight();
  window.addEventListener("resize", syncNavHeight);
  initialiseReveal();
</script>
