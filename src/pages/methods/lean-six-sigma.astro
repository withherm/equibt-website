---
import { getCollection } from "astro:content";
import MethodPage from "../../components/MethodPage.astro";

const methodData = {
  title: "Lean Six Sigma | EQUIBT",
  description: "How EQUIBT applies Lean Six Sigma to settle recurring operational problems with evidence and controls.",
  methodName: "Lean Six Sigma",
  heroIcon: "method-lean-six-sigma",
  cheatSheetTitle: "Settle it with evidence, not opinion.",
  heroOverview: "Lean Six Sigma settles a costly, recurring problem with evidence instead of opinion. The variation is mapped, the root cause is found and proven with data, and controls are built to hold the fix in place. The problem is actually solved, with the proof behind it and controls so it does not drift back.",
  cheatSheet: {
    frameworkTitle: "DMAIC",
    frameworkSubtitle: "(Fix Root Causes)",
    frameworkItems: [
      { key: "D", label: "Define", body: "Frame the problem and what good looks like." },
      { key: "M", label: "Measure", body: "Measure the variation where it actually happens." },
      { key: "A", label: "Analyse", body: "Find the root cause, not the loudest symptom." },
      { key: "I", label: "Improve", body: "Prove the fix with data, not opinion." },
      { key: "C", label: "Control", body: "Lock in controls so it does not drift back." },
    ],
    whatItIs: "Get to the root cause of a costly, recurring problem and prove the fix.",
    whenUseful: "A problem keeps coming back: variation, defects, or a bottleneck nobody can pin down, and the debate has run on opinion for months.",
    whatYouGet: "Evidence, a proven fix, controls so it does not drift back.",
  },
  application: {
    body: "We use it on problems that keep coming back: mapping the variation, getting to the root cause, proving the fix with data rather than opinion, then putting controls in place so it does not drift back.",
    phases: ["FRAME", "SOLVE", "EVOLVE", "GOVERN"],
  },
  work: {
    cases: [
      { slug: "grant-process-rework", icon: "government" },
      { slug: "investigation-cycle-time", icon: "government" },
    ],
  },
  lmiLabel: "Explore training at Lean Methods Institute",
  ctaLine: "Bring us a problem that looks like this.",
  ctaBody: "Tell us where the work is getting stuck. We will tell you straight whether this is the right method, and whether we are the right firm for it.",
};

const caseSlugs = methodData.work.cases.map((item) => item.slug);
const cases = await getCollection("cases", ({ id, data }) => caseSlugs.includes(id) && !data.draft);
const casesBySlug = new Map(cases.map((entry) => [entry.id, entry]));
const workCases = methodData.work.cases.map((item) => {
  const { slug } = item;
  const entry = casesBySlug.get(slug);
  if (!entry) throw new Error(`Missing case study: ${slug}`);
  return {
    slug,
    icon: item.icon,
    sector: entry.data.sector,
    metric: entry.data.metric,
    caption: entry.data.caption,
    title: entry.data.title,
    problem: entry.data.problem,
    fullStudy: entry.data.fullStudy,
  };
});

const pageData = {
  ...methodData,
  work: {
    cases: workCases,
  },
};
---

<MethodPage data={pageData} />
