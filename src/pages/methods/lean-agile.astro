---
import { getCollection } from "astro:content";
import MethodPage from "../../components/MethodPage.astro";

const methodData = {
  title: "Lean Agile | EQUIBT",
  description: "How EQUIBT applies Lean Agile to get approved change delivered and embedded in the operation.",
  methodName: "Lean Agile",
  cheatSheetTitle: "Get the change delivered, not just designed.",
  heroOverview: "Lean Agile keeps an approved change moving from decision to delivered when it would otherwise stall. The direction is set, delivery runs in short cycles, and each increment is validated against the outcome rather than the plan. The change lands in the operation and stays there, instead of staying on the slide.",
  cheatSheet: {
    frameworkTitle: "DRIVE",
    frameworkItems: [
      { key: "D", label: "Define", body: "Set the outcome and the guardrails." },
      { key: "R", label: "Right-size", body: "Size the next increment to deliver value in one cycle." },
      { key: "I", label: "Implement", body: "Roll it into the live operation." },
      { key: "V", label: "Validate", body: "Measure against the outcome, not the plan, then go again." },
      { key: "E", label: "Embed", body: "Lock it into standard work, run the retro, feed it back." },
    ],
    whatItIs: "Get change delivered and kept, not just designed, in short cycles.",
    whenUseful: "An approved initiative has stalled or drifted: delivery is slow, priorities keep shifting, and the change that looked certain on the slide never lands in the operation.",
    whatYouGet: "Change that lands in the operation and stays there.",
  },
  application: {
    body: "We use it to keep an approved change moving when it would otherwise stall: setting the direction, delivering in short cycles, and checking each increment against the outcome rather than the plan, so the change lands and stays.",
    phases: ["EVOLVE", "SCALE"],
  },
  work: {
    cases: [
      { slug: "policy-development-cycle", icon: "government" },
    ],
  },
  lmiLabel: "Explore training at Lean Methods Institute",
  ctaLine: "Bring us a problem that looks like this.",
  ctaBody: "Tell us where the work is getting stuck. We will tell you straight whether this is the right method, and whether we are the right firm for it.",
};

const caseSlugs = methodData.work.cases.map((item) => item.slug);
const cases = await getCollection("cases", ({ id, data }) => caseSlugs.includes(id) && !data.draft);
const casesBySlug = new Map(cases.map((entry) => [entry.id, entry]));
const workCases = methodData.work.cases.map((item) => {
  const { slug } = item;
  const entry = casesBySlug.get(slug);
  if (!entry) throw new Error(`Missing case study: ${slug}`);
  return {
    slug,
    icon: item.icon,
    sector: entry.data.sector,
    metric: entry.data.metric,
    caption: entry.data.caption,
    title: entry.data.title,
    problem: entry.data.problem,
    fullStudy: entry.data.fullStudy,
  };
});

const pageData = {
  ...methodData,
  work: {
    cases: workCases,
  },
};
---

<MethodPage data={pageData} />
