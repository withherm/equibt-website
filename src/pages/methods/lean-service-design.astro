---
import { getCollection } from "astro:content";
import MethodPage from "../../components/MethodPage.astro";

const methodData = {
  title: "Lean Service Design | EQUIBT",
  description: "How EQUIBT applies Lean Service Design to redesign services around the customer and the operation.",
  methodName: "Lean Service Design",
  heroIcon: "method-lean-service-design",
  cheatSheetTitle: "Redesign the service around the customer, end to end.",
  heroOverview: "Lean Service Design redesigns a service end to end so it works for the customer and the operation at once. The journey is mapped from the outside in, set against the service blueprint and value stream from the inside out, and the breaks are found. The result is one designed service rather than a chain of handoffs the customer has to feel.",
  cheatSheet: {
    frameworkTitle: "DMADV",
    frameworkItems: [
      { key: "D", label: "Define", body: "Define the service goals and what the customer counts as quality." },
      { key: "M", label: "Measure", body: "Set the metrics and baseline service, needs and risks." },
      { key: "A", label: "Analyse", body: "Develop and weigh service design options against customer needs." },
      { key: "D", label: "Design", body: "Build and prototype the service, ironing out the weak points." },
      { key: "V", label: "Verify", body: "Prove the redesigned service works in real conditions before launch." },
    ],
    whatItIs: "Redesign a service end to end so it works for the customer and the operation.",
    whenUseful: "Complaints are up, the experience is inconsistent, and a fix in one team breaks another: the journey was never designed, it accreted, and the customer feels the seams.",
    whatYouGet: "One designed service, not a chain of handoffs.",
  },
  application: {
    body: "We use it to redesign a service end to end, mapping the journey from the customer's side and the operation's side together, finding where it breaks, and rebuilding it as one designed service rather than a chain of handoffs.",
    phases: ["FRAME", "SOLVE", "EVOLVE"],
  },
  work: {
    cases: [
      { slug: "complaint-resolution-time", icon: "government" },
      { slug: "quote-process-redesign", icon: "manufacturing" },
      { slug: "retention-save-rate", icon: "utilities" },
      { slug: "self-serve-deflection", icon: "manufacturing" },
    ],
  },
  lmiLabel: "Explore training at Lean Methods Institute",
  ctaLine: "Bring us a problem that looks like this.",
  ctaBody: "Tell us where the work is getting stuck. We will tell you straight whether this is the right method, and whether we are the right firm for it.",
};

const caseSlugs = methodData.work.cases.map((item) => item.slug);
const cases = await getCollection("cases", ({ id, data }) => caseSlugs.includes(id) && !data.draft);
const casesBySlug = new Map(cases.map((entry) => [entry.id, entry]));
const workCases = methodData.work.cases.map((item) => {
  const { slug } = item;
  const entry = casesBySlug.get(slug);
  if (!entry) throw new Error(`Missing case study: ${slug}`);
  return {
    slug,
    icon: item.icon,
    sector: entry.data.sector,
    metric: entry.data.metric,
    caption: entry.data.caption,
    title: entry.data.title,
    problem: entry.data.problem,
    fullStudy: entry.data.fullStudy,
  };
});

const pageData = {
  ...methodData,
  work: {
    cases: workCases,
  },
};
---

<MethodPage data={pageData} />
