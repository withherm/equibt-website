---
import Footer from "../components/Footer.astro";
import Icon from "../components/icons/Icon.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Transfer from "../components/icons/glyphs/Transfer.astro";
import Gauge from "../components/icons/glyphs/Gauge.astro";
import RootCause from "../components/icons/glyphs/RootCause.astro";
import AlignTarget from "../components/icons/glyphs/AlignTarget.astro";
import Evidence from "../components/icons/glyphs/Evidence.astro";
import Roadmap from "../components/icons/glyphs/Roadmap.astro";
import lmiLogo from "../../brand/assets/logos/lmi/LMI-LOGO-702_MAIN-R1_TRANSPARENT.svg";
import "../styles/about.css";

const arc = [
  { Glyph: Gauge, heading: "Set a quantified baseline.", body: "Typical start is two to three weeks from the first conversation. We measure how the operation actually runs before anyone proposes a change, so the work is anchored to evidence, not opinion.", connector: "Then we isolate the cause" },
  { Glyph: RootCause, heading: "Isolate the root cause.", body: "We separate the symptom from the cause, because a good solution to the wrong problem wastes budget and goodwill. Nothing gets designed until the cause is clear.", connector: "Then we design the fix" },
  { Glyph: AlignTarget, heading: "Design the solution with your team.", body: "The people who run the operation help design the new way of working, so it fits the constraints they actually face and they own it from the start.", connector: "Then we prove it" },
  { Glyph: Evidence, heading: "Run a governed pilot.", body: "We prove the redesign on a contained slice with the controls already in place, so the gain is real and measured before it scales.", connector: "Then we hand it back" },
  { Glyph: Transfer, heading: "Hand over for sustainment.", body: "The handover makes sustainment your team's job, not an assumption. We leave when the operating rhythm, measures, governance and handover are strong enough to run without us." },
];

const methods = [
  { name: "Lean", icon: "method-lean-hero", href: "/methods/lean/", body: "Strip waste and make work flow, so the operation costs less to run." },
  { name: "Lean Six Sigma (DMAIC)", icon: "method-lean-six-sigma-hero", href: "/methods/lean-six-sigma/", body: "Find the root cause with evidence and fix efficiency, variation and bottlenecks so the gain holds." },
  { name: "Lean Business Analysis", icon: "method-lean-business-analysis-hero", href: "/methods/lean-business-analysis/", body: "Frame the right problem before work starts, so teams stop solving the wrong one." },
  { name: "Lean Service Design", icon: "method-lean-service-design-hero", href: "/methods/lean-service-design/", body: "Redesign a service end to end, front-stage and back-stage, so customer experience and the operation improve together." },
  { name: "Lean Agile", icon: "method-lean-agile-hero", href: "/methods/lean-agile/", body: "Run initiatives in short, focused cycles so change actually ships." },
];
---

<Layout
  title="How We Work | EQUIBT"
  description="Advisory and capability transfer, not staff augmentation. EQUIBT designs every engagement to end with your team running the improved operation."
>
  <Nav />
  <main>
    <!-- 1. HERO -->
    <section class="about-hero about-reveal">
      <div class="about-hero-inner">
        <div class="about-hero-content">
          <div class="eyebrow">HOW WE WORK</div>
          <h1>Design every engagement to end.</h1>
          <p class="about-hero-subhead">We are advisory and capability transfer, not staff augmentation. Every engagement is scoped to end: we agree the exit criteria up front, move in phases, and do not advance until your team can carry the last. You are left with an operation that holds on its own.</p>
        </div>
        <div class="about-hero-art" aria-hidden="true">
          <span data-hero-icon><Icon name="hero-how-we-work" /></span>
        </div>
      </div>
    </section>

    <!-- 2. THE OPERATING MODEL -->
    <section class="about-section beige about-reveal">
      <div class="about-inner">
        <div class="about-head">
          <div class="eyebrow">THE OPERATING MODEL</div>
          <h2 class="about-title">We build the operation to run without us.</h2>
        </div>
        <div class="about-prose">
          <p>Every engagement carries an exit plan from day one. The exit criteria are written before the work begins, so success is defined in your terms, not ours.</p>
        </div>
        <div class="about-callout">
          <p class="about-callout-lead">You are not buying hours.</p>
          <p>You are buying an operation that holds.</p>
        </div>
        <div class="about-prose">
          <p>We work in phases, and we do not advance a phase until the current one is embedded in how your team actually operates. The work only moves when the operation can carry it.</p>
        </div>
      </div>
    </section>

    <!-- 3. HOW WE OPERATE (we are / we're not) -->
    <section class="about-section white about-reveal">
      <div class="about-inner">
        <div class="about-head">
          <div class="eyebrow">HOW WE OPERATE</div>
          <h2 class="about-title">Direct about what we are, and what we are not.</h2>
          <p>This is the operating line we hold before we accept the work.</p>
        </div>
        <div class="about-compare">
          <div class="about-compare-col is-are">
            <div class="compare-head">WE ARE</div>
            <div class="about-compare-item">Operators who have carried the weight, not observers</div>
            <div class="about-compare-item">Embedded with your team until the change holds</div>
            <div class="about-compare-item">Ruthless about measurement and root cause</div>
            <div class="about-compare-item">Trusted with the problems that have resisted fixing</div>
          </div>
          <div class="about-compare-col is-not">
            <div class="compare-head">WE ARE NOT</div>
            <div class="about-compare-item">Best-practice parrots</div>
            <div class="about-compare-item">Framework-first thinkers</div>
            <div class="about-compare-item">Slide decks and theatre</div>
            <div class="about-compare-item">Staff augmentation by another name</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. THE ARC -->
    <section class="about-section beige about-reveal">
      <div class="about-inner">
        <div class="about-head">
          <div class="eyebrow">THE ARC</div>
          <h2 class="about-title">How an engagement runs.</h2>
          <p>From the first conversation to the handover that makes sustainment your team's job, not an assumption.</p>
        </div>
        <div class="about-arc">
          {arc.map((step) => {
            const Glyph = step.Glyph;
            return (
              <div class="about-arc-step">
                <span class="about-arc-node" aria-hidden="true"><Glyph /></span>
                <div>
                  <h3>{step.heading}</h3>
                  <p>{step.body}</p>
                  {step.connector && <div class="about-arc-connector">{step.connector} &darr;</div>}
                </div>
              </div>
            );
          })}
        </div>
        <div class="about-principle">
          <div class="about-principle-head">
            <div class="eyebrow">WHEN WE STAY, WHEN WE LEAVE</div>
            <h3 class="about-title">One principle holds both ends of the engagement.</h3>
          </div>
          <div class="about-principle-pair">
            <div class="about-principle-end">
              <span class="about-principle-node is-start" aria-hidden="true"></span>
              <div class="about-principle-tag">While it is fragile</div>
              <h3>In the room.</h3>
              <p>We stay close while the new way of working is still unstable, because that is when operational change usually slips.</p>
            </div>
            <div class="about-principle-end">
              <span class="about-principle-node is-end" aria-hidden="true"></span>
              <div class="about-principle-tag">Once it holds</div>
              <h3>Out of the room.</h3>
              <p>Once the operating rhythm carries itself, we step back. A successful engagement means less of us over time, not more.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. THE METHODS WE APPLY -->
    <section class="about-section white about-reveal">
      <div class="about-inner">
        <div class="about-head">
          <div class="eyebrow">THE METHODS WE APPLY</div>
          <h2 class="about-title">The problem decides the method.</h2>
          <p>We are not framework-first, but we use frameworks and tools when they are appropriate and productive. The problem decides the method, not habit. We are not best-practice parrots because these methods are how we run our own operation and what our training division teaches. Lived mastery, not theory. We eat our own dog food.</p>
        </div>
        <div class="about-cols">
          {methods.map((method) => (
            <div class="about-col">
              <span class="about-method-icon" aria-hidden="true"><Icon name={method.icon} /></span>
              <h3><a href={method.href}>{method.name}</a></h3>
              <p>{method.body}</p>
            </div>
          ))}
        </div>
        <div class="about-principle-head about-prose">
          <p>We apply these on your problems; our training division, Lean Methods Institute, teaches them to your people.</p>
          <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span> <span class="ar">&rsaquo;</span></a>
        </div>
      </div>
    </section>

    <!-- 7. CLOSING CTA (light, copy left + motif right) -->
    <section class="about-section beige about-cta about-reveal">
      <div class="about-inner about-cta-grid">
        <div class="about-cta-copy">
          <div class="eyebrow">WORK WITH US</div>
          <h2>See how this fits your operation.</h2>
          <p>Tell us where the operation is under strain: the process that keeps breaking, or the gain that never holds. We will look at it with you and say straight whether it is a fixable problem, and whether we are the right firm to fix it. You will hear back from an operator, not an auto-reply.</p>
          <a href="/contact/" class="btn-primary">Get in touch</a>
        </div>
        <div class="about-cta-art" aria-hidden="true">
          <!-- closing motif: line-art at interim weight — page artwork swaps in here later (artwork-authority, EQT-274/275) -->
          <Roadmap />
        </div>
      </div>
    </section>

    <!-- 6. LMI HANDOVER (story-framed: why we built LMI) -->
    <section class="about-section white about-lmi about-reveal">
      <div class="about-inner">
        <div class="eyebrow">OUR TRAINING DIVISION</div>
        <h2 class="about-title">Build the capability in-house.</h2>
        <p class="about-lmi-copy">Capability transfer is the point of every engagement, so we built a place for teams who want to build it directly. Lean Methods Institute is our specialist training division: the same Lean and AI methods we use in the room, taught through structured courses, so your team can keep improving the operation long after we have stepped out.</p>
        <a href="https://leanmethods.com.au" class="about-lmi-logo-link" aria-label="Lean Methods Institute">
          <img src={lmiLogo.src} class="about-lmi-logo-img" alt="Lean Methods Institute" loading="lazy" />
        </a>
        <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    function initialiseAboutReveals() {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const sections = Array.from(document.querySelectorAll(".about-reveal"));
      if (reduceMotion || !("IntersectionObserver" in window)) return;
      document.documentElement.classList.add("about-reveal-enabled");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16 });
      sections.forEach((section) => observer.observe(section));
    }
    initialiseAboutReveals();
  </script>
</Layout>
