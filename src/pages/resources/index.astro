---
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import { resources } from "../../data/resources";
import lmiLogo from "../../../brand/assets/logos/lmi/LMI-LOGO-702_MAIN-R1_TRANSPARENT.svg";
import "../../styles/resources.css";

// Card glyphs (line-art library, src/components/icons/glyphs). Keyed by Resource.glyph.
import Gauge from "../../components/icons/glyphs/Gauge.astro";
import Loop from "../../components/icons/glyphs/Loop.astro";
import Charter from "../../components/icons/glyphs/Charter.astro";
import Transfer from "../../components/icons/glyphs/Transfer.astro";
import DocChart from "../../components/icons/glyphs/DocChart.astro";
import DocTick from "../../components/icons/glyphs/DocTick.astro";
import DocReport from "../../components/icons/glyphs/DocReport.astro";
import Network from "../../components/icons/glyphs/Network.astro";

const glyphs = {
  Gauge,
  Loop,
  Charter,
  Transfer,
  DocChart,
  DocTick,
  DocReport,
} as Record<string, any>;

// Category mapping for filter chips.
const categoryMap: Record<string, string> = {
  "ASSESSMENT": "tools",
  "GUIDE / FRAMEWORK": "guides",
  "GUIDE": "guides",
  "CALCULATOR": "tools",
  "CHECKLIST / TEMPLATE": "templates",
  "TEMPLATE": "templates",
};

// Hub grid: exclude Capability Statement (moved to About nav).
const hubResources = resources.filter((r) => r.slug !== "capability-statement");

const faqs = [
  {
    q: "Which resource should I start with?",
    a: "Start with the one closest to where you are. Weighing up a transformation programme — use the Readiness Assessment. Know you need to improve but not sure how — use the CI Framework. Considering working with us — read the Engagement Model first.",
  },
  {
    q: "Are these specific to government, or do they apply to any sector?",
    a: "The Readiness Assessment, CI Maturity, CI Framework, ROI Calculator, and Consulting Brief apply to any sector. The Government Programme Checklist is government-specific.",
  },
  {
    q: "Can I share these with my team?",
    a: "Yes. Download and share as needed.",
  },
];
---

<Layout
  title="Resources | EQUIBT"
  description="Assessments, frameworks, templates, and calculators for operational improvement leaders."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="eyebrow">RESOURCES</div>
          <h1>Tools for operational improvement leaders.</h1>
          <p class="res-hero-lede">Assessments, frameworks, templates, and calculators. Each one came out of real improvement work.</p>
        </div>
        <div class="res-hero-art" aria-hidden="true">
          <span><Network /></span>
        </div>
      </div>
      <div class="res-inner">
        <div class="res-filter" role="group" aria-label="Filter by resource type">
          <button class="res-chip is-active" type="button" data-filter="all">All</button>
          <button class="res-chip" type="button" data-filter="guides">Guides</button>
          <button class="res-chip" type="button" data-filter="templates">Templates</button>
          <button class="res-chip" type="button" data-filter="tools">Tools</button>
        </div>
      </div>
    </section>

    <section class="res-list res-reveal">
      <div class="res-inner">
        <div class="res-grid">
          {hubResources.map((r) => {
            const Glyph = glyphs[r.glyph];
            const category = categoryMap[r.tag] ?? "all";
            return (
              <article class="res-card" class:list={[{ "is-soon": r.action === "soon" }]} data-category={category}>
                <div class="res-card-top">
                  <span class="res-card-glyph" aria-hidden="true"><Glyph /></span>
                  <span class="eyebrow res-card-tag">{r.tag}</span>
                </div>
                <h3 class="res-card-title">
                  {r.landing ? (
                    <a href={`/resources/${r.slug}/`}>{r.title}</a>
                  ) : r.action === "view" ? (
                    <a href={r.href}>{r.title}</a>
                  ) : (
                    r.title
                  )}
                </h3>
                <p class="res-card-summary">{r.summary}</p>
                <div class="res-card-foot">
                  {r.action === "soon" ? (
                    <span class="res-soon-badge">Coming soon</span>
                  ) : (
                    <a href={r.action === "view" ? r.href : `/resources/${r.slug}/`} class="btn-text res-card-action">
                      <span class="link-label">{r.actionLabel}</span> <span class="ar">&rsaquo;</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="res-more res-reveal">
      <div class="res-inner">
        <div class="res-more-grid">
          <div class="res-more-copy">
            <div class="eyebrow">NEED SOMETHING MORE SPECIFIC?</div>
            <h2>None of these fit?</h2>
            <p>Tell us the specific problem. We will outline what an engagement looks like.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-more-art" aria-hidden="true">
            <span><Transfer /></span>
          </div>
        </div>
      </div>
    </section>

    <section class="res-faq res-reveal">
      <div class="res-inner">
        <div class="eyebrow">COMMON QUESTIONS</div>
        <div class="res-faq-list">
          {faqs.map((f) => (
            <details class="res-faq-row">
              <summary class="res-faq-q">{f.q}</summary>
              <p class="res-faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="res-lmi res-reveal">
      <div class="res-inner res-lmi-inner">
        <div class="eyebrow">TRAINING</div>
        <h2>Train your team in the methods.</h2>
        <p class="res-lmi-copy">Lean Methods Institute delivers training in your operations context, not generic simulations. The capability stays with your team.</p>
        <a href="https://leanmethods.com.au" class="res-lmi-logo-link" aria-label="Lean Methods Institute">
          <img src={lmiLogo.src} class="res-lmi-logo-img" alt="Lean Methods Institute" loading="lazy" />
        </a>
        <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // One reveal per section (fade + 8px rise, once; reduced-motion disables).
  function initialiseResReveals() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".res-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("res-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14 });
    sections.forEach((section) => observer.observe(section));
  }

  initialiseResReveals();

  // Filter chips
  const chips = Array.from(document.querySelectorAll<HTMLElement>(".res-chip"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".res-card"));

  chips.forEach((chip) => chip.addEventListener("click", () => {
    chips.forEach((c) => c.classList.toggle("is-active", c === chip));
    const filter = (chip as HTMLElement).dataset.filter ?? "all";
    cards.forEach((card) => {
      if (filter === "all" || (card as HTMLElement).dataset.category === filter) {
        card.classList.remove("is-hidden");
      } else {
        card.classList.add("is-hidden");
      }
    });
  }));
</script>
