---
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import { resources } from "../../data/resources";
import "../../styles/resources.css";

// Card glyphs (line-art library, src/components/icons/glyphs). Keyed by Resource.glyph.
import Capability from "../../components/icons/glyphs/Capability.astro";
import Gauge from "../../components/icons/glyphs/Gauge.astro";
import Loop from "../../components/icons/glyphs/Loop.astro";
import Charter from "../../components/icons/glyphs/Charter.astro";
import Transfer from "../../components/icons/glyphs/Transfer.astro";
import DocChart from "../../components/icons/glyphs/DocChart.astro";
import DocTick from "../../components/icons/glyphs/DocTick.astro";
import DocReport from "../../components/icons/glyphs/DocReport.astro";
import Network from "../../components/icons/glyphs/Network.astro";

const glyphs = {
  Capability,
  Gauge,
  Loop,
  Charter,
  Transfer,
  DocChart,
  DocTick,
  DocReport,
} as Record<string, any>;

const faqs = [
  {
    q: "Which resource should I start with?",
    a: "Start with the one that matches where you are. If you are weighing up whether to run an improvement programme, use the Transformation Readiness Assessment. If you know you want to improve but not how, use the CI Programme Design Framework. If you are considering working with us, read the Capability Statement and the Engagement Model. If you are not sure what the problem even is, frame the problem first.",
  },
  {
    q: "Are these specific to government, or do they apply to any sector?",
    a: "Most of them (Readiness Assessment, CI Maturity, CI Framework, ROI Calculator, Consulting Brief) apply to any sector: corporate, government, healthcare, finance. The Government Programme Checklist is specific to government agencies. The case outcomes in the Capability Statement are anonymised and span multiple sectors.",
  },
  {
    q: "Can I share these with my team?",
    a: "Yes. They are tools for doing the work, not marketing collateral. Download them and share them with colleagues as you like.",
  },
];
---

<Layout
  title="Resources | EQUIBT"
  description="Practical tools for operational improvement leaders: assessments, frameworks, templates, and a calculator. Not marketing PDFs."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="eyebrow">RESOURCES</div>
          <h1>Resources for operational improvement leaders.</h1>
          <p class="res-hero-lede">These are not marketing PDFs. They are practical tools for doing the work: assessments that diagnose readiness, frameworks that guide design, templates that force clarity, and a calculator that builds a business case with numbers. Use them to evaluate improvement opportunities and decide where to invest.</p>
          <div class="res-hero-actions">
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
        </div>
        <div class="res-hero-art" aria-hidden="true">
          <span><Network /></span>
        </div>
      </div>
    </section>

    <section class="res-frame res-reveal">
      <div class="res-inner">
        <div class="res-frame-bleed">
          <div class="res-frame-inner">
            <div class="eyebrow">NOT SURE WHERE TO START</div>
            <p class="res-frame-line">Frame the problem first. If you are not sure which resource or service fits, start by defining the operational problem you are actually trying to solve.</p>
            <a href="/resources/frame-your-problem/" class="btn-text"><span class="link-label">Frame your problem</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="res-list res-reveal">
      <div class="res-inner">
        <div class="res-list-head">
          <div class="eyebrow">THE RESOURCES</div>
          <h2>Tools for evaluating, designing, and embedding improvement.</h2>
          <p class="res-list-note">Each one came out of real work inside complex operations. Use the tag to find what fits where you are.</p>
        </div>

        <div class="res-grid">
          {resources.map((r) => {
            const Glyph = glyphs[r.glyph];
            return (
              <article class="res-card" class:list={[{ "is-soon": r.action === "soon" }]}>
                <div class="res-card-top">
                  <span class="res-card-glyph" aria-hidden="true"><Glyph /></span>
                  <span class="eyebrow res-card-tag">{r.tag}</span>
                </div>
                <h3 class="res-card-title">
                  {r.landing ? (
                    <a href={`/resources/${r.slug}/`}>{r.title}</a>
                  ) : r.action === "view" ? (
                    <a href={r.href}>{r.title}</a>
                  ) : (
                    r.title
                  )}
                </h3>
                <p class="res-card-summary">{r.summary}</p>
                <div class="res-card-foot">
                  {r.action === "soon" ? (
                    <span class="res-soon-badge">Coming soon</span>
                  ) : (
                    <a href={r.action === "view" ? r.href : `/resources/${r.slug}/`} class="btn-text res-card-action">
                      <span class="link-label">{r.actionLabel}</span> <span class="ar">&rsaquo;</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="res-more res-reveal">
      <div class="res-inner">
        <div class="res-more-grid">
          <div class="res-more-copy">
            <div class="eyebrow">NEED SOMETHING MORE SPECIFIC?</div>
            <h2>None of these answer your exact question?</h2>
            <p>The next step is a conversation. Tell us the specific problem and we will outline what an engagement would look like.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-more-art" aria-hidden="true">
            <span><Transfer /></span>
          </div>
        </div>
      </div>
    </section>

    <section class="res-faq res-reveal">
      <div class="res-inner">
        <div class="eyebrow">COMMON QUESTIONS</div>
        <div class="res-faq-list">
          {faqs.map((f) => (
            <div class="res-faq-row">
              <h3 class="res-faq-q">{f.q}</h3>
              <p class="res-faq-a">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // One reveal per section (fade + 8px rise, once; reduced-motion disables).
  function initialiseResReveals() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".res-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("res-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14 });
    sections.forEach((section) => observer.observe(section));
  }

  initialiseResReveals();
</script>
