---
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Charter from "../../../components/icons/glyphs/Charter.astro";
import "../../../styles/resources.css";

const components = [
  {
    num: "01",
    title: "Management System",
    tagline: "The operating infrastructure that makes improvement visible and accountable.",
    summary: "A CI programme without a management system relies on individuals to keep it going. The management system replaces that dependency with structure.",
    sections: [
      {
        head: "What it is",
        body: "The operating infrastructure that governs improvement day to day: the routines, forums and artefacts that make performance visible and accountable. The infrastructure, not the method."
      },
      {
        head: "How it is designed",
        body: "From the floor up. Daily team reviews of actuals against target first, then a tiered governance cadence from team to executive, each tier with a set agenda and an escalation trigger. Visual management shows status at the point of work, for the team, not for managers watching the team."
      },
      {
        head: "What goes wrong",
        body: "Governance built without daily management beneath it. Visual boards used to monitor teams rather than help them. Design for compliance, not use. The programme ends up depending on a few people to stay alive."
      },
      {
        head: "How you know it is working",
        body: "Teams run their own daily reviews unprompted, problems get resolved where they appear, and escalations are the exception."
      }
    ]
  },
  {
    num: "02",
    title: "Methodology",
    tagline: "The improvement method: how problems are selected, structured, and solved.",
    summary: "A methodology gives the programme a common language and a consistent way to approach problems. Without it, improvement depends on whoever happens to know a technique.",
    sections: [
      {
        head: "What it is",
        body: "The structured way problems are selected, framed, analysed and solved, and how solutions are tested before rollout. It gives the programme one common language."
      },
      {
        head: "How it is designed",
        body: "Pick one method and use it everywhere: Lean, Lean Six Sigma, PDCA or A3. The value is in consistency, not the choice. Define a problem-solving process that holds at any size, and clear project-selection criteria covering impact, feasibility and strategic fit."
      },
      {
        head: "What goes wrong",
        body: "Several methods running in parallel, unreconciled. Projects chosen by who is available or what is political, not what matters. Jumping from problem straight to solution."
      },
      {
        head: "How you know it is working",
        body: "Teams frame and solve problems the same way, root causes come before solutions, and the live projects are the ones that matter most."
      }
    ]
  },
  {
    num: "03",
    title: "Capability",
    tagline: "The people infrastructure: who can do what, how they were developed, and how that is sustained.",
    summary: "Capability is what makes a CI programme self-sustaining. Without it, the programme depends on external support indefinitely.",
    sections: [
      {
        head: "What it is",
        body: "The people infrastructure that lets the organisation run and evolve its own programme without outside dependence: the roles, skills and development behind it."
      },
      {
        head: "How it is designed",
        body: "Named roles with clear accountability, from executive sponsor to team-level lead. A curriculum matched to each role, training paired with coaching on real work, and a recognised certification path (AUSQ-accredited) that builds career value without locking you to one provider."
      },
      {
        head: "What goes wrong",
        body: "Training people with no work to apply it to. Capability built in a central team but not in the operational teams. Certification treated as the finish line."
      },
      {
        head: "How you know it is working",
        body: "The programme keeps improving when external support steps back, and operational teams, not just a central team, solve their own problems."
      }
    ]
  },
  {
    num: "04",
    title: "Measurement",
    tagline: "The evidence layer: how you know whether improvement is happening and whether it is holding.",
    summary: "Measurement is what makes CI accountable. Without it, activity is mistaken for outcome and programmes drift without anyone noticing.",
    sections: [
      {
        head: "What it is",
        body: "The evidence layer: the metrics, baselines, tracking and reporting that show improvement is real, quantify it, and confirm it holds."
      },
      {
        head: "How it is designed",
        body: "A hierarchy of measures from process to outcome, each with an owner, baseline, target and review rhythm. Baselines set before any change. Benefits signed off independently by Finance and tracked against projection for at least twelve months."
      },
      {
        head: "What goes wrong",
        body: "Counting activity, projects done or people trained, instead of outcome. Point-in-time snapshots instead of trends. Benefits self-reported without independent sign-off."
      },
      {
        head: "How you know it is working",
        body: "You can show, with trend data and an independent sign-off, that performance moved and stayed moved."
      }
    ]
  }
];
---

<Layout
  title="CI Programme Design Framework | EQUIBT Resources"
  description="The four components every CI programme needs to hold after the consultants leave: management system, methodology, capability, and measurement."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>CI Programme Design Framework</span>
          </div>
          <div class="eyebrow">FRAMEWORK</div>
          <h1>Four components. One CI programme that holds.</h1>
          <p class="res-hero-lede">Most CI programmes drift after the consultants leave. These four components are what make them sustain. Open each to see what it is, how it is designed, what goes wrong, and how you know it is working.</p>
          <div class="res-hero-actions">
            <a href="#framework" class="btn-text"><span class="link-label">Explore the framework</span> <span class="ar">&rsaquo;</span></a>
            <a href="/contact/" class="btn-text"><span class="link-label">Get in touch</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="res-hero-art" aria-hidden="true">
          <span><Charter /></span>
        </div>
      </div>
    </section>

    <section class="fw-tool res-reveal" id="framework">
      <div class="res-inner">
        <div class="fw-intro">
          <p class="fw-intro-text">A continuous improvement programme holds or it drifts. The four components below are what determine which way it goes. They are interdependent — a weakness in any one undermines the others.</p>
        </div>

        <div class="fw-components" id="fw-components">
          {components.map((comp) => (
            <div class="fw-component" id={`fw-comp-${comp.num}`}>
              <button class="fw-comp-btn" type="button" aria-expanded="false" aria-controls={`fw-comp-detail-${comp.num}`}>
                <div class="fw-comp-left">
                  <span class="fw-comp-num">{comp.num}</span>
                  <div class="fw-comp-meta">
                    <span class="fw-comp-title">{comp.title}</span>
                    <span class="fw-comp-tagline">{comp.tagline}</span>
                  </div>
                </div>
                <span class="fw-toggle-mark" aria-hidden="true">+</span>
              </button>
              <div class="fw-comp-detail" id={`fw-comp-detail-${comp.num}`} hidden>
                <p class="fw-comp-summary">{comp.summary}</p>
                <div class="fw-sections-grid">
                  {comp.sections.map(s => (
                    <div class={`fw-section-card${s.head === "How you know it is working" ? " fw-section-card--payoff" : ""}`}>
                      <p class="fw-section-head">{s.head}</p>
                      <p class="fw-section-body">{s.body}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="fw-cta-strip">
          <div class="eyebrow">APPLYING THIS</div>
          <p>Designing a CI programme that holds is a different brief to running an improvement project. If you want to work through what these components look like in your organisation, get in touch.</p>
          <a href="/contact/" class="btn-primary">Get in touch</a>
        </div>
      </div>
    </section>

    <section class="res-ld-close res-reveal">
      <div class="res-inner">
        <div class="res-ld-close-grid">
          <div class="res-ld-close-copy">
            <div class="eyebrow">WORK WITH US</div>
            <h2>Rather have us design it with you?</h2>
            <p>We design CI programmes that outlast the engagement. Get in touch if you want to talk through what that looks like in your context.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-ld-close-art" aria-hidden="true">
            <span><Charter /></span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
.fw-tool{padding:76px 56px 92px;background:#F5F3EE;}

.fw-intro{max-width:780px;margin:0 0 52px;}
.fw-intro-text{font-size:20px;color:var(--mid-grey);line-height:1.55;margin:0;max-width:68ch;}

.fw-components{display:flex;flex-direction:column;gap:20px;margin-bottom:52px;}

.fw-comp-btn{
  display:flex;align-items:center;gap:24px;
  width:100%;text-align:left;
  background:#fff;border:1px solid var(--hairline);border-radius:16px;
  padding:26px 30px;cursor:pointer;
  transition:border-color .15s, border-radius .15s;
}
.fw-comp-btn:hover{border-color:var(--terracotta);}
.fw-comp-btn:focus-visible{outline:2px solid var(--terracotta);outline-offset:3px;}
.fw-comp-btn[aria-expanded="true"]{border-color:var(--navy);border-bottom-left-radius:0;border-bottom-right-radius:0;}

.fw-comp-left{display:flex;align-items:flex-start;gap:20px;flex:1;}
.fw-comp-num{
  font-family:"Montserrat",Arial,sans-serif;font-size:13px;font-weight:700;letter-spacing:.08em;
  color:#fff;background:var(--navy);
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.fw-comp-meta{display:flex;flex-direction:column;gap:4px;}
.fw-comp-title{font-family:"Montserrat",Arial,sans-serif;font-size:21px;font-weight:700;color:var(--navy);line-height:1.25;}
.fw-comp-tagline{font-size:16px;color:var(--muted);line-height:1.45;max-width:68ch;}
.fw-toggle-mark{
  font-family:"Montserrat",Arial,sans-serif;font-size:30px;font-weight:600;line-height:1;
  color:var(--terracotta);flex:0 0 28px;text-align:center;
}

.fw-comp-detail{
  background:#fff;border:1px solid var(--navy);border-top:none;
  border-bottom-left-radius:16px;border-bottom-right-radius:16px;
  padding:0 30px 32px;
}
.fw-comp-summary{
  position:relative;
  font-size:19px;color:var(--mid-grey);padding-top:28px;margin:0 0 28px;
  line-height:1.55;max-width:68ch;
}
.fw-comp-summary::before{
  content:"";display:block;width:74px;height:2px;background:var(--terracotta);
  margin:0 0 24px;
}
.fw-sections-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;}
.fw-section-card{
  background:#fff;border:1px solid var(--hairline);border-radius:16px;
  padding:24px 24px 26px;
}
.fw-section-card--payoff{border-top-color:var(--terracotta);border-top-width:3px;}
.fw-section-head{
  font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;
  text-transform:uppercase;color:var(--navy);margin:0 0 12px;
}
.fw-section-body{
  font-family:"Lora",Georgia,serif;font-size:18px;font-weight:500;color:#161616;
  margin:0;line-height:1.58;max-width:64ch;
}

.fw-cta-strip{padding:32px;background:#fff;border:1px solid var(--hairline);border-radius:12px;}
.fw-cta-strip .eyebrow{margin-bottom:10px;}
.fw-cta-strip p{margin:0 0 18px;color:var(--mid-grey);font-size:18px;}

@media(max-width:900px){.fw-sections-grid{grid-template-columns:1fr;}}
@media(max-width:640px){
  .fw-tool{padding:50px 24px 68px;}
  .fw-components{gap:16px;}
  .fw-comp-btn{gap:14px;padding:20px;}
  .fw-comp-left{gap:14px;}
  .fw-comp-num{width:32px;height:32px;font-size:12px;}
  .fw-comp-title{font-size:19px;}
  .fw-toggle-mark{font-size:28px;flex-basis:24px;}
  .fw-comp-detail{padding:0 20px 24px;}
  .fw-comp-summary{font-size:18px;padding-top:24px;margin-bottom:22px;}
  .fw-section-card{padding:20px;}
  .fw-section-body{font-size:17px;line-height:1.6;}
}
</style>

<script>
document.querySelectorAll(".fw-comp-btn").forEach(btn => {
  const mark = btn.querySelector(".fw-toggle-mark");
  btn.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    const detailId = btn.getAttribute("aria-controls");
    const detail = document.getElementById(detailId);
    btn.setAttribute("aria-expanded", !expanded);
    detail.hidden = expanded;
    if (mark) mark.textContent = expanded ? "+" : "-";
    if (!expanded) detail.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
});
</script>
