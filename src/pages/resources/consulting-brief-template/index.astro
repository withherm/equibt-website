---
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import DocReport from "../../../components/icons/glyphs/DocReport.astro";
import "../../../styles/resources.css";
---

<Layout
  title="Consulting Brief Template | EQUIBT Resources"
  description="A guided template for briefing external consultants. Covers problem statement, scope, success criteria, commercial expectations, and evaluation criteria."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>Consulting Brief Template</span>
          </div>
          <div class="eyebrow">TEMPLATE</div>
          <h1>A sharp brief gets you a sharp engagement.</h1>
          <p class="res-hero-lede">Fill in the prompts, preview your brief, then download a clean copy. The discipline of writing a proper brief forces clarity before you issue it. Nothing is sent or stored.</p>
          <div class="res-hero-actions">
            <a href="#brief-tool" class="btn-primary">Start the brief</a>
            <a href="/contact/" class="btn-text"><span class="link-label">Talk it through instead</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="res-hero-art" aria-hidden="true">
          <span><DocReport /></span>
        </div>
      </div>
    </section>

    <section class="cb-tool res-reveal" id="brief-tool">
      <div class="res-inner">
        <div class="cb-layout">
          <!-- Form -->
          <div class="cb-form-col" id="cb-form-col">
            <div class="cb-form-head">
              <div class="eyebrow">BUILD YOUR BRIEF</div>
              <p class="cb-form-intro">Work through each section. The preview on the right updates as you type. Download when done.</p>
            </div>
            <form id="cb-form" novalidate>
              <div class="cb-sections" id="cb-sections"></div>
              <div class="cb-form-actions">
                <button type="button" class="btn-primary" id="cb-download-btn">Download brief</button>
                <button type="button" class="btn-text" id="cb-reset-btn"><span class="link-label">Clear all</span></button>
              </div>
            </form>
          </div>

          <!-- Preview -->
          <div class="cb-preview-col" id="cb-preview-col">
            <div class="cb-preview-head">
              <div class="eyebrow">BRIEF PREVIEW</div>
            </div>
            <div class="cb-preview-doc" id="cb-preview-doc"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="res-ld-close res-reveal">
      <div class="res-inner">
        <div class="res-ld-close-grid">
          <div class="res-ld-close-copy">
            <div class="eyebrow">WORK WITH US</div>
            <h2>Rather have us run it with you?</h2>
            <p>These tools do real work on their own. If you would rather describe the problem to someone, get in touch.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-ld-close-art" aria-hidden="true">
            <span><DocReport /></span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
.cb-tool{padding:72px 56px 88px;background:#F5F3EE;}
.cb-layout{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;}
.cb-form-head{margin-bottom:28px;}
.cb-form-head .eyebrow{margin-bottom:10px;}
.cb-form-intro{color:var(--muted);font-size:17px;margin:0;}

.cb-section{margin-bottom:28px;}
.cb-section-label{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px;}
.cb-section-prompt{font-size:14px;color:var(--caption);margin:0 0 8px;line-height:1.4;}
.cb-input,.cb-textarea{
  width:100%;box-sizing:border-box;
  background:#fff;border:1px solid var(--hairline);border-radius:8px;
  padding:12px 14px;
  font-family:inherit;font-size:16px;color:var(--navy);
  transition:border-color .15s;outline:none;
  resize:vertical;
}
.cb-input:focus,.cb-textarea:focus{border-color:var(--terracotta);}
.cb-textarea{min-height:80px;line-height:1.5;}

.cb-form-actions{display:flex;align-items:center;gap:20px;margin-top:8px;}

/* Preview */
.cb-preview-col{position:sticky;top:24px;}
.cb-preview-head{margin-bottom:16px;}
.cb-preview-head .eyebrow{margin-bottom:0;}
.cb-preview-doc{
  background:#fff;border:1px solid var(--hairline);border-radius:12px;
  padding:32px 36px;min-height:400px;
}
.cb-prev-title{font-size:22px;font-weight:700;color:var(--navy);margin:0 0 4px;}
.cb-prev-org{font-size:15px;color:var(--muted);margin:0 0 24px;}
.cb-prev-divider{height:1px;background:var(--hairline);margin:20px 0;}
.cb-prev-section{margin-bottom:18px;}
.cb-prev-label{font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--muted);margin:0 0 4px;}
.cb-prev-value{font-size:15px;color:var(--mid-grey);margin:0;line-height:1.5;white-space:pre-wrap;}
.cb-prev-empty{color:#c0c0c0;font-style:italic;}

/* Print */
@media print{
  nav,footer,.res-ld-close,.res-hero,.cb-form-col,.cb-preview-head,.cb-form-actions{display:none!important;}
  .cb-tool{padding:0;background:#fff;}
  .res-inner{max-width:100%;}
  .cb-layout{grid-template-columns:1fr;display:block;}
  .cb-preview-col{position:static;}
  .cb-preview-doc{border:none;padding:0;box-shadow:none;}
  body{font-size:13px;}
}
@media(max-width:900px){
  .cb-layout{grid-template-columns:1fr;}
  .cb-preview-col{position:static;}
  .cb-tool{padding:48px 24px 64px;}
}
</style>

<script>
const FIELDS = [
  { key: "org", label: "Organisation", prompt: "Who is issuing this brief?", type: "input", placeholder: "Agency or organisation name" },
  { key: "programme", label: "Programme / project name", prompt: "What is this engagement called?", type: "input", placeholder: "e.g. End-to-end service review, CI programme design" },
  { key: "problem", label: "Problem statement", prompt: "What operational problem are you trying to solve? Be specific: what is happening, where, and why it matters.", type: "textarea", placeholder: "Describe the problem in plain terms. Avoid proposing solutions at this stage." },
  { key: "scope_in", label: "In scope", prompt: "What is explicitly included in this engagement?", type: "textarea", placeholder: "Processes, teams, sites, time periods, or deliverables included." },
  { key: "scope_out", label: "Out of scope", prompt: "What is explicitly excluded?", type: "textarea", placeholder: "Boundaries that the consultant should not cross." },
  { key: "conditions", label: "Operating conditions", prompt: "What constraints, sensitivities, or dependencies must the consultant work within?", type: "textarea", placeholder: "e.g. Staff availability, political sensitivities, existing systems, union obligations, time constraints." },
  { key: "success", label: "Success criteria", prompt: "What does a successful outcome look like? How will you measure it?", type: "textarea", placeholder: "Describe measurable outcomes, not activities or outputs." },
  { key: "deliverables", label: "Expected deliverables", prompt: "What tangible outputs do you expect to receive?", type: "textarea", placeholder: "e.g. Current-state assessment, implementation plan, trained capability, recommendations report." },
  { key: "commercial", label: "Commercial expectations", prompt: "What is your budget range and preferred engagement structure?", type: "textarea", placeholder: "e.g. Fixed-price milestone basis, time-and-materials with cap, preferred engagement length." },
  { key: "evaluation", label: "Evaluation criteria", prompt: "How will you compare and assess responses?", type: "textarea", placeholder: "e.g. Demonstrated methodology, team experience, approach to capability transfer, value for money." },
  { key: "timeline", label: "Timeline", prompt: "When do you need to start, and what is the key deadline or constraint?", type: "input", placeholder: "e.g. Commence July 2026, programme close by December 2026." },
  { key: "contact", label: "Primary contact", prompt: "Who should respondents direct questions to?", type: "input", placeholder: "Name, role, email" }
];

const values = {};
FIELDS.forEach(f => { values[f.key] = ""; });

function renderForm() {
  const container = document.getElementById("cb-sections");
  container.innerHTML = FIELDS.map(f => `
    <div class="cb-section">
      <label class="cb-section-label" for="cb-${f.key}">${f.label}</label>
      <p class="cb-section-prompt">${f.prompt}</p>
      ${f.type === "textarea"
        ? `<textarea class="cb-textarea" id="cb-${f.key}" name="${f.key}" placeholder="${f.placeholder}" rows="3"></textarea>`
        : `<input class="cb-input" type="text" id="cb-${f.key}" name="${f.key}" placeholder="${f.placeholder}" />`
      }
    </div>
  `).join("");

  FIELDS.forEach(f => {
    const el = document.getElementById(`cb-${f.key}`);
    el.addEventListener("input", () => {
      values[f.key] = el.value.trim();
      renderPreview();
    });
  });
}

function renderPreview() {
  const org = values.org || "";
  const programme = values.programme || "";
  const doc = document.getElementById("cb-preview-doc");

  const sections = FIELDS.filter(f => !["org","programme"].includes(f.key));

  doc.innerHTML = `
    <p class="cb-prev-title">${programme || '<span class="cb-prev-empty">Programme name</span>'}</p>
    <p class="cb-prev-org">${org || '<span class="cb-prev-empty">Organisation</span>'}</p>
    <div class="cb-prev-divider"></div>
    ${sections.map(f => `
      <div class="cb-prev-section">
        <p class="cb-prev-label">${f.label.toUpperCase()}</p>
        <p class="cb-prev-value">${values[f.key] ? escHtml(values[f.key]) : `<span class="cb-prev-empty">${f.placeholder}</span>`}</p>
      </div>
    `).join("")}
  `;
}

function escHtml(str) {
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

document.getElementById("cb-download-btn").addEventListener("click", () => window.print());
document.getElementById("cb-reset-btn").addEventListener("click", () => {
  FIELDS.forEach(f => {
    values[f.key] = "";
    const el = document.getElementById(`cb-${f.key}`);
    if (el) el.value = "";
  });
  renderPreview();
});

renderForm();
renderPreview();
</script>
