---
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Loop from "../../../components/icons/glyphs/Loop.astro";
import lmiLogo from "../../../../brand/assets/logos/lmi/LMI-LOGO-702_MAIN-R1_TRANSPARENT.svg";
import "../../../styles/resources.css";
---

<Layout
  title="CI Maturity Assessment | EQUIBT Resources"
  description="20 questions across five dimensions. Diagnose where your CI capability stands and what it takes to move up a tier."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal" id="ra-hero">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>CI Maturity Assessment</span>
          </div>
          <div id="ra-hero-body">
            <h1>Where does your CI capability actually sit?</h1>
            <p class="res-hero-lede">20 questions across five dimensions. Know where you are today and what it takes to move up a tier, not just a score.</p>
            <p class="ra-hero-privacy">Your answers are generated in this browser only. Nothing is stored or sent.</p>
            <div class="res-hero-actions">
              <button type="button" class="btn-primary" id="ra-start-btn">Start the assessment</button>
              <a href="/contact/" class="btn-text"><span class="link-label">Talk it through instead</span> <span class="ar">&rsaquo;</span></a>
            </div>
          </div>
        </div>
        <div class="res-hero-art" id="ra-hero-art" aria-hidden="true">
          <span><Loop /></span>
        </div>
      </div>
    </section>

    <section class="ra-tool res-reveal" id="assessment">
      <div class="res-inner">
        <div id="ra-form-view" style="display:none;">
          <div class="ra-section-head" id="ra-section-head">
            <div class="eyebrow" id="ra-section-label">SECTION 1 OF 5</div>
            <h2 id="ra-section-title">Leadership &amp; Governance</h2>
            <p class="ra-section-note" id="ra-section-note">Does leadership actively own and govern the CI programme?</p>
          </div>
          <nav class="ra-stepper" id="ra-stepper" aria-label="Assessment sections">
            <div class="ra-step is-active" data-step="0"><div class="ra-step-dot">1</div><span class="ra-step-label">Leadership</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="1"><div class="ra-step-dot">2</div><span class="ra-step-label">Process</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="2"><div class="ra-step-dot">3</div><span class="ra-step-label">Methods</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="3"><div class="ra-step-dot">4</div><span class="ra-step-label">Rhythm</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="4"><div class="ra-step-dot">5</div><span class="ra-step-label">Measurement</span></div>
          </nav>
          <form id="ra-form" novalidate>
            <div id="ra-questions"></div>
            <div class="ra-nav">
              <button type="button" class="btn-text" id="ra-prev" style="display:none;"><span class="ar" style="transform:rotate(180deg);">&rsaquo;</span> <span class="link-label">Back</span></button>
              <button type="button" class="btn-primary" id="ra-next">Next section</button>
            </div>
            <p class="ra-required-note" id="ra-required-note" aria-live="polite"></p>
          </form>
        </div>

        <div id="ra-results-view" style="display:none;">
          <div class="ra-results-head" id="ra-results-head">
            <div class="eyebrow">YOUR MATURITY TIER</div>
            <h2 id="ra-tier-title"></h2>
            <p id="ra-tier-description" class="ra-tier-desc"></p>
          </div>
          <div class="ra-dim-grid" id="ra-dim-grid"></div>
          <div class="ra-gap-section" id="ra-gap-section">
            <div class="ra-gap-header">
              <div class="eyebrow">YOUR PRIORITIES</div>
              <h3>Where to focus first</h3>
              <p id="ra-gap-intro"></p>
            </div>
            <div id="ra-gap-cards"></div>
          </div>
          <div class="ra-results-actions">
            <button type="button" class="btn-primary" id="ra-download-btn">Download your results</button>
            <button type="button" class="btn-text" id="ra-restart-btn"><span class="link-label">Start again</span></button>
          </div>
          <div class="ra-cta-strip">
            <div class="eyebrow">NEXT STEP</div>
            <p>If you want to work through what the gap analysis means in practice, get in touch.</p>
            <a href="/contact/" class="btn-text"><span class="link-label">Get in touch</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="res-ld-close res-reveal">
      <div class="res-inner">
        <div class="res-ld-close-grid">
          <div class="res-ld-close-copy">
            <div class="eyebrow">WORK WITH US</div>
            <h2>Rather have us run it with you?</h2>
            <p>These tools do real work on their own. If you would rather describe the problem to someone, get in touch.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-ld-close-art" aria-hidden="true">
            <span><Loop /></span>
          </div>
        </div>
      </div>
    </section>

    <section class="res-lmi res-reveal">
      <div class="res-inner res-lmi-inner">
        <div class="eyebrow">BUILD WITH US</div>
        <h2>Build the capability in-house.</h2>
        <p class="res-lmi-copy">Lean Methods Institute delivers the same Lean and AI methods we use in an engagement, taught to your team in your operations context, not generic simulations. The capability stays with them after we step out.</p>
        <a href="https://leanmethods.com.au" class="res-lmi-logo-link" aria-label="Lean Methods Institute">
          <img src={lmiLogo.src} class="res-lmi-logo-img" alt="Lean Methods Institute" loading="lazy" />
        </a>
        <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span>&nbsp;&nbsp;<span class="ar">&rsaquo;</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
/* ── Assessment tool ── */
.ra-tool{padding:72px 56px 88px;background:#F5F3EE;}
/* Close-section rhythm on assessment pages: white Work-with-us, borderless Build-with-us */
.res-ld-close.res-reveal{background:#fff;}
.res-lmi .res-lmi-inner{border-top:none;border-bottom:none;}

/* Flat button override inside nav row */
.ra-nav button.btn-primary,.ra-results-actions button.btn-primary{border:none!important;-webkit-appearance:none!important;appearance:none!important;box-shadow:none!important;transform:none!important;}
.ra-nav button.btn-primary:hover,.ra-results-actions button.btn-primary:hover{border:none!important;box-shadow:none!important;transform:none!important;background:#2f2d6e;}
.ra-results-actions button.btn-text{border:none;background:transparent;cursor:pointer;padding:0;}

/* ── Stepper ── */
.ra-stepper{display:flex;align-items:flex-start;margin:0 0 20px;}
.ra-step{display:flex;flex-direction:column;align-items:center;gap:4px;flex-shrink:0;min-width:48px;}
.ra-step-dot{width:24px;height:24px;border-radius:50%;border:2px solid #d4d0c8;background:#fff;display:flex;align-items:center;justify-content:center;font-family:"Montserrat",Arial,sans-serif;font-size:9px;font-weight:700;color:#999;transition:all .2s;line-height:1;}
.ra-step.is-active .ra-step-dot{background:#C15F3C;border-color:#C15F3C;color:#fff;}
.ra-step.is-done .ra-step-dot{background:#26245C;border-color:#26245C;color:#fff;}
.ra-step-label{font-family:"Montserrat",Arial,sans-serif;font-size:9px;font-weight:700;letter-spacing:.06em;color:#999;text-transform:uppercase;text-align:center;white-space:nowrap;}
.ra-step.is-active .ra-step-label{color:#C15F3C;}
.ra-step.is-done .ra-step-label{color:#26245C;}
.ra-step-line{flex:1;height:2px;background:#d4d0c8;margin:11px 2px 0;transition:background .2s;min-width:12px;}
.ra-step-line.is-done{background:#26245C;}

/* ── Anonymity notice ── */
.ra-anon{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #d4d0c8;border-radius:8px;padding:10px 16px;margin-bottom:32px;}
.ra-anon svg{flex-shrink:0;}
.ra-anon span{font-size:13px;font-weight:500;color:#666;}

/* ── Section head ── */
.ra-hero-privacy{font-size:13px;color:#999;margin:0 0 28px;}
.res-hero .res-crumb,.res-hero .res-crumb a,.res-hero .res-crumb span{color:#C15F3C;}
.res-hero .res-crumb-sep{color:#C15F3C;}
.res-hero .eyebrow{display:none;}
.ra-section-head{margin-bottom:28px;}
.ra-section-head .eyebrow{margin-bottom:12px;}
.ra-section-head h2{font-size:clamp(26px,2.6vw,34px);font-weight:700;margin:0 0 12px;}
.ra-section-note{color:var(--mid-grey);font-size:19px;margin:0;}

/* ── Column header row ── */
.ra-q-header{display:grid;grid-template-columns:1fr auto;gap:24px;padding:0 28px 12px;border-bottom:1px solid #e0ddd5;margin-bottom:0;}
.ra-q-header-labels{display:grid;grid-template-columns:repeat(5,72px);gap:4px;text-align:center;}
.ra-q-header-labels span{font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.06em;color:#999;text-transform:uppercase;line-height:1.3;}

/* ── Question rows ── */
.ra-q-list{list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:0;}
.ra-q-item{background:#fff;border:1px solid #e0ddd5;border-top:none;padding:18px 28px;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;}
.ra-q-item:first-child{border-top:1px solid #e0ddd5;border-radius:0;}
.ra-q-item:last-child{border-radius:0 0 12px 12px;}
.ra-q-item.has-error{background:#fff9f7;}
.ra-q-text{font-size:18px;font-weight:500;color:#26245C;margin:0;line-height:1.55;}
.ra-q-num{font-family:"Montserrat",Arial,sans-serif;font-size:14px;font-weight:700;color:#C15F3C;margin-right:6px;}

/* ── Likert radio circles ── */
.ra-likert{display:grid;grid-template-columns:repeat(5,72px);gap:4px;}
.ra-likert label{display:flex;justify-content:center;align-items:center;cursor:pointer;}
.ra-likert input[type="radio"]{
  -webkit-appearance:none;appearance:none;
  width:26px;height:26px;
  border:2px solid #a8a29e;border-radius:50%;
  cursor:pointer;position:relative;flex-shrink:0;
  transition:border-color .15s,background .15s;
}
.ra-likert input[type="radio"]:checked{border-color:#26245C;background:#26245C;}
.ra-likert input[type="radio"]:checked::after{
  content:"";position:absolute;
  top:50%;left:50%;transform:translate(-50%,-50%);
  width:9px;height:9px;border-radius:50%;background:#fff;
}
.ra-likert label:hover input[type="radio"]:not(:checked){border-color:#C15F3C;}

/* ── Nav row ── */
.ra-nav{display:flex;align-items:center;gap:24px;margin-top:24px;}
.ra-required-note{color:#C15F3C;font-size:14px;min-height:20px;margin:8px 0 0;}

/* ── Results: overall score ── */
.ra-score-banner{display:flex;align-items:center;gap:28px;background:#fff;border:1px solid #e0ddd5;border-radius:14px;padding:24px 28px;margin-bottom:28px;}
.ra-score-circle{width:80px;height:80px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:"Montserrat",Arial,sans-serif;font-size:22px;font-weight:700;color:#fff;}
.ra-score-tier{font-size:22px;font-weight:700;margin:0 0 4px;color:#26245C;}
.ra-score-desc{font-size:16px;color:var(--caption);line-height:1.55;margin:0;}
.ra-legend{display:flex;flex-wrap:wrap;gap:6px 20px;margin:0 0 24px;padding:10px 16px;background:#fff;border:1px solid #e0ddd5;border-radius:8px;}
.ra-legend-item{display:flex;align-items:center;gap:6px;font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:600;color:var(--mid-grey);letter-spacing:.04em;}
.ra-legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

/* ── Results: dimension grid ── */
.ra-results-head{margin-bottom:28px;}
.ra-results-head .eyebrow{margin-bottom:10px;}
.ra-results-eyebrow{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:16px;}
.ra-dim-grid{display:flex;flex-direction:column;gap:12px;margin-bottom:32px;}
.ra-combined-card{background:#fff;border:1px solid #e0ddd5;border-radius:12px;padding:20px 24px;display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:start;}
.ra-combined-left{padding-right:24px;}
.ra-combined-right{padding-left:24px;border-left:none;}
.ra-dim-card{background:#fff;border:1px solid #e0ddd5;border-radius:12px;padding:22px 24px;}
.ra-dim-name{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--caption);margin:0 0 12px;}
.ra-dim-bar-row{display:flex;align-items:center;gap:12px;margin-bottom:8px;}
.ra-dim-bar-track{flex:1;height:12px;background:#e8e6e2;border-radius:6px;overflow:hidden;}
.ra-dim-bar-fill{height:100%;border-radius:6px;transition:width .6s ease .1s;}
.ra-dim-bar-pct{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;min-width:36px;text-align:right;}
.ra-dim-label-row{display:flex;justify-content:space-between;align-items:baseline;}
.ra-dim-score-text{font-size:14px;color:var(--caption);}
.ra-dim-status{font-size:12px;font-weight:700;font-family:"Montserrat",Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;}

/* ── Gap analysis ── */
.ra-gap-section{margin-bottom:40px;}
.ra-gap-header{margin-bottom:20px;}
.ra-gap-header .eyebrow{margin-bottom:8px;}
.ra-gap-header h3{font-size:22px;font-weight:700;color:#26245C;margin:0 0 8px;}
.ra-gap-header p{font-size:16px;color:var(--mid-grey);margin:0;}
.ra-gap-cards{display:flex;flex-direction:column;gap:16px;}
.ra-gap-card{background:#fff;border:1px solid #e0ddd5;border-radius:12px;padding:20px 24px;}
.ra-gap-card-top{display:flex;align-items:center;gap:10px;margin-bottom:4px;}
.ra-gap-card-name{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#26245C;}
.ra-gap-tag{padding:2px 10px;border-radius:999px;font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;color:#fff;}
.ra-gap-card-pct{margin-left:auto;font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;}
.ra-gap-context{font-size:14px;color:var(--caption);margin:0 0 10px;font-style:italic;}
.ra-gap-action{font-size:16px;color:var(--mid-grey);margin:0;line-height:1.55;}
.ra-gap-action strong{color:#26245C;font-weight:600;}

/* ── CTA strip ── */
.ra-results-actions{display:flex;align-items:center;gap:24px;margin-bottom:40px;}
.ra-cta-strip{padding:32px;background:#fff;border:1px solid #e0ddd5;border-radius:12px;}
.ra-cta-strip .eyebrow{margin-bottom:10px;}
.ra-cta-strip p{margin:0 0 16px;color:var(--mid-grey);font-size:18px;}

.ra-section-icon-inline{display:inline-flex;align-items:center;margin-right:10px;vertical-align:middle;color:#C15F3C;}
.ra-section-icon-inline svg{width:24px;height:24px;}
.ra-combined-right{padding-left:24px;background:#faf9f7;border-radius:0 10px 10px 0;margin:-20px -24px -20px 0;padding:20px 24px;}
/* ── Section divider (two beige sections meet) ── */
.res-ld-close{border-top:1px solid #d4d0c8;}

/* ── Print ── */
@media print{
  nav,footer,.res-ld-close,.res-hero,.ra-nav,.ra-results-actions,.ra-cta-strip,
  .ra-stepper,.ra-section-head,#ra-form-view{display:none!important;}
  .ra-tool{padding:0;background:#fff;}
  .res-inner{max-width:100%;}
  #ra-results-view{display:block!important;}
  .ra-dim-grid{flex-direction:column;}
  .ra-score-banner,.ra-combined-card{border:1px solid #ccc;break-inside:avoid;}
}
@media(max-width:760px){
  .ra-tool{padding:48px 20px 64px;}
  .ra-dim-grid{grid-template-columns:1fr;}
  .ra-q-item{grid-template-columns:1fr;gap:12px;}
  /* ra-q-header shown with abbreviated labels - see below */
  .ra-likert{grid-template-columns:repeat(5,1fr);}
  .ra-step-label{display:none;}
}

/* ── abbreviated labels (desktop full, mobile short) ── */
.lbl-short{display:none;}
/* ── legend ── */
.ra-legend{display:flex;flex-wrap:wrap;gap:12px 28px;margin-bottom:32px;padding:14px 20px;background:#fff;border:1px solid #e0ddd5;border-radius:10px;}
.ra-legend-item{display:flex;align-items:center;gap:8px;font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:600;color:var(--mid-grey);letter-spacing:.04em;}
.ra-legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.ra-legend-range{font-weight:400;color:var(--caption);margin-left:2px;}
/* ── dim card icon header ── */
.ra-dim-card-head{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.ra-dim-icon{display:flex;align-items:center;flex-shrink:0;}
.ra-dim-name-text{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mid-grey);margin:0;}
/* ── suggested action label ── */
.ra-gap-action-label{font-family:"Montserrat",Arial,sans-serif;font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--caption);margin:14px 0 4px;}
/* ── score tier desc on screen ── */
.ra-tier-desc{font-size:18px;color:var(--mid-grey);line-height:1.6;margin:8px 0 0;}
@media(max-width:760px){
  .lbl-full{display:none;}
  .lbl-short{display:inline;}
  .ra-q-header{display:grid !important;}
  .ra-q-header-labels span{font-size:9px;}
}
</style>
<script>
const SECTIONS = [
  {
    key: "leadership",
    label: "SECTION 1 OF 5",
    title: "Leadership & Governance",
    note: "Does leadership actively own and govern the CI programme?",
    questions: [
      "Our senior leaders visibly participate in CI reviews, improvement events, or problem-solving — not just receive reports about them.",
      "We have a named owner or sponsor for the CI programme with genuine accountability for its results.",
      "We review CI performance and outcomes at board or executive level on a regular cycle.",
      "We allocate dedicated resources — time, budget, and people — to CI as a standing commitment."
    ]
  },
  {
    key: "process",
    label: "SECTION 2 OF 5",
    title: "Process Stability",
    note: "Are your processes stable and visible enough to improve?",
    questions: [
      "Our key processes are documented with clear standard operating procedures that people actually use.",
      "We measure performance at the point where work happens, not only report it at the end.",
      "Variation in our outputs is visible and understood by the people doing the work, not just managers.",
      "We identify and address process problems systematically before they escalate to failures or complaints."
    ]
  },
  {
    key: "methods",
    label: "SECTION 3 OF 5",
    title: "Methods & Tools",
    note: "Are structured improvement methods being used consistently?",
    questions: [
      "Our staff use structured problem-solving methods (e.g. A3, PDCA, 8D) rather than jumping to solutions.",
      "We complete root cause analysis before implementing fixes.",
      "We apply improvement tools consistently across teams, not just in pockets where individuals know them.",
      "We have a recognised improvement methodology that applies across programmes and functions."
    ]
  },
  {
    key: "rhythm",
    label: "SECTION 4 OF 5",
    title: "Operating Rhythm",
    note: "Is CI embedded in how the organisation runs day to day?",
    questions: [
      "Our teams meet regularly to review operational performance — daily huddles, weekly reviews, or similar.",
      "We track and follow up improvement actions in a structured way, not just agree and forget them.",
      "We have visual management in place — boards, dashboards, or similar — that makes performance visible to the team.",
      "Improvement work is part of our normal operations, not a separate initiative running alongside BAU."
    ]
  },
  {
    key: "measurement",
    label: "SECTION 5 OF 5",
    title: "Measurement & Review",
    note: "Can you tell whether improvement is actually happening?",
    questions: [
      "We have defined KPIs that are consistently measured across all key processes.",
      "We track performance trends over time, not just report them as a point-in-time snapshot.",
      "We quantify improvement outcomes in financial or operational terms and report them to leadership.",
      "We capture lessons learned from improvement projects and share them across teams."
    ]
  }
];

const LABELS = ["Strongly disagree","Disagree","Neutral","Agree","Strongly agree"];
const LABELS_SHORT = ["SD","D","N","A","SA"];
const DIM_NAMES = {
  leadership:"Leadership & Governance",process:"Process Stability",
  methods:"Methods & Tools",rhythm:"Operating Rhythm",measurement:"Measurement & Review"
};
const DIM_CONTEXT = {
  leadership:"Whether CI is actively owned at senior level: not just reported to it.",
  process:"Whether your processes are stable, visible, and measured at the point of work.",
  methods:"Whether structured problem-solving is the norm, not the exception.",
  rhythm:"Whether CI is embedded in daily operations: reviews, boards, and follow-through.",
  measurement:"Whether improvement is quantified and linked to business outcomes."
};
const DIM_ICONS={
  leadership:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="6" r="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 16.5c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  process:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2.5 5.5h13M2.5 9h9M2.5 12.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  methods:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="14" height="3" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="7.5" width="10" height="3" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="12" width="7" height="3" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>',
  rhythm:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M9 5v4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  measurement:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="12.5" width="3" height="4" rx=".5" stroke="currentColor" stroke-width="1.5"/><rect x="7.5" y="8.5" width="3" height="8" rx=".5" stroke="currentColor" stroke-width="1.5"/><rect x="13" y="4.5" width="3" height="12" rx=".5" stroke="currentColor" stroke-width="1.5"/></svg>',
};
const TIERS = [
  {min:0,max:39,title:"Needs attention",color:"#C62828",description:"CI activity is ad hoc and reactive. Improvement depends on individual effort rather than system. The priority is building foundations: stable processes, a visible sponsor, and a basic measurement rhythm."},
  {min:40,max:64,title:"Developing",color:"#D9730B",description:"Some structure is in place, but it is inconsistent across the organisation. Pockets of good practice exist but have not spread. Focus on standardising what is working and building leadership governance."},
  {min:65,max:74,title:"Established",color:"#B07A00",description:"A structured approach is developing and spreading. Most dimensions are moving in the right direction. The focus now is on embedding operating rhythm so that CI does not depend on external prompting."},
  {min:75,max:100,title:"Strong",color:"#2E7D32",description:"CI is embedded and largely self-reinforcing. Performance is tracked and reviewed at the right levels. The shift is from maintaining the system to improving the improvement system itself."}
];
const GAP_SHIFTS = {
  leadership:{
    low:"Secure a named executive sponsor with genuine accountability for CI outcomes: not just a champion who receives reports.",
    mid:"Move CI from being reported to leadership to being actively owned by it. The test: do senior leaders participate in CI events, or just review the slides?",
    high:"Deepen leadership participation from governance to visible involvement in improvement events."
  },
  process:{
    low:"Document and stabilise key processes before attempting to improve them. You cannot improve what you cannot see.",
    mid:"Build measurement at the point of work, not just end-of-process reporting. Variation managed upstream costs a fraction of variation caught downstream.",
    high:"Move variation management from reactive to proactive: make it visible to the people doing the work, not just managers."
  },
  methods:{
    low:"Introduce a consistent problem-solving method and make its use the organisational standard, not the exception. Start with one method applied rigorously.",
    mid:"Extend structured methods beyond the trained few. When only certain people use the tools, results are personality-dependent rather than system-dependent.",
    high:"Integrate methodology into how improvement is commissioned and reviewed: not just how it is executed."
  },
  rhythm:{
    low:"Establish regular performance review routines: at minimum weekly: with the teams doing the work. Cadence matters more than the format.",
    mid:"Make improvement actions visible and actively tracked. A managed backlog beats a list reviewed quarterly. The question is not what was agreed but what changed.",
    high:"Move from improvement as initiative to improvement as operating model."
  },
  measurement:{
    low:"Define baseline metrics for key processes before any improvement activity starts. Without a baseline, you cannot demonstrate value or course-correct.",
    mid:"Shift from snapshot reporting to trend tracking. A number reported once tells you where you are. A trend tells you whether you are improving.",
    high:"Quantify improvement outcomes in financial terms and close the loop to benefit realisation: not just task completion."
  }
};

const SCORE_MAX = 20; // 4 questions × 5 max
let currentSection = 0;
const answers = {};

function pct(score,max){return Math.round((score/max)*100);}
function band(p){
  if(p<40)return{label:"Needs attention",range:"below 40%",bar:"#E23B33",text:"#C62828"};
  if(p<65)return{label:"Developing",range:"40–64%",bar:"#F2912E",text:"#D9730B"};
  if(p<75)return{label:"Established",range:"65–74%",bar:"#F4C20D",text:"#B07A00"};
  return{label:"Strong",range:"75%+",bar:"#46A546",text:"#2E7D32"};
}
function barColor(p){return band(p).bar;}
function statusLabel(p){return{label:band(p).label};}
function getGlobalQ(si,qi){
  let n=1;
  for(let i=0;i<si;i++) n+=SECTIONS[i].questions.length;
  return n+qi;
}

function updateStepper(idx){
  document.querySelectorAll(".ra-step").forEach((el,i)=>{
    el.classList.remove("is-active","is-done");
    if(i===idx) el.classList.add("is-active");
    else if(i<idx) el.classList.add("is-done");
  });
  document.querySelectorAll(".ra-step-line").forEach((el,i)=>{
    el.classList.toggle("is-done",i<idx);
  });
}

function renderSection(idx){
  const s=SECTIONS[idx];
  document.getElementById("ra-section-label").textContent=s.label;
  document.getElementById("ra-section-title").innerHTML=`<span class="ra-section-icon-inline">${DIM_ICONS[s.key]||''}</span>${s.title}`;
  document.getElementById("ra-section-note").textContent=s.note;
  const saved=answers[s.key]||{};

  // Show anonymity notice only on section 0
  const anon=document.getElementById("ra-anon-notice");
  if(anon) anon.style.display=idx===0?"flex":"none";

  updateStepper(idx);

  const colHeaders=`<div class="ra-q-header"><div></div><div class="ra-q-header-labels">${LABELS.map((l,i)=>`<span><span class="lbl-full">${l}</span><span class="lbl-short">${LABELS_SHORT[i]}</span></span>`).join("")}</div></div>`;
  document.getElementById("ra-questions").innerHTML=colHeaders+`<ul class="ra-q-list">${
    s.questions.map((q,qi)=>`<li class="ra-q-item" id="ra-q-${qi}">
      <p class="ra-q-text"><span class="ra-q-num">${getGlobalQ(idx,qi)}.</span> ${q}</p>
      <div class="ra-likert">${LABELS.map((lbl,val)=>`<label><input type="radio" name="q${qi}" value="${val+1}" ${saved[qi]===val+1?"checked":""} aria-label="${lbl}"></label>`).join("")}</div>
    </li>`).join("")
  }</ul>`;

  document.getElementById("ra-prev").style.display=idx>0?"inline-flex":"none";
  document.getElementById("ra-next").textContent=idx===SECTIONS.length-1?"See my results":"Next section";
  document.getElementById("ra-required-note").textContent="";
}

function collectSection(idx){
  const s=SECTIONS[idx];
  const res={};let allAnswered=true;
  s.questions.forEach((_,qi)=>{
    const c=document.querySelector(`input[name="q${qi}"]:checked`);
    if(c) res[qi]=parseInt(c.value);
    else allAnswered=false;
  });
  return{res,allAnswered};
}

