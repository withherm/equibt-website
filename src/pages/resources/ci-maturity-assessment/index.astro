function showResults(){
  document.getElementById("ra-form-view").style.display="none";
  const rv=document.getElementById("ra-results-view");
  rv.style.display="block";

  const dimScores={};
  SECTIONS.forEach(s=>{dimScores[s.key]=Object.values(answers[s.key]||{}).reduce((a,v)=>a+v,0);});
  const totalScore=Object.values(dimScores).reduce((a,v)=>a+v,0);
  const totalMax=SECTIONS.reduce((a,s)=>a+s.questions.length*5,0);
  const totalPct=pct(totalScore,totalMax);
  const tier=TIERS.find(t=>totalPct>=t.min&&totalPct<=t.max)||TIERS[TIERS.length-1];
  const b=band(totalPct);
  const rh=document.getElementById("ra-results-head");
  if(rh) rh.style.display="none";
  heroResults(totalPct,b,tier.description);
  document.getElementById("ra-hero").scrollIntoView({behavior:"smooth",block:"start"});

  // Dimension grid
  const dimGrid=document.getElementById("ra-dim-grid");
  document.getElementById("ra-gap-section").style.display="none";
  dimGrid.innerHTML=SECTIONS.map(s=>{
    const score=dimScores[s.key];const p=pct(score,SCORE_MAX);
    const b=band(p);
    const level=p<40?"low":p<65?"mid":"high";
    return`<div class="ra-combined-card">
      <div class="ra-combined-left">
        <div class="ra-dim-card-head"><span class="ra-dim-icon" style="color:${b.text};">${DIM_ICONS[s.key]||''}</span><p class="ra-dim-name-text">${DIM_NAMES[s.key]}</p><span class="ra-gap-tag" style="background:${b.text};margin-left:auto;">${b.label}</span><span style="font-family:'Montserrat',Arial,sans-serif;font-size:12px;font-weight:700;color:${b.text};margin-left:8px;">${p}%</span></div>
        <div class="ra-dim-bar-row"><div class="ra-dim-bar-track"><div class="ra-dim-bar-fill" style="width:${p}%;background:${b.bar};"></div></div></div>
        <div class="ra-dim-label-row"><span class="ra-dim-score-text">${score} / ${SCORE_MAX}</span></div>
        <p style="font-size:14px;color:#5A5A5A;margin:4px 0 0;font-style:italic;">${DIM_CONTEXT[s.key]}</p>
      </div>
      <div class="ra-combined-right">
        <p class="ra-gap-action-label">Suggested action</p>
        <p class="ra-gap-action">${GAP_SHIFTS[s.key][level]}</p>
      </div>
    </div>`;
  }).join("");

  // Gap analysis
  const sorted=SECTIONS.map(s=>({key:s.key,p:pct(dimScores[s.key],SCORE_MAX)})).sort((a,b)=>a.p-b.p);
  const gaps=sorted;
  const gapIntro=totalPct<60
    ?"These three dimensions are your lowest-scoring areas and need foundational work before other dimensions can build on them."
    :"These are the dimensions with the most room to improve. Addressing them will have the greatest impact on moving up a tier.";

  // Legend
  document.querySelectorAll(".ra-legend").forEach(el=>el.remove());
  const lgd=document.createElement('div');lgd.className='ra-legend';
  lgd.innerHTML='<span class="ra-legend-item"><span class="ra-legend-dot" style="background:#E23B33;"></span>Needs attention<span class="ra-legend-range">(below 40%)</span></span><span class="ra-legend-item"><span class="ra-legend-dot" style="background:#F2912E;"></span>Developing<span class="ra-legend-range">(40–64%)</span></span><span class="ra-legend-item"><span class="ra-legend-dot" style="background:#F4C20D;"></span>Established<span class="ra-legend-range">(65–74%)</span></span><span class="ra-legend-item"><span class="ra-legend-dot" style="background:#46A546;"></span>Strong<span class="ra-legend-range">(75%+)</span></span>';
  dimGrid.after(lgd);
  document.getElementById("ra-gap-intro").textContent=gapIntro;
  document.getElementById("ra-gap-cards").innerHTML=gaps.map(g=>{
    const p=g.p;const b=band(p);
    const level=p<40?"low":p<65?"mid":"high";
    return`<div class="ra-gap-card" style="border-top-color:${b.bar};">
      <div class="ra-gap-card-top">
        <span class="ra-gap-card-name">${DIM_NAMES[g.key]}</span>
        <span class="ra-gap-tag" style="background:${b.text};">${b.label}</span>
        <span class="ra-gap-card-pct" style="color:${b.text};">${p}%</span>
      </div>
      <p class="ra-gap-context">${DIM_CONTEXT[g.key]}</p>
      <p class="ra-gap-action-label">Suggested action</p><p class="ra-gap-action">${GAP_SHIFTS[g.key][level]}</p>
    </div>`;
  }).join("");
}

document.getElementById("ra-next").addEventListener("click",()=>{
  const{res,allAnswered}=collectSection(currentSection);
  if(!allAnswered){document.getElementById("ra-required-note").textContent="Please answer all questions before continuing.";return;}
  answers[SECTIONS[currentSection].key]=res;
  if(currentSection===SECTIONS.length-1){showResults();}
  else{currentSection++;renderSection(currentSection);document.getElementById("ra-form-view").scrollIntoView({behavior:"smooth",block:"start"});}
});
document.getElementById("ra-prev").addEventListener("click",()=>{
  const{res}=collectSection(currentSection);
  answers[SECTIONS[currentSection].key]=res;
  currentSection--;
  renderSection(currentSection);
  document.getElementById("ra-form-view").scrollIntoView({behavior:"smooth",block:"start"});
});
document.getElementById("ra-download-btn").addEventListener("click",()=>{
  const dimScores={};
  SECTIONS.forEach(s=>{dimScores[s.key]=Object.values(answers[s.key]||{}).reduce((a,v)=>a+v,0);});
  const totalScore=Object.values(dimScores).reduce((a,v)=>a+v,0);
  const totalMax=SECTIONS.reduce((a,s)=>a+s.questions.length*5,0);
  const totalPct=pct(totalScore,totalMax);
  const tier=TIERS.find(t=>totalPct>=t.min&&totalPct<=t.max)||TIERS[TIERS.length-1];
  const w=window.open("","_blank");
  w.document.write(buildPrintHTML(dimScores,tier,totalPct));
  w.document.close();
});
document.getElementById("ra-restart-btn").addEventListener("click",()=>{
  Object.keys(answers).forEach(k=>delete answers[k]);
  currentSection=0;
  document.getElementById("ra-results-view").style.display="none";
  document.getElementById("ra-form-view").style.display="none";
  heroIntro();
  document.getElementById("ra-hero").scrollIntoView({behavior:"smooth",block:"start"});
});

// ── Hero state control ──
const TOOL_NAME="CI Maturity Assessment";
const heroEl=document.getElementById("ra-hero");
const heroBody=document.getElementById("ra-hero-body");
const heroArt=document.getElementById("ra-hero-art");
const introBody=heroBody.innerHTML;
const introArt=heroArt.innerHTML;
function resultHeadline(label){const s="CI maturity";return label==="Needs attention"?`Your ${s} needs attention`:`Your ${s} is ${label.toLowerCase()}`;}
function bindStart(){const sb=document.getElementById("ra-start-btn");if(sb)sb.addEventListener("click",startAssessment);}
function startAssessment(){
  document.getElementById("ra-results-view").style.display="none";
  document.getElementById("ra-form-view").style.display="block";
  currentSection=0;renderSection(0);
  heroEl.classList.remove("has-score");heroEl.classList.add("is-compact");
  heroBody.innerHTML=`<h1>${TOOL_NAME}</h1>`;heroArt.innerHTML="";
  heroEl.scrollIntoView({behavior:"smooth",block:"start"});
}
function heroResults(p,b,desc){
  heroEl.classList.add("is-compact","has-score");
  heroBody.innerHTML=`<h1>${resultHeadline(b.label)}</h1><p class="res-hero-lede ra-hero-result-desc">${desc}</p>`;
  heroArt.innerHTML=`<div class="ra-hero-score" style="background:${b.text};">${p}%</div>`;
}
function heroIntro(){
  heroEl.classList.remove("is-compact","has-score");
  heroBody.innerHTML=introBody;heroArt.innerHTML=introArt;
  bindStart();
}
bindStart();
renderSection(0);
</script>
