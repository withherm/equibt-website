  const responses=SECTIONS.map(s=>{
    const saved=answers[s.key]||{};
    const rows=s.questions.map((q,qi)=>{
      const v=saved[qi];const ans=v?LABELS[v-1]:"Not answered";
      return`<div style="display:grid;grid-template-columns:1fr auto;gap:16px;padding:7px 0;border-bottom:1px solid #eee;align-items:start;"><div style="font-size:12px;color:#0d0d0d;line-height:1.5;">${q}</div><div style="font-family:Arial,sans-serif;font-size:11px;font-weight:700;color:${v?'#26245C':'#bbb'};white-space:nowrap;">${ans}</div></div>`;
