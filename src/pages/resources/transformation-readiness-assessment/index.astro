---
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Gauge from "../../../components/icons/glyphs/Gauge.astro";
import "../../../styles/resources.css";
---

<Layout
  title="Transformation Readiness Assessment | EQUIBT Resources"
  description="19 questions across four readiness dimensions. Use it before committing budget to a transformation programme."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>Transformation Readiness Assessment</span>
          </div>
          <div class="eyebrow">ASSESSMENT</div>
          <h1>Are you ready to transform?</h1>
          <p class="res-hero-lede">Most transformation programmes fail on readiness, not ambition. 19 questions across four dimensions. Your results are generated here: nothing is sent or stored.</p>
          <div class="res-hero-actions">
            <a href="#assessment" class="btn-primary">Start the assessment</a>
            <a href="/contact/" class="btn-text"><span class="link-label">Talk it through instead</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="res-hero-art" aria-hidden="true">
          <span><Gauge /></span>
        </div>
      </div>
    </section>

    <section class="ra-tool res-reveal" id="assessment">
      <div class="res-inner">
        <div id="ra-form-view">
          <nav class="ra-stepper" id="ra-stepper" aria-label="Assessment sections">
            <div class="ra-step is-active" data-step="0"><div class="ra-step-dot">1</div><span class="ra-step-label">Leadership</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="1"><div class="ra-step-dot">2</div><span class="ra-step-label">Operational</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="2"><div class="ra-step-dot">3</div><span class="ra-step-label">Change</span></div>
            <div class="ra-step-line"></div>
            <div class="ra-step" data-step="3"><div class="ra-step-dot">4</div><span class="ra-step-label">Measurement</span></div>
          </nav>
          <div class="ra-section-head" id="ra-section-head">
            <div class="eyebrow" id="ra-section-label">SECTION 1 OF 4</div>
            <h2 id="ra-section-title">Leadership Readiness</h2>
            <p class="ra-section-note" id="ra-section-note">How committed and aligned is leadership to driving the transformation?</p>
          </div>
          <div class="ra-anon" id="ra-anon-notice">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="7" width="12" height="8" rx="2" stroke="#26245C" stroke-width="1.5"/><path d="M5 7V5a3 3 0 0 1 6 0v2" stroke="#26245C" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Anonymous: your answers are not stored or sent. Results appear only in this browser window.</span>
          </div>
          <form id="ra-form" novalidate>
            <div id="ra-questions"></div>
            <div class="ra-nav">
              <button type="button" class="btn-text" id="ra-prev" style="display:none;"><span class="ar" style="transform:rotate(180deg);">&rsaquo;</span> <span class="link-label">Back</span></button>
              <button type="button" class="btn-primary" id="ra-next">Next section</button>
            </div>
            <p class="ra-required-note" id="ra-required-note" aria-live="polite"></p>
          </form>
        </div>

        <div id="ra-results-view" style="display:none;">
          <div class="ra-results-head" id="ra-results-head">
            <div class="eyebrow">YOUR RESULTS</div>
            <h2 id="ra-tier-title"></h2>
            <p id="ra-tier-description" class="ra-tier-desc"></p>
          </div>
          <div class="ra-dim-grid" id="ra-dim-grid"></div>
          <div class="ra-gap-section" id="ra-gap-section"></div>
          <div class="ra-results-actions">
            <button type="button" class="btn-primary" id="ra-download-btn">Download your results</button>
            <button type="button" class="btn-text" id="ra-restart-btn"><span class="link-label">Start again</span></button>
          </div>
          <div class="ra-cta-strip">
            <div class="eyebrow">NEXT STEP</div>
            <p>These results point to where preparation is needed before committing to a programme. If you would like to work through them with us, get in touch.</p>
            <a href="/contact/" class="btn-text"><span class="link-label">Get in touch</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="res-ld-close res-reveal">
      <div class="res-inner">
        <div class="res-ld-close-grid">
          <div class="res-ld-close-copy">
            <div class="eyebrow">WORK WITH US</div>
            <h2>Rather have us run it with you?</h2>
            <p>These tools do real work on their own. If you would rather describe the problem to someone, get in touch.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-ld-close-art" aria-hidden="true">
            <span><Gauge /></span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
/* ── Assessment tool ── */
.ra-tool{padding:72px 56px 88px;background:#F5F3EE;}

/* Flat button override inside nav row */
.ra-nav button.btn-primary{border:none!important;-webkit-appearance:none!important;appearance:none!important;box-shadow:none!important;transform:none!important;}
.ra-nav button.btn-primary:hover{border:none!important;box-shadow:none!important;transform:none!important;background:#2f2d6e;}

/* ── Stepper ── */
.ra-stepper{display:flex;align-items:flex-start;margin-bottom:44px;}
.ra-step{display:flex;flex-direction:column;align-items:center;gap:6px;flex-shrink:0;min-width:64px;}
.ra-step-dot{width:32px;height:32px;border-radius:50%;border:2px solid #d4d0c8;background:#fff;display:flex;align-items:center;justify-content:center;font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;color:#999;transition:all .2s;line-height:1;}
.ra-step.is-active .ra-step-dot{background:#C15F3C;border-color:#C15F3C;color:#fff;}
.ra-step.is-done .ra-step-dot{background:#26245C;border-color:#26245C;color:#fff;}
.ra-step-label{font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.06em;color:#999;text-transform:uppercase;text-align:center;white-space:nowrap;}
.ra-step.is-active .ra-step-label{color:#C15F3C;}
.ra-step.is-done .ra-step-label{color:#26245C;}
.ra-step-line{flex:1;height:2px;background:#d4d0c8;margin:15px 4px 0;transition:background .2s;min-width:16px;}
.ra-step-line.is-done{background:#26245C;}

/* ── Anonymity notice ── */
.ra-anon{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #d4d0c8;border-radius:8px;padding:10px 16px;margin-bottom:32px;}
.ra-anon svg{flex-shrink:0;}
.ra-anon span{font-size:13px;font-weight:500;color:#666;}

/* ── Section head ── */
.ra-section-head{margin-bottom:36px;}
.ra-section-head .eyebrow{margin-bottom:12px;}
.ra-section-head h2{font-size:clamp(26px,2.6vw,34px);font-weight:700;margin:0 0 12px;}
.ra-section-note{color:#666;font-size:18px;margin:0;}

/* ── Column header row ── */
.ra-q-header{display:grid;grid-template-columns:1fr auto;gap:24px;padding:0 28px 12px;border-bottom:1px solid #e0ddd5;margin-bottom:0;}
.ra-q-header-labels{display:grid;grid-template-columns:repeat(5,72px);gap:4px;text-align:center;}
.ra-q-header-labels span{font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.06em;color:#999;text-transform:uppercase;line-height:1.3;}

/* ── Question rows ── */
.ra-q-list{list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:0;}
.ra-q-item{background:#fff;border:1px solid #e0ddd5;border-top:none;padding:18px 28px;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;}
.ra-q-item:first-child{border-top:1px solid #e0ddd5;border-radius:0;}
.ra-q-item:last-child{border-radius:0 0 12px 12px;}
.ra-q-item.has-error{background:#fff9f7;}
.ra-q-text{font-size:18px;font-weight:500;color:#26245C;margin:0;line-height:1.55;}
.ra-q-num{font-family:"Montserrat",Arial,sans-serif;font-size:14px;font-weight:700;color:#C15F3C;margin-right:6px;}

/* ── Likert radio circles ── */
.ra-likert{display:grid;grid-template-columns:repeat(5,72px);gap:4px;}
.ra-likert label{display:flex;justify-content:center;align-items:center;cursor:pointer;}
.ra-likert input[type="radio"]{
  -webkit-appearance:none;appearance:none;
  width:26px;height:26px;
  border:2px solid #a8a29e;border-radius:50%;
  cursor:pointer;position:relative;flex-shrink:0;
  transition:border-color .15s,background .15s;
}
.ra-likert input[type="radio"]:checked{border-color:#26245C;background:#26245C;}
.ra-likert input[type="radio"]:checked::after{
  content:"";position:absolute;
  top:50%;left:50%;transform:translate(-50%,-50%);
  width:9px;height:9px;border-radius:50%;background:#fff;
}
.ra-likert label:hover input[type="radio"]:not(:checked){border-color:#C15F3C;}

/* ── Nav row ── */
.ra-nav{display:flex;align-items:center;gap:24px;margin-top:24px;}
.ra-required-note{color:#C15F3C;font-size:14px;min-height:20px;margin:8px 0 0;}

/* ── Results: overall score ── */
.ra-score-banner{display:flex;align-items:center;gap:32px;background:#fff;border:1px solid #e0ddd5;border-radius:14px;padding:28px 32px;margin-bottom:32px;}
.ra-score-circle{width:88px;height:88px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:"Montserrat",Arial,sans-serif;font-size:24px;font-weight:700;color:#fff;}
.ra-score-tier{font-size:26px;font-weight:700;margin:0 0 6px;color:#26245C;}
.ra-score-desc{font-size:15px;color:#666;line-height:1.55;margin:0;}

/* ── Results: dimension grid ── */
.ra-results-head{margin-bottom:28px;}
.ra-results-head .eyebrow{margin-bottom:10px;}
.ra-results-eyebrow{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:16px;}
.ra-dim-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:40px;}
.ra-dim-card{background:#fff;border:1px solid #e0ddd5;border-radius:12px;padding:22px 24px;}
.ra-dim-name{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin:0 0 12px;}
.ra-dim-bar-row{display:flex;align-items:center;gap:12px;margin-bottom:8px;}
.ra-dim-bar-track{flex:1;height:12px;background:#e8e6e2;border-radius:6px;overflow:hidden;}
.ra-dim-bar-fill{height:100%;border-radius:6px;transition:width .6s ease .1s;}
.ra-dim-bar-pct{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;min-width:36px;text-align:right;}
.ra-dim-label-row{display:flex;justify-content:space-between;align-items:baseline;}
.ra-dim-score-text{font-size:13px;color:#999;}
.ra-dim-status{font-size:12px;font-weight:700;font-family:"Montserrat",Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;}

/* ── Gap analysis ── */
.ra-gap-section{margin-bottom:40px;}
.ra-gap-header{margin-bottom:20px;}
.ra-gap-header .eyebrow{margin-bottom:8px;}
.ra-gap-header h3{font-size:22px;font-weight:700;color:#26245C;margin:0 0 8px;}
.ra-gap-header p{font-size:16px;color:#666;margin:0;}
.ra-gap-cards{display:flex;flex-direction:column;gap:16px;}
.ra-gap-card{background:#fff;border:1px solid #e0ddd5;border-top:3px solid #e0ddd5;border-radius:12px;padding:20px 24px;}
.ra-gap-card-top{display:flex;align-items:center;gap:10px;margin-bottom:4px;}
.ra-gap-card-name{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#26245C;}
.ra-gap-tag{padding:2px 10px;border-radius:999px;font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;color:#fff;}
.ra-gap-card-pct{margin-left:auto;font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;}
.ra-gap-context{font-size:13px;color:#999;margin:0 0 10px;font-style:italic;}
.ra-gap-action{font-size:15px;color:#444;margin:0;line-height:1.55;}
.ra-gap-action strong{color:#26245C;font-weight:600;}

/* ── CTA strip ── */
.ra-results-actions{display:flex;align-items:center;gap:24px;margin-bottom:40px;}
.ra-cta-strip{padding:32px;background:#fff;border:1px solid #e0ddd5;border-radius:12px;}
.ra-cta-strip .eyebrow{margin-bottom:10px;}
.ra-cta-strip p{margin:0 0 16px;color:#666;font-size:18px;}

/* ── Section divider (two beige sections meet) ── */
.res-ld-close{border-top:1px solid #d4d0c8;}

/* ── Print ── */
@media print{
  nav,footer,.res-ld-close,.res-hero,.ra-nav,.ra-results-actions,.ra-cta-strip,
  .ra-stepper,.ra-section-head,#ra-form-view{display:none!important;}
  .ra-tool{padding:0;background:#fff;}
  .res-inner{max-width:100%;}
  #ra-results-view{display:block!important;}
  .ra-dim-grid{grid-template-columns:repeat(2,1fr);}
  .ra-score-banner,.ra-dim-card,.ra-gap-card{border:1px solid #ccc;break-inside:avoid;}
}
@media(max-width:760px){
  .ra-tool{padding:48px 20px 64px;}
  .ra-dim-grid{grid-template-columns:1fr;}
  .ra-q-item{grid-template-columns:1fr;gap:12px;}
  /* ra-q-header shown with abbreviated labels */
  .ra-likert{grid-template-columns:repeat(5,1fr);}
  .ra-step-label{display:none;}
}

/* ── abbreviated labels (desktop full, mobile short) ── */
.lbl-short{display:none;}
/* ── legend ── */
.ra-legend{display:flex;flex-wrap:wrap;gap:12px 28px;margin-bottom:32px;padding:14px 20px;background:#fff;border:1px solid #e0ddd5;border-radius:10px;}
.ra-legend-item{display:flex;align-items:center;gap:8px;font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:600;color:#444;letter-spacing:.04em;}
.ra-legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.ra-legend-range{font-weight:400;color:#999;margin-left:2px;}
/* ── dim card icon header ── */
.ra-dim-card-head{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.ra-dim-icon{display:flex;align-items:center;flex-shrink:0;}
.ra-dim-name-text{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin:0;}
/* ── suggested action label ── */
.ra-gap-action-label{font-family:"Montserrat",Arial,sans-serif;font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#aaa;margin:14px 0 4px;}
/* ── score tier desc on screen ── */
.ra-tier-desc{font-size:18px;color:#555;line-height:1.6;margin:8px 0 0;}
@media(max-width:760px){
  .lbl-full{display:none;}
  .lbl-short{display:inline;}
  .ra-q-header{display:grid !important;}
  .ra-q-header-labels span{font-size:9px;}
}
</style>
<script>
const SECTIONS = [
  {
    key:"leadership",label:"SECTION 1 OF 4",title:"Leadership Readiness",
    note:"How committed and aligned is leadership to driving the transformation?",
    questions:[
      "Senior leaders actively sponsor and champion the transformation: it is not delegated below SES or executive level.",
      "Leaders are prepared to change their own behaviours and ways of working as part of the programme.",
      "There is clear accountability for transformation outcomes at the executive or board level.",
      "Decisions in this organisation are made on data and evidence, not primarily on opinion or seniority.",
      "Leadership has a track record of seeing improvement and change work through to completion."
    ]
  },
  {
    key:"operational",label:"SECTION 2 OF 4",title:"Operational Readiness",
    note:"Are the operating conditions in place to support change?",
    questions:[
      "Core processes being targeted for improvement are documented and understood before any changes are made.",
      "Staff have genuine capacity to participate in improvement work alongside their BAU responsibilities.",
      "The organisation has experience running structured change or improvement projects.",
      "Technology and systems can support the operating changes being proposed.",
      "Key suppliers, partners, or dependencies are ready to adapt alongside internal changes."
    ]
  },
  {
    key:"change",label:"SECTION 3 OF 4",title:"Change Readiness",
    note:"How well positioned is the organisation to absorb and sustain change?",
    questions:[
      "Staff at all levels understand why this transformation is necessary: not just that it is happening.",
      "There is a clear, consistent narrative about what success looks like and who benefits.",
      "Previous change efforts in this organisation have been seen through rather than abandoned.",
      "Resistance to change is actively managed and addressed, rather than ignored or suppressed.",
      "Affected stakeholders have been engaged early and their concerns taken seriously."
    ]
  },
  {
    key:"measurement",label:"SECTION 4 OF 4",title:"Measurement Readiness",
    note:"Can you tell whether the transformation is working?",
    questions:[
      "Baseline performance data exists for the areas being targeted for improvement.",
      "The organisation has agreed metrics for what transformation success looks like.",
      "There are regular rhythms for reviewing progress against targets.",
      "Benefit realisation will be actively tracked and reported to leadership throughout the programme."
    ]
  }
];

const LABELS=["Strongly disagree","Disagree","Neutral","Agree","Strongly agree"];
const DIM_NAMES={leadership:"Leadership",operational:"Operational",change:"Change",measurement:"Measurement"};
const DIM_MAX={leadership:25,operational:25,change:25,measurement:20};
const DIM_CONTEXT={
  leadership:"Whether senior leaders genuinely own the transformation: not just sponsor it on paper.",
  operational:"Whether the operating conditions, capacity, and systems can support the change.",
  change:"Whether the organisation can absorb, sustain, and commit to change over time.",
  measurement:"Whether you can tell whether the transformation is working and delivering value."
};
const DIM_ICONS={
  leadership:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="6" r="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 16.5c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  operational:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="2" stroke="currentColor" stroke-width="1.5"/><path d="M9 2.5v2M9 13.5v2M2.5 9h2M13.5 9h2M4.4 4.4l1.4 1.4M12.2 12.2l1.4 1.4M4.4 13.6l1.4-1.4M12.2 5.8l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  change:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3.5 9a5.5 5.5 0 0 1 10.1-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M14.5 9a5.5 5.5 0 0 1-10.1 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M13.6 6 14 3l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.4 12 4 15l-2-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  measurement:'<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="12.5" width="3" height="4" rx=".5" stroke="currentColor" stroke-width="1.5"/><rect x="7.5" y="8.5" width="3" height="8" rx=".5" stroke="currentColor" stroke-width="1.5"/><rect x="13" y="4.5" width="3" height="12" rx=".5" stroke="currentColor" stroke-width="1.5"/></svg>',
};
const TIERS=[
  {min:0,max:39,title:"Not ready",color:"#C15F3C",description:"Significant gaps across readiness dimensions. Committing to a full transformation programme now carries high risk. Focus on the lowest-scoring dimensions first to build the foundations."},
  {min:40,max:59,title:"Early stage",color:"#E09C50",description:"Some readiness is in place but meaningful gaps remain. A targeted preparation phase: focused on the weakest dimensions: will materially improve outcomes before a programme starts."},
  {min:60,max:74,title:"Developing",color:"#7A8591",description:"A reasonable foundation exists. Address the gaps identified before scaling. A phased or piloted approach is lower risk than a full programme launch."},
  {min:75,max:89,title:"Ready to proceed",color:"#26245C",description:"Strong readiness across most dimensions. Proceed with clear mitigation plans for any gaps. Focus the early stages on the areas below that need attention."},
  {min:90,max:100,title:"High readiness",color:"#26245C",description:"Excellent foundations across all dimensions. The conditions for a successful transformation are in place. Maintain rigour on measurement and leadership visibility throughout delivery."}
];
const GAP_SHIFTS={
  leadership:{
    low:"Start with a frank conversation at board level about genuine commitment. A sponsor without real accountability for outcomes is decoration.",
    mid:"Secure a named executive champion with decision-making authority, not just advocacy. Test whether leaders are prepared to change their own working patterns.",
    high:"Deepen leadership engagement from sponsorship to visible participation in the change process: attending reviews, not just receiving them."
  },
  operational:{
    low:"Document and baseline the processes being targeted before any programme begins. You cannot improve what you cannot see.",
    mid:"Create protected capacity for change work. Improvement running alongside BAU without dedicated time means neither succeeds.",
    high:"Build the internal project management capability to run structured change, rather than depending entirely on external support."
  },
  change:{
    low:"Build the case for change and test whether staff at all levels understand why: not just that it is happening. Without a credible why, resistance is inevitable.",
    mid:"Address the history of change. If previous efforts were abandoned, acknowledge it openly. Credibility cannot be asserted; it must be rebuilt through follow-through.",
    high:"Move from communication to co-design. Teams who helped shape the solution sustain it after go-live. Teams who were informed often do not."
  },
  measurement:{
    low:"Establish baseline data before the programme starts. Without a baseline, you cannot demonstrate value or know when to course-correct.",
    mid:"Agree on the specific metrics that define success before the programme launches: not partway through when pressure mounts.",
    high:"Build benefit realisation into the programme governance structure so it is tracked and reported throughout, not just at the end."
  }
};

let currentSection=0;
const answers={};

function pct(score,max){return Math.round((score/max)*100);}
function barColor(p){if(p<40)return"#C15F3C";if(p<60)return"#E09C50";if(p<75)return"#7A8591";return"#26245C";}
function statusLabel(p){
  if(p<40)return{label:"Needs attention",note:"Below 40%: foundational work needed."};
  if(p<60)return{label:"Developing",note:"40:59%: some structure in place but inconsistent."};
  if(p<75)return{label:"Progressing",note:"60:74%: foundations developing well."};
  return{label:"Strong",note:"75%+: this dimension is well established."};
}
function getGlobalQ(si,qi){let n=1;for(let i=0;i<si;i++)n+=SECTIONS[i].questions.length;return n+qi;}

function updateStepper(idx){
  document.querySelectorAll(".ra-step").forEach((el,i)=>{
    el.classList.remove("is-active","is-done");
    if(i===idx)el.classList.add("is-active");
    else if(i<idx)el.classList.add("is-done");
  });
  document.querySelectorAll(".ra-step-line").forEach((el,i)=>{el.classList.toggle("is-done",i<idx);});
}

function renderSection(idx){
  const s=SECTIONS[idx];
  document.getElementById("ra-section-label").textContent=s.label;
  document.getElementById("ra-section-title").textContent=s.title;
  document.getElementById("ra-section-note").textContent=s.note;
  const saved=answers[s.key]||{};
  const anon=document.getElementById("ra-anon-notice");
  if(anon)anon.style.display=idx===0?"flex":"none";
  updateStepper(idx);
  const colHeaders=`<div class="ra-q-header"><div></div><div class="ra-q-header-labels">${LABELS.map((l,i)=>`<span><span class="lbl-full">${l}</span><span class="lbl-short">${LABELS_SHORT[i]}</span></span>`).join("")}</div></div>`;
  document.getElementById("ra-questions").innerHTML=colHeaders+`<ul class="ra-q-list">${
    s.questions.map((q,qi)=>`<li class="ra-q-item" id="ra-q-${qi}">
      <p class="ra-q-text"><span class="ra-q-num">${getGlobalQ(idx,qi)}.</span> ${q}</p>
      <div class="ra-likert">${LABELS.map((lbl,val)=>`<label><input type="radio" name="q${qi}" value="${val+1}" ${saved[qi]===val+1?"checked":""} aria-label="${lbl}"></label>`).join("")}</div>
    </li>`).join("")
  }</ul>`;
  document.getElementById("ra-prev").style.display=idx>0?"inline-flex":"none";
  document.getElementById("ra-next").textContent=idx===SECTIONS.length-1?"See my results":"Next section";
  document.getElementById("ra-required-note").textContent="";
}

function collectSection(idx){
  const s=SECTIONS[idx];const res={};let allAnswered=true;
  s.questions.forEach((_,qi)=>{
    const c=document.querySelector(`input[name="q${qi}"]:checked`);
    if(c)res[qi]=parseInt(c.value);else allAnswered=false;
  });
  return{res,allAnswered};
}

function buildPrintHTML(dimScores,tier,totalPct){
  const date=new Date().toLocaleDateString("en-AU",{day:"numeric",month:"long",year:"numeric"});
  const cards=SECTIONS.map(s=>{
    const sc=dimScores[s.key];const max=DIM_MAX[s.key];const p=pct(sc,max);const color=barColor(p);const st=statusLabel(p);
    return`<div style="background:#fff;border:1px solid #ddd;border-left:4px solid ${color};border-radius:0 8px 8px 0;padding:16px 20px;margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <span style="font-family:Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;">${DIM_NAMES[s.key]} Readiness</span>
        <span style="font-size:12px;font-weight:700;color:${color};">${st.label}: ${p}%</span>
      </div>
      <div style="height:10px;background:#e8e6e2;border-radius:5px;margin-bottom:8px;overflow:hidden;"><div style="height:100%;width:${p}%;background:${color};border-radius:5px;"></div></div>
      <div style="font-size:12px;color:#888;">${sc} / ${max} · ${DIM_CONTEXT[s.key]}</div>
    </div>`;
  }).join("");
  const gapItems=SECTIONS.map(s=>({key:s.key,p:pct(dimScores[s.key],DIM_MAX[s.key])}))
    .sort((a,b)=>a.p-b.p).map(g=>{
      const color=barColor(g.p);const level=g.p<40?"low":g.p<65?"mid":"high";
      return`<div style="margin-bottom:14px;padding:14px 18px;border:1px solid #ddd;border-radius:8px;background:#fff;">
        <div style="font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:${color};margin-bottom:6px;">${DIM_NAMES[g.key]}: ${g.p}%</div>
        <div style="font-size:13px;color:#444;line-height:1.5;">${GAP_SHIFTS[g.key][level]}</div>
      </div>`;
    }).join("");
  return`<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>Transformation Readiness Results: EQUIBT</title>
<style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:Georgia,serif;color:#1a1a2e;background:#fff;padding:40px 48px;max-width:760px;margin:0 auto;font-size:14px;}.print-btn{display:block;margin-bottom:32px;padding:10px 22px;background:#1a1a2e;color:#fff;border:none;border-radius:6px;font-family:Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;}@media print{.print-btn{display:none;}}</style>
</head><body>
<button class="print-btn" onclick="window.print()">Print / Save as PDF</button>
<div style="border-bottom:2px solid #1a1a2e;padding-bottom:16px;margin-bottom:24px;">
  <div style="font-family:Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#999;">EQUIBT · Transformation Readiness Assessment</div>
  <div style="font-size:12px;color:#999;margin-top:4px;">Generated ${date} · Anonymous results</div>
</div>
<div style="margin-bottom:28px;">
  <div style="font-family:Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:8px;">YOUR READINESS</div>
  <div style="display:flex;align-items:center;gap:16px;margin-bottom:10px;">
    <div style="width:64px;height:64px;border-radius:50%;background:${tier.color};display:flex;align-items:center;justify-content:center;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#fff;flex-shrink:0;">${totalPct}%</div>
    <div>
      <div style="font-family:Arial,sans-serif;font-size:26px;font-weight:700;color:${tier.color};margin-bottom:4px;">${tier.title}</div>
      <div style="font-size:13px;color:#555;line-height:1.5;max-width:520px;">${tier.description}</div>
    </div>
  </div>
</div>
<div style="font-family:Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:10px;">DIMENSION BREAKDOWN</div>
${cards}
<div style="margin-top:24px;border-top:1px solid #ddd;padding-top:20px;">
  <div style="font-family:Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999;margin-bottom:14px;">PRIORITIES: WHERE TO FOCUS FIRST</div>
  ${gapItems}
</div>
</body></html>`;
}

function showResults(){
  document.getElementById("ra-form-view").style.display="none";
  const rv=document.getElementById("ra-results-view");
  rv.style.display="block";
  rv.scrollIntoView({behavior:"smooth",block:"start"});
  const dimScores={};
  SECTIONS.forEach(s=>{dimScores[s.key]=Object.values(answers[s.key]||{}).reduce((a,v)=>a+v,0);});
  const totalScore=Object.values(dimScores).reduce((a,v)=>a+v,0);
  const totalMax=Object.values(DIM_MAX).reduce((a,v)=>a+v,0);
  const totalPct=pct(totalScore,totalMax);
  const tier=TIERS.find(t=>totalPct>=t.min&&totalPct<=t.max)||TIERS[TIERS.length-1];

  const tierTitleEl=document.getElementById("ra-tier-title");
  if(tierTitleEl) tierTitleEl.textContent=tier.title;
  const tierDescEl=document.getElementById("ra-tier-description");
  if(tierDescEl) tierDescEl.textContent=tier.description;
  const rh=document.getElementById("ra-results-head");
  if(rh){
    rh.innerHTML=`<div class="ra-score-banner">
      <div class="ra-score-circle" style="background:${tier.color};">${totalPct}%</div>
      <div><p class="ra-score-tier">${tier.title}</p><p class="ra-score-desc">${tier.description}</p></div>
    </div>`;
  }

  const dimGrid=document.getElementById("ra-dim-grid");
  dimGrid.innerHTML=`<div class="ra-results-eyebrow" style="grid-column:1/-1;">Dimension breakdown</div>`+SECTIONS.map(s=>{
    const score=dimScores[s.key];const max=DIM_MAX[s.key];const p=pct(score,max);
    const color=barColor(p);const st=statusLabel(p);
    return`<div class="ra-dim-card">
      <div class="ra-dim-card-head"><span class="ra-dim-icon" style="color:${color};">${DIM_ICONS[s.key]||''}</span><p class="ra-dim-name-text">${DIM_NAMES[s.key]} Readiness</p></div>
      <div class="ra-dim-bar-row">
        <div class="ra-dim-bar-track"><div class="ra-dim-bar-fill" style="width:${p}%;background:${color};"></div></div>
        <span class="ra-dim-bar-pct" style="color:${color};">${p}%</span>
      </div>
      <div class="ra-dim-label-row">
        <span class="ra-dim-score-text">${score} / ${max}</span>
        <span class="ra-dim-status" style="color:${color};">${st.label}</span>
      </div>
      <p style="font-size:12px;color:#999;margin:6px 0 0;font-style:italic;">${DIM_CONTEXT[s.key]}</p>
    </div>`;
  }).join("");

  // Legend
  const lgd=document.createElement('div');lgd.className='ra-legend';
  lgd.innerHTML='<span class="ra-legend-item"><span class="ra-legend-dot" style="background:#C15F3C;"></span>Needs attention<span class="ra-legend-range">(below 40%)</span></span><span class="ra-legend-item"><span class="ra-legend-dot" style="background:#E09C50;"></span>Developing<span class="ra-legend-range">(40-59%)</span></span><span class="ra-legend-item"><span class="ra-legend-dot" style="background:#7A8591;"></span>Progressing<span class="ra-legend-range">(60-74%)</span></span><span class="ra-legend-item"><span class="ra-legend-dot" style="background:#26245C;"></span>Strong<span class="ra-legend-range">(75% +)</span></span>';
  dimGrid.after(lgd);

  // Gap analysis
  const gaps=SECTIONS.map(s=>({key:s.key,p:pct(dimScores[s.key],DIM_MAX[s.key])})).sort((a,b)=>a.p-b.p);
  const gapSection=document.getElementById("ra-gap-section");
  if(gapSection){
    gapSection.innerHTML=`<div class="ra-gap-header">
      <div class="eyebrow">YOUR PRIORITIES</div>
      <h3>Where to focus first</h3>
      <p id="ra-gap-intro">${totalPct<60?"These dimensions have foundational gaps. Addressing them before launching a programme significantly reduces delivery risk.":"These are the dimensions with the most room to improve. Addressing them will sharpen the conditions for success."}</p>
    </div>
    <div id="ra-gap-cards">${gaps.map(g=>{
      const color=barColor(g.p);const level=g.p<40?"low":g.p<65?"mid":"high";
      const tag=g.p<40?"Priority":g.p<65?"Develop":g.p<75?"Strengthen":"Strong";
      return`<div class="ra-gap-card" style="border-top-color:${color};">
        <div class="ra-gap-card-top">
          <span class="ra-gap-card-name">${DIM_NAMES[g.key]}</span>
          <span class="ra-gap-tag" style="background:${color};">${tag}</span>
          <span class="ra-gap-card-pct" style="color:${color};">${g.p}%</span>
        </div>
        <p class="ra-gap-context">${DIM_CONTEXT[g.key]}</p>
        <p class="ra-gap-action-label">Suggested action</p><p class="ra-gap-action">${GAP_SHIFTS[g.key][level]}</p>
      </div>`;
    }).join("")}</div>`;
  }
}

document.getElementById("ra-next").addEventListener("click",()=>{
  const{res,allAnswered}=collectSection(currentSection);
  if(!allAnswered){document.getElementById("ra-required-note").textContent="Please answer all questions before continuing.";return;}
  answers[SECTIONS[currentSection].key]=res;
  if(currentSection===SECTIONS.length-1){showResults();}
  else{currentSection++;renderSection(currentSection);document.getElementById("ra-form-view").scrollIntoView({behavior:"smooth",block:"start"});}
});
document.getElementById("ra-prev").addEventListener("click",()=>{
  const{res}=collectSection(currentSection);
  answers[SECTIONS[currentSection].key]=res;
  currentSection--;renderSection(currentSection);
  document.getElementById("ra-form-view").scrollIntoView({behavior:"smooth",block:"start"});
});
document.getElementById("ra-download-btn").addEventListener("click",()=>{
  const dimScores={};
  SECTIONS.forEach(s=>{dimScores[s.key]=Object.values(answers[s.key]||{}).reduce((a,v)=>a+v,0);});
  const totalScore=Object.values(dimScores).reduce((a,v)=>a+v,0);
  const totalMax=Object.values(DIM_MAX).reduce((a,v)=>a+v,0);
  const totalPct=pct(totalScore,totalMax);
  const tier=TIERS.find(t=>totalPct>=t.min&&totalPct<=t.max)||TIERS[TIERS.length-1];
  const w=window.open("","_blank");
  w.document.write(buildPrintHTML(dimScores,tier,totalPct));
  w.document.close();
});
document.getElementById("ra-restart-btn").addEventListener("click",()=>{
  Object.keys(answers).forEach(k=>delete answers[k]);
  currentSection=0;
  document.getElementById("ra-results-view").style.display="none";
  const fv=document.getElementById("ra-form-view");fv.style.display="block";
  renderSection(0);fv.scrollIntoView({behavior:"smooth",block:"start"});
});

renderSection(0);
</script>
