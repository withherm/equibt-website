---
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import DocReport from "../../../components/icons/glyphs/DocReport.astro";
import "../../../styles/resources.css";
---

<Layout
  title="Improvement Project Canvas | EQUIBT Resources"
  description="One page that aligns the why, the what, the who and the where before work begins. Work through each part, then download a clean canvas. Nothing is sent or stored."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal" id="pc-hero">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>Improvement Project Canvas</span>
          </div>
          <div class="eyebrow">TEMPLATE</div>
          <div id="pc-hero-body">
            <h1>Map the whole project on one page.</h1>
            <p class="res-hero-lede">One page that aligns the why, the what, the who and the where before work begins. Each field is capped on purpose, so a sharp canvas fits on a single page. Work through each part, then download it. Nothing is sent or stored.</p>
            <div class="res-hero-actions">
              <button type="button" class="btn-primary" id="pc-start-btn">Start the canvas</button>
              <a href="/contact/" class="btn-text"><span class="link-label">Talk it through instead</span> <span class="ar">&rsaquo;</span></a>
            </div>
          </div>
        </div>
        <div class="res-hero-art" id="pc-hero-art" aria-hidden="true">
          <span><DocReport /></span>
        </div>
      </div>
    </section>

    <section class="pc-tool res-reveal" id="improvement-project-canvas-tool">
      <div class="res-inner">
        <div id="pc-form-view" hidden>
          <div class="pc-section-head">
            <div class="eyebrow" id="pc-section-label">STEP 1 OF 5</div>
            <h2 id="pc-section-title">Why</h2>
          </div>
          <nav class="pc-stepper" id="pc-stepper" aria-label="Improvement Project Canvas steps">
            <div class="pc-step is-active" data-step="0"><div class="pc-step-dot">1</div><span class="pc-step-label">Why</span></div>
            <div class="pc-step-line"></div>
            <div class="pc-step" data-step="1"><div class="pc-step-dot">2</div><span class="pc-step-label">What</span></div>
            <div class="pc-step-line"></div>
            <div class="pc-step" data-step="2"><div class="pc-step-dot">3</div><span class="pc-step-label">Who &amp; When</span></div>
            <div class="pc-step-line"></div>
            <div class="pc-step" data-step="3"><div class="pc-step-dot">4</div><span class="pc-step-label">Where</span></div>
            <div class="pc-step-line"></div>
            <div class="pc-step" data-step="4"><div class="pc-step-dot">5</div><span class="pc-step-label">Review</span></div>
          </nav>
          <form id="pc-form" novalidate>
            <div id="pc-fields"></div>
            <div class="pc-nav">
              <button type="button" class="btn-text" id="pc-prev"><span class="ar pc-back-ar">&rsaquo;</span> <span class="link-label">Back</span></button>
              <button type="button" class="btn-primary" id="pc-next">Next</button>
            </div>
          </form>
        </div>

        <div id="pc-review-view" hidden>
          <div class="pc-section-head">
            <div class="eyebrow">STEP 5 OF 5</div>
            <h2>Review and download</h2>
          </div>
          <div class="pc-review-actions">
            <button type="button" class="btn-primary" id="pc-download-btn">Download canvas</button>
            <button type="button" class="btn-text" id="pc-back-edit-btn"><span class="link-label">Back to edit</span></button>
          </div>
          <article class="pc-doc" id="pc-doc" aria-live="polite"></article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
.pc-tool{padding:72px 56px 88px;background:#F5F3EE;}
.pc-section-head{margin-bottom:28px;}
.pc-section-head .eyebrow{margin-bottom:12px;}
.pc-section-head h2{font-size:clamp(26px,2.6vw,34px);font-weight:700;margin:0;color:var(--navy);}

.pc-stepper{display:flex;align-items:flex-start;margin:0 0 34px;}
.pc-step{display:flex;flex-direction:column;align-items:center;gap:4px;flex-shrink:0;min-width:48px;}
.pc-step-dot{width:24px;height:24px;border-radius:50%;border:2px solid #d4d0c8;background:#fff;display:flex;align-items:center;justify-content:center;font-family:"Montserrat",Arial,sans-serif;font-size:9px;font-weight:700;color:#777;transition:all .2s;line-height:1;}
.pc-step.is-active .pc-step-dot{background:#C15F3C;border-color:#C15F3C;color:#fff;}
.pc-step.is-done .pc-step-dot{background:#26245C;border-color:#26245C;color:#fff;}
.pc-step-label{font-family:"Montserrat",Arial,sans-serif;font-size:9px;font-weight:700;letter-spacing:.06em;color:#777;text-transform:uppercase;text-align:center;white-space:nowrap;}
.pc-step.is-active .pc-step-label{color:#C15F3C;}
.pc-step.is-done .pc-step-label{color:#26245C;}
.pc-step-line{flex:1;height:2px;background:#d4d0c8;margin:11px 2px 0;transition:background .2s;min-width:12px;}
.pc-step-line.is-done{background:#26245C;}

.pc-panel{background:transparent;border:0;border-radius:0;padding:0;}
.pc-field-grid{display:grid;gap:28px;max-width:920px;}
.pc-field{display:grid;gap:10px;}
.pc-label,.pc-cell-title{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);}
.pc-prompt{margin:0;color:var(--caption);font-size:16px;line-height:1.42;}
.pc-input,.pc-textarea{
  width:100%;box-sizing:border-box;
  background:#fff;border:1px solid var(--hairline);border-radius:8px;
  padding:15px 16px;
  font-family:"Lora",Georgia,serif;font-size:20px;font-weight:500;line-height:1.45;color:var(--near-black);
  outline:none;transition:border-color .15s,box-shadow .15s;resize:none;
}
.pc-input:focus,.pc-textarea:focus{border-color:#C15F3C;box-shadow:0 0 0 3px rgba(193,95,60,.16);}
.pc-textarea{height:120px;}
.pc-example{margin:-2px 0 0;color:var(--muted);font-size:14px;font-style:italic;line-height:1.4;}
.pc-count{margin-top:-2px;font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--muted);text-align:right;}
.pc-count.is-low{color:#C15F3C;}
.pc-nav{display:flex;align-items:center;gap:24px;margin-top:28px;}
.pc-nav button.btn-primary,.pc-review-actions button.btn-primary,.pc-print-actions button.btn-primary{border:none!important;-webkit-appearance:none!important;appearance:none!important;box-shadow:none!important;transform:none!important;}
.pc-nav button.btn-primary:hover,.pc-review-actions button.btn-primary:hover,.pc-print-actions button.btn-primary:hover{border:none!important;box-shadow:none!important;transform:none!important;background:#2f2d6e;}
.pc-nav button.btn-text,.pc-review-actions button.btn-text{border:none;background:transparent;cursor:pointer;padding:0;}
.pc-back-ar{transform:rotate(180deg);}

.pc-review-actions{display:flex;align-items:center;gap:24px;margin:0 0 28px;}
.pc-doc{background:#fff;border:1px solid var(--hairline);border-radius:8px;padding:36px;color:#161616;}
.pc-canvas-logo{display:flex;justify-content:flex-end;margin-bottom:22px;}
.pc-canvas-logo svg{height:28px;width:auto;display:block;}
.pc-canvas-head{margin-bottom:24px;}
.pc-canvas-head h1{margin:0 0 6px;color:var(--navy);font-size:32px;line-height:1.12;}
.pc-doc-project{margin:0;color:var(--mid-grey);font-size:22px;line-height:1.35;min-height:1.35em;}
.pc-canvas-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-left:1px solid var(--hairline);border-top:1px solid var(--hairline);}
.pc-canvas-column{display:grid;grid-template-rows:auto repeat(3,minmax(150px,auto));border-right:1px solid var(--hairline);}
.pc-column-head{padding:14px 14px 12px;border-bottom:1px solid var(--hairline);}
.pc-column-rule{display:block;width:100%;height:3px;margin-bottom:12px;background:var(--pc-accent);}
.pc-column-title{margin:0;font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);}
.pc-cell{padding:16px 14px;border-bottom:1px solid var(--hairline);min-height:150px;}
.pc-cell-title{display:block;margin-bottom:10px;font-size:10px;}
.pc-cell p{margin:0;color:#161616;font-size:17px;line-height:1.5;white-space:pre-wrap;min-height:92px;}
.pc-doc-footer{margin:24px 0 0;padding-top:14px;border-top:1px solid var(--hairline);font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.04em;color:#2a2a2a;}

@media(max-width:1000px){
  .pc-canvas-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
}
@media(max-width:900px){
  .pc-tool{padding:48px 24px 64px;}
  .pc-step-label{display:none;}
  .pc-doc{padding:28px 24px;}
}
@media(max-width:620px){
  .pc-tool{padding-left:22px;padding-right:22px;}
  .pc-doc{padding:24px 20px;}
  .pc-canvas-grid{grid-template-columns:1fr;}
  .pc-canvas-head h1{font-size:28px;}
  .pc-doc-project{font-size:20px;}
  .pc-review-actions,.pc-nav{align-items:flex-start;flex-direction:column;}
}
</style>

<script>
const PRINT_LOGO = `<svg viewBox="0 0 1900.02 441.3" role="img" aria-label="EQUIBT"><g fill="#2C3E50"><path d="M45.48,308.58v-172.32h186.84v33.08H87.37v35.23h100.68v33.08h-100.68v37.84h151.61v33.08H45.48Z"/><path d="M421.06,310.01c-5.56,1.11-10.99,1.94-16.3,2.5-5.32.55-10.67.83-16.06.83-17.61,0-33.88-2.46-48.79-7.38-14.92-4.91-27.77-11.9-38.56-20.94-9.84-8.09-17.22-17.45-22.13-28.09-4.92-10.63-7.38-22.29-7.38-34.99,0-25.39,10-46.25,29.99-62.6,10.95-9.04,23.88-16.07,38.8-21.06,14.91-5,31.02-7.5,48.32-7.5s33.44,2.51,48.43,7.5c14.99,5,27.88,12.03,38.68,21.08,19.99,16.68,29.99,37.55,29.99,62.64,0,16.36-4.13,30.93-12.38,43.71-8.25,12.78-20.55,23.46-36.89,32.03l23.09,24.16-36.65,10.95-22.14-22.85ZM431.05,271.21c10.63-5.24,18.6-12.02,23.92-20.35,5.31-8.33,7.97-17.97,7.97-28.92,0-8.57-1.75-16.42-5.24-23.56-3.49-7.14-8.45-13.25-14.88-18.33-6.43-5.08-14.2-9.04-23.33-11.9-9.13-2.86-19.32-4.28-30.58-4.28s-21.46,1.43-30.58,4.29c-9.13,2.86-16.9,6.87-23.32,12.04-6.43,5.17-11.39,11.29-14.88,18.36-3.49,7.08-5.24,14.91-5.24,23.49s1.7,16.69,5.12,23.85c3.41,7.15,8.33,13.27,14.76,18.36,6.43,5.09,14.16,9.03,23.21,11.81,9.05,2.78,19.28,4.17,30.7,4.17h3.33l-19.52-20.47,37.37-10.47,21.18,21.9Z"/><path d="M772.36,250.74c0,9.04-2.42,17.45-7.26,25.2-4.84,7.76-11.75,14.4-20.71,19.91-8.97,5.52-19.87,9.85-32.73,13-12.85,3.15-27.37,4.73-43.56,4.73s-30.7-1.58-43.55-4.73c-12.85-3.15-23.76-7.48-32.73-13-8.97-5.51-15.87-12.15-20.71-19.91-4.84-7.76-7.26-16.16-7.26-25.2v-114.24h41.89v108.53c0,10.63,5.39,19.2,16.18,25.71,10.79,6.51,26.18,9.76,46.17,9.76s35.38-3.29,46.17-9.88c10.79-6.58,16.18-15.11,16.18-25.59v-108.53h41.89v114.24Z"/><path d="M846.14,308.58v-172.32h41.89v172.32h-41.89Z"/><path d="M1147.69,219.09c8.57,4.76,15.15,10.35,19.75,16.78,4.6,6.43,6.9,14.16,6.9,23.21,0,7.14-1.51,13.73-4.52,19.75-3.02,6.03-7.34,11.27-12.97,15.71-5.63,4.44-12.46,7.89-20.47,10.35-8.01,2.46-17.1,3.69-27.25,3.69h-150.18v-172.32h145.42c9.84,0,19.08,1.83,27.73,5.48,8.65,3.65,15.83,8.65,21.54,14.99,7.77,8.57,11.66,18.33,11.66,29.28,0,7.14-1.43,13.37-4.28,18.68-2.86,5.32-7.3,10.12-13.33,14.4ZM1105.81,203.38c4.6,0,8.61-1.62,12.02-4.88,3.41-3.25,5.12-7.41,5.12-12.49s-1.75-8.93-5.24-12.02c-3.49-3.1-8.01-4.64-13.57-4.64h-103.3v34.04h104.96ZM1105.81,275.5c8.57,0,15.03-1.63,19.4-4.88,4.36-3.25,6.54-7.81,6.54-13.68s-2.22-10.95-6.66-14.76c-4.44-3.81-10.63-5.71-18.56-5.71h-105.68v39.03h104.96Z"/><path d="M1327.39,169.34v139.24h-41.89v-139.24h-82.11v-33.08h206.12v33.08h-82.11Z"/></g><path fill="#26245C" d="M1503.14,44.95v351.41h351.41V44.95h-351.41ZM1756.25,169.92h-58.84v32.17h54.83v34.05h-54.83v37.56h58.84v35.68h-99.53v-35.43h-58.84v-37.56h54.83v-34.05h-54.83v-32.17h58.84v-35.43h99.53v35.18Z"/></svg>`;

const steps = [
  {
    title: "Why",
    fields: [
      { key: "projectName", label: "Project name", prompt: "What is the project called?", type: "input", limit: 50, example: "e.g. Reduce invoice rework in Accounts Payable" },
      { key: "situation", label: "Situation", prompt: "The facts and data about the situation that justify the project.", type: "textarea", limit: 160, example: "e.g. AP handles ~4,000 invoices a month; 18% need rework; two staff lose half their week to it." },
      { key: "problemStatement", label: "Problem statement", prompt: "The pain points from that situation. Be specific and measurable.", type: "textarea", limit: 150, example: "e.g. Rework adds six days to payment cycle time and risks supplier late fees." },
      { key: "implications", label: "Implications", prompt: "The cost of the problem: losses, missed opportunities, unmet demand.", type: "textarea", limit: 150, example: "e.g. About $180k a year in wasted effort and late fees; supplier trust slipping." },
    ],
  },
  {
    title: "What",
    fields: [
      { key: "customerNeeds", label: "Customer needs", prompt: "The performance standards that must be met to satisfy the customer.", type: "textarea", limit: 140, example: "e.g. Suppliers paid accurately, within agreed terms, every time." },
      { key: "objective", label: "Objective", prompt: "What success looks like, in one sentence. Make it specific, measurable and time-bound.", type: "textarea", limit: 130, example: "e.g. Cut invoice rework from 18% to under 5% by Q4." },
      { key: "benefits", label: "Benefits", prompt: "The value created: hard and soft benefits.", type: "textarea", limit: 140, example: "e.g. Fewer late fees, faster payment cycle, two staff freed for better work." },
    ],
  },
  {
    title: "Who & When",
    fields: [
      { key: "stakeholders", label: "Stakeholders", prompt: "People or teams with an interest in, or affected by, the project.", type: "textarea", limit: 140, example: "e.g. AP team, Procurement, the Finance lead, key suppliers." },
      { key: "team", label: "Team", prompt: "The people doing the work, and their roles.", type: "textarea", limit: 130, example: "e.g. AP lead as owner, two processors, a Finance analyst." },
      { key: "timeline", label: "Timeline", prompt: "The high-level phases, as milestones.", type: "textarea", limit: 140, example: "e.g. Discovery (2 wks), Diagnostic (3 wks), Pilot (6 wks), Rollout, Embed." },
    ],
  },
  {
    title: "Where",
    fields: [
      { key: "inScope", label: "In scope", prompt: "What the project covers: processes, teams, sites, time periods.", type: "textarea", limit: 150, example: "e.g. Supplier invoices handled by the AP shared-service team." },
      { key: "outOfScope", label: "Out of scope", prompt: "What it deliberately excludes. Boundaries protect the work.", type: "textarea", limit: 140, example: "e.g. Employee expense claims; the planned ERP upgrade." },
      { key: "assumptions", label: "Assumptions", prompt: "What you are assuming about external factors and constraints.", type: "textarea", limit: 140, example: "e.g. Current ERP stays in place; no headcount change during the pilot." },
    ],
  },
];

const columns = [
  {
    title: "Why",
    accent: "#B65A45",
    cells: [
      { title: "Situation", key: "situation" },
      { title: "Problem statement", key: "problemStatement" },
      { title: "Implications", key: "implications" },
    ],
  },
  {
    title: "What",
    accent: "#4F7D5A",
    cells: [
      { title: "Customer needs", key: "customerNeeds" },
      { title: "Objective", key: "objective" },
      { title: "Benefits", key: "benefits" },
    ],
  },
  {
    title: "Who & When",
    accent: "#C5963A",
    cells: [
      { title: "Stakeholders", key: "stakeholders" },
      { title: "Team", key: "team" },
      { title: "Timeline", key: "timeline" },
    ],
  },
  {
    title: "Where",
    accent: "#3F6F9F",
    cells: [
      { title: "In scope", key: "inScope" },
      { title: "Out of scope", key: "outOfScope" },
      { title: "Assumptions", key: "assumptions" },
    ],
  },
];

const state = {
  projectName: "",
  situation: "",
  problemStatement: "",
  implications: "",
  customerNeeds: "",
  objective: "",
  benefits: "",
  stakeholders: "",
  team: "",
  timeline: "",
  inScope: "",
  outOfScope: "",
  assumptions: "",
};

let currentStep = 0;

function escHtml(value) {
  return String(value || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function valueOf(key) {
  return String(state[key] || "").trim();
}

function updateStepper(idx) {
  document.querySelectorAll(".pc-step").forEach((el, i) => {
    el.classList.remove("is-active", "is-done");
    if (i === idx) el.classList.add("is-active");
    else if (i < idx) el.classList.add("is-done");
  });
  document.querySelectorAll(".pc-step-line").forEach((el, i) => {
    el.classList.toggle("is-done", i < idx);
  });
}

function fieldMarkup(field) {
  const id = `pc-${field.key}`;
  const promptId = `${id}-prompt`;
  const left = field.limit - String(state[field.key] || "").length;
  const input = field.type === "textarea"
    ? `<textarea class="pc-textarea" id="${id}" name="${field.key}" maxlength="${field.limit}" aria-describedby="${promptId}">${escHtml(state[field.key])}</textarea>`
    : `<input class="pc-input" type="text" id="${id}" name="${field.key}" maxlength="${field.limit}" value="${escHtml(state[field.key])}" aria-describedby="${promptId}" />`;
  return `<div class="pc-field">
    <label class="pc-label" for="${id}">${field.label}</label>
    <p class="pc-prompt" id="${promptId}">${field.prompt}</p>
    <p class="pc-example">${field.example}</p>
    ${input}
    <div class="pc-count${left <= 20 ? " is-low" : ""}" id="${id}-count">${left} left</div>
  </div>`;
}

function renderStep(idx) {
  const step = steps[idx];
  currentStep = idx;
  document.getElementById("pc-section-label").textContent = `STEP ${idx + 1} OF 5`;
  document.getElementById("pc-section-title").textContent = step.title;
  updateStepper(idx);
  document.getElementById("pc-fields").innerHTML = `<div class="pc-panel"><div class="pc-field-grid">${
    step.fields.map((field) => fieldMarkup(field)).join("")
  }</div></div>`;
  document.getElementById("pc-prev").style.display = idx > 0 ? "inline-flex" : "none";
  document.getElementById("pc-next").textContent = idx === steps.length - 1 ? "Review" : "Next";
  bindInputs();
}

function bindInputs() {
  document.querySelectorAll("#pc-fields [name]").forEach((el) => {
    const counter = document.getElementById(`pc-${el.name}-count`);
    el.addEventListener("input", () => {
      state[el.name] = el.value;
      if (counter) {
        const left = el.maxLength - el.value.length;
        counter.textContent = `${left} left`;
        counter.classList.toggle("is-low", left <= 20);
      }
    });
  });
}

function renderCanvas() {
  const projectName = valueOf("projectName");
  return `
    <div class="pc-canvas-logo">${PRINT_LOGO}</div>
    <div class="pc-canvas-head">
      <h1>Improvement Project Canvas</h1>
      <p class="pc-doc-project">${projectName ? escHtml(projectName) : ""}</p>
    </div>
    <div class="pc-canvas-grid">
      ${columns.map((column) => `
        <section class="pc-canvas-column" style="--pc-accent:${column.accent}">
          <header class="pc-column-head">
            <span class="pc-column-rule" aria-hidden="true"></span>
            <h2 class="pc-column-title">${column.title}</h2>
          </header>
          ${column.cells.map((cell) => `
            <div class="pc-cell">
              <span class="pc-cell-title">${cell.title}</span>
              <p>${escHtml(valueOf(cell.key))}</p>
            </div>
          `).join("")}
        </section>
      `).join("")}
    </div>
    <p class="pc-doc-footer">Drafted with the EQUIBT Improvement Project Canvas &middot; www.equibt.com</p>
  `;
}

function renderReviewCanvas() {
  document.getElementById("pc-doc").innerHTML = renderCanvas();
}

function showReview() {
  renderReviewCanvas();
  document.getElementById("pc-form-view").hidden = true;
  document.getElementById("pc-review-view").hidden = false;
  updateStepper(4);
  document.getElementById("improvement-project-canvas-tool").scrollIntoView({ behavior: "smooth", block: "start" });
}

function showForm(idx) {
  document.getElementById("pc-review-view").hidden = true;
  document.getElementById("pc-form-view").hidden = false;
  renderStep(idx);
  document.getElementById("improvement-project-canvas-tool").scrollIntoView({ behavior: "smooth", block: "start" });
}

function startCanvas() {
  document.getElementById("pc-hero").classList.add("is-compact");
  document.getElementById("pc-hero-body").innerHTML = `<h1>Improvement Project Canvas</h1>`;
  document.getElementById("pc-hero-art").innerHTML = "";
  showForm(0);
}

function printPageHtml() {
  const canvasUrl = `${window.location.origin}/resources/improvement-project-canvas/`;
  return `<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Improvement Project Canvas</title>
<style>
:root{--navy:#26245C;--hairline:rgba(38,36,92,.18);--near-black:#161616;--mid-grey:#2B2B2B;}
*{box-sizing:border-box;}
body{margin:0;background:#F5F3EE;color:#161616;font-family:"Lora",Georgia,serif;}
.pc-print-actions{display:flex;align-items:center;gap:24px;padding:24px 32px;background:#F5F3EE;}
.btn-primary{display:inline-flex;align-items:center;justify-content:center;background:#26245C;color:#fff;border:0;border-radius:999px;padding:12px 20px;font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;cursor:pointer;}
.btn-text{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#26245C;text-decoration:none;}
.pc-print-shell{max-width:1500px;margin:0 auto;padding:24px 32px 42px;}
.pc-doc{background:#fff;border:1px solid var(--hairline);border-radius:8px;padding:32px;color:#161616;}
.pc-canvas-logo{display:flex;justify-content:flex-end;margin-bottom:22px;}
.pc-canvas-logo svg{height:28px;width:auto;display:block;}
.pc-canvas-head{margin-bottom:24px;}
.pc-canvas-head h1{margin:0 0 6px;color:#26245C;font-family:"Montserrat",Arial,sans-serif;font-size:32px;line-height:1.12;}
.pc-doc-project{margin:0;color:#2B2B2B;font-size:22px;line-height:1.35;min-height:1.35em;}
.pc-canvas-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-left:1px solid var(--hairline);border-top:1px solid var(--hairline);}
.pc-canvas-column{display:grid;grid-template-rows:auto repeat(3,minmax(150px,auto));border-right:1px solid var(--hairline);}
.pc-column-head{padding:14px 14px 12px;border-bottom:1px solid var(--hairline);}
.pc-column-rule{display:block;width:100%;height:3px;margin-bottom:12px;background:var(--pc-accent);}
.pc-column-title{margin:0;font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#26245C;}
.pc-cell{padding:16px 14px;border-bottom:1px solid var(--hairline);min-height:150px;}
.pc-cell-title{display:block;margin-bottom:10px;font-family:"Montserrat",Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#26245C;}
.pc-cell p{margin:0;color:#161616;font-size:17px;line-height:1.5;white-space:pre-wrap;min-height:92px;}
.pc-doc-footer{margin:24px 0 0;padding-top:14px;border-top:1px solid var(--hairline);font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.04em;color:#2a2a2a;}
@page{size:A4 landscape;margin:12mm;}
@media(max-width:1000px){.pc-canvas-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:620px){.pc-print-actions{padding:20px;align-items:flex-start;flex-direction:column;}.pc-print-shell{padding:20px;}.pc-doc{padding:22px 18px;}.pc-canvas-grid{grid-template-columns:1fr;}}
@media print{
  body{background:#fff;}
  .pc-print-actions{display:none!important;}
  .pc-print-shell{max-width:none;margin:0;padding:0;}
  .pc-doc{border:0;border-radius:0;padding:0;}
  .pc-canvas-grid{grid-template-columns:repeat(4,minmax(0,1fr));}
}
</style>
</head>
<body>
<div class="pc-print-actions">
  <button type="button" class="btn-primary" onclick="window.print()">Print or save as PDF</button>
  <a href="${canvasUrl}" class="btn-text">Back to canvas</a>
</div>
<main class="pc-print-shell">
  <article class="pc-doc">${renderCanvas()}</article>
</main>
</body>
</html>`;
}

function openPrintPage() {
  const printWindow = window.open("", "_blank");
  if (!printWindow) return;
  printWindow.document.open();
  printWindow.document.write(printPageHtml());
  printWindow.document.close();
}

document.getElementById("pc-start-btn").addEventListener("click", startCanvas);
document.getElementById("pc-next").addEventListener("click", () => {
  if (currentStep === steps.length - 1) showReview();
  else showForm(currentStep + 1);
});
document.getElementById("pc-prev").addEventListener("click", () => {
  showForm(Math.max(0, currentStep - 1));
});
document.getElementById("pc-back-edit-btn").addEventListener("click", () => {
  showForm(steps.length - 1);
});
document.getElementById("pc-download-btn").addEventListener("click", () => {
  renderReviewCanvas();
  openPrintPage();
});

renderStep(0);
</script>
