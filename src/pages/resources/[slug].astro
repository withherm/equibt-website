---
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import { downloadableResources } from "../../data/resources";

// Card glyphs (line-art library). Keyed by Resource.glyph.
import Capability from "../../components/icons/glyphs/Capability.astro";
import Gauge from "../../components/icons/glyphs/Gauge.astro";
import Loop from "../../components/icons/glyphs/Loop.astro";
import Charter from "../../components/icons/glyphs/Charter.astro";
import Transfer from "../../components/icons/glyphs/Transfer.astro";
import DocTick from "../../components/icons/glyphs/DocTick.astro";
import DocReport from "../../components/icons/glyphs/DocReport.astro";
import "../../styles/resources.css";

export async function getStaticPaths() {
  return downloadableResources.map((r) => ({
    params: { slug: r.slug },
    props: { resource: r },
  }));
}

const { resource } = Astro.props;

const glyphs = {
  Capability,
  Gauge,
  Loop,
  Charter,
  Transfer,
  DocTick,
  DocReport,
} as Record<string, any>;

const Glyph = glyphs[resource.glyph] ?? DocReport;
const lede = resource.lede ?? resource.summary;
---

<Layout
  title={`${resource.title} | EQUIBT Resources`}
  description={resource.summary}
>
  <Nav />
  <main>
    <section class="res-ld-hero res-reveal">
      <div class="res-ld-hero-inner">
        <div class="res-ld-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>{resource.tag}</span>
          </div>
          <div class="eyebrow">{resource.tag}</div>
          <h1>{resource.title}</h1>
          <p class="res-ld-lede">{lede}</p>
          <div class="res-ld-actions">
            <a href={resource.href} class="btn-primary">{resource.actionLabel}</a>
            <a href="/contact/" class="btn-text"><span class="link-label">Talk it through instead</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="res-ld-hero-art" aria-hidden="true">
          <span><Glyph /></span>
        </div>
      </div>
    </section>

    {resource.whatsInside && (
      <section class="res-ld-inside res-reveal">
        <div class="res-inner">
          <div class="eyebrow">WHAT'S INSIDE</div>
          <ul class="res-ld-inside-list">
            {resource.whatsInside.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {resource.related && (
      <section class="res-ld-related res-reveal">
        <div class="res-inner">
          <div class="eyebrow">WHERE IT FITS</div>
          <a href={resource.related.href} class="res-ld-related-card">
            <span class="eyebrow res-ld-related-kicker">{resource.related.kicker}</span>
            <span class="res-ld-related-title">{resource.related.title}</span>
            <span class="btn-text res-ld-related-link"><span class="link-label">Explore {resource.related.title}</span> <span class="ar">&rsaquo;</span></span>
          </a>
        </div>
      </section>
    )}

    <section class="res-ld-close res-reveal">
      <div class="res-inner">
        <div class="res-ld-close-grid">
          <div class="res-ld-close-copy">
            <div class="eyebrow">WORK WITH US</div>
            <h2>Rather have us run it with you?</h2>
            <p>These tools do real work on their own. If you would rather describe the problem to someone, get in touch. A plain description of the operational issue or goal is enough to start.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-ld-close-art" aria-hidden="true">
            <span><Glyph /></span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initialiseResReveals() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".res-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("res-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14 });
    sections.forEach((section) => observer.observe(section));
  }

  initialiseResReveals();
</script>
