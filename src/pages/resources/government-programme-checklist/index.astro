---
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import DocTick from "../../../components/icons/glyphs/DocTick.astro";
import "../../../styles/resources.css";
---

<Layout
  title="Government Programme Checklist | EQUIBT Resources"
  description="25 items across three phases. What to get right before you start, during delivery, and at close."
>
  <Nav />
  <main>
    <section class="res-hero res-reveal">
      <div class="res-hero-inner">
        <div class="res-hero-copy">
          <div class="res-crumb">
            <a href="/resources/">Resources</a>
            <span class="res-crumb-sep">&rsaquo;</span>
            <span>Government Programme Checklist</span>
          </div>
          <div class="eyebrow">CHECKLIST</div>
          <h1>Government programmes fail in predictable ways.</h1>
          <p class="res-hero-lede">25 items across three phases. Work through it, check off each item, and download your completed checklist. Nothing is sent or stored.</p>
          <div class="res-hero-actions">
            <a href="#checklist" class="btn-primary">Open the checklist</a>
            <a href="/contact/" class="btn-text"><span class="link-label">Talk it through instead</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="res-hero-art" aria-hidden="true">
          <span><DocTick /></span>
        </div>
      </div>
    </section>

    <section class="cl-tool res-reveal" id="checklist">
      <div class="res-inner">
        <div class="cl-header">
          <div class="cl-progress-row">
            <div class="cl-progress-bar" aria-hidden="true">
              <div class="cl-progress-fill" id="cl-progress-fill"></div>
            </div>
            <span class="cl-progress-label" id="cl-progress-label">0 of 25 checked</span>
          </div>
          <div class="cl-actions-top">
            <button type="button" class="btn-primary" id="cl-download-btn">Download checklist</button>
            <button type="button" class="btn-text" id="cl-reset-btn"><span class="link-label">Reset all</span></button>
          </div>
        </div>

        <div id="cl-phases"></div>

        <div class="cl-footer-actions">
          <button type="button" class="btn-primary" id="cl-download-btn-2">Download your checklist</button>
          <a href="/contact/" class="btn-text"><span class="link-label">Talk it through with us</span> <span class="ar">&rsaquo;</span></a>
        </div>
      </div>
    </section>

    <section class="res-ld-close res-reveal">
      <div class="res-inner">
        <div class="res-ld-close-grid">
          <div class="res-ld-close-copy">
            <div class="eyebrow">WORK WITH US</div>
            <h2>Rather have us run it with you?</h2>
            <p>These tools do real work on their own. If you would rather describe the problem to someone, get in touch.</p>
            <a href="/contact/" class="btn-primary">Get in touch</a>
          </div>
          <div class="res-ld-close-art" aria-hidden="true">
            <span><DocTick /></span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
.cl-tool{padding:72px 56px 88px;background:#F5F3EE;}

.cl-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-bottom:48px;}
.cl-progress-row{display:flex;align-items:center;gap:16px;flex:1;min-width:200px;}
.cl-progress-bar{flex:1;height:6px;background:var(--hairline);border-radius:3px;}
.cl-progress-fill{height:100%;background:var(--terracotta);border-radius:3px;transition:width .3s ease;width:0%;}
.cl-progress-label{font-family:"Montserrat",Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;color:var(--muted);white-space:nowrap;}
.cl-actions-top{display:flex;align-items:center;gap:20px;}

.cl-phase{margin-bottom:48px;}
.cl-phase-head{display:flex;align-items:baseline;gap:16px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--hairline);}
.cl-phase-title{font-size:22px;font-weight:700;color:var(--navy);margin:0;}
.cl-phase-progress{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;color:var(--muted);}

.cl-items{display:flex;flex-direction:column;gap:12px;}
.cl-item{
  display:flex;align-items:flex-start;gap:16px;
  background:#fff;border:1px solid var(--hairline);border-radius:10px;
  padding:18px 22px;cursor:pointer;
  transition:border-color .15s,background .15s;
}
.cl-item:hover{border-color:var(--terracotta);}
.cl-item.is-checked{background:#F0F4FF;border-color:var(--navy);}
.cl-checkbox{
  flex:0 0 22px;width:22px;height:22px;margin-top:2px;
  border:2px solid var(--hairline);border-radius:5px;
  display:flex;align-items:center;justify-content:center;
  transition:background .15s,border-color .15s;flex-shrink:0;
}
.cl-item.is-checked .cl-checkbox{background:var(--navy);border-color:var(--navy);}
.cl-checkmark{display:none;color:#fff;font-size:14px;line-height:1;}
.cl-item.is-checked .cl-checkmark{display:block;}
.cl-item-num{font-family:"Montserrat",Arial,sans-serif;font-size:11px;font-weight:700;color:var(--muted);flex:0 0 auto;margin-top:3px;}
.cl-item-text{font-size:17px;color:var(--mid-grey);line-height:1.45;}
.cl-item.is-checked .cl-item-text{color:var(--navy);}

.cl-footer-actions{display:flex;align-items:center;gap:24px;margin-top:16px;}

/* Print */
@media print{
  nav,footer,.res-ld-close,.res-hero,.cl-actions-top,.cl-footer-actions,.cl-progress-bar{display:none!important;}
  .cl-tool{padding:0;background:#fff;}
  .res-inner{max-width:100%;}
  .cl-item{border:1px solid #ccc;break-inside:avoid;cursor:default;}
  .cl-header{margin-bottom:24px;}
  .cl-progress-label{display:block;}
  body{font-size:13px;}
  .cl-phase{margin-bottom:32px;}
}
@media(max-width:720px){
  .cl-tool{padding:48px 24px 64px;}
  .cl-header{flex-direction:column;align-items:flex-start;}
}
</style>

<script>
const PHASES = [
  {
    title: "Before you start",
    items: [
      "Programme mandate is documented and approved by the relevant authority.",
      "A clear problem statement has been written before solutions are proposed.",
      "Sponsorship is confirmed at SES Band 1 or equivalent level.",
      "Steering committee membership and terms of reference are agreed.",
      "In-scope and out-of-scope boundaries are documented and signed off.",
      "Interdependencies with other programmes are mapped and owners have been notified.",
      "Staff and union consultation obligations are identified and planned.",
      "Baseline data exists for the metrics you intend to improve.",
      "Procurement obligations (PGPA Act, AusTender) are understood and planned for.",
      "A risk register has been started with initial programme risks identified."
    ]
  },
  {
    title: "During delivery",
    items: [
      "Programme board meets to a set schedule and quorum is consistently maintained.",
      "A decisions log captures all material decisions with rationale.",
      "Monthly reporting goes to the sponsor and key stakeholders on time.",
      "Risks and issues are reviewed and updated at each governance meeting.",
      "A change control process is in place and being used for scope changes.",
      "Staff participation commitments are being honoured alongside BAU responsibilities.",
      "Benefits tracking is active — not deferred to programme end.",
      "Lessons learned are being captured in real time, not retrospectively.",
      "Communications to affected staff are going out on schedule.",
      "Procurement or contract milestones are on track."
    ]
  },
  {
    title: "At close",
    items: [
      "All in-scope deliverables are formally signed off by the sponsor.",
      "Benefits have been quantified and a realisation plan is in place.",
      "Capability has been transferred to the ongoing operational owner.",
      "A post-implementation review is scheduled within 90 days.",
      "Programme documentation is archived to the agency's records management system."
    ]
  }
];

const TOTAL = PHASES.reduce((a, p) => a + p.items.length, 0);
const state = new Array(TOTAL).fill(false);

function globalIdx(phaseIdx, itemIdx) {
  let n = 0;
  for (let i = 0; i < phaseIdx; i++) n += PHASES[i].items.length;
  return n + itemIdx;
}

function updateProgress() {
  const checked = state.filter(Boolean).length;
  document.getElementById("cl-progress-fill").style.width = `${(checked / TOTAL) * 100}%`;
  document.getElementById("cl-progress-label").textContent = `${checked} of ${TOTAL} checked`;

  // Update phase progress counters
  let globalI = 0;
  PHASES.forEach((phase, pi) => {
    const phaseChecked = phase.items.filter((_, ii) => state[globalIdx(pi, ii)]).length;
    const el = document.getElementById(`cl-phase-progress-${pi}`);
    if (el) el.textContent = `${phaseChecked} / ${phase.items.length}`;
    globalI += phase.items.length;
  });
}

function render() {
  const container = document.getElementById("cl-phases");
  container.innerHTML = PHASES.map((phase, pi) => `
    <div class="cl-phase">
      <div class="cl-phase-head">
        <h2 class="cl-phase-title">${phase.title}</h2>
        <span class="cl-phase-progress" id="cl-phase-progress-${pi}">0 / ${phase.items.length}</span>
      </div>
      <ul class="cl-items">
        ${phase.items.map((item, ii) => {
          const gi = globalIdx(pi, ii);
          return `<li class="cl-item${state[gi] ? ' is-checked' : ''}" data-gi="${gi}" role="checkbox" aria-checked="${state[gi]}" tabindex="0">
            <div class="cl-checkbox"><span class="cl-checkmark">&#10003;</span></div>
            <span class="cl-item-num">${gi + 1}.</span>
            <span class="cl-item-text">${item}</span>
          </li>`;
        }).join("")}
      </ul>
    </div>
  `).join("");

  container.querySelectorAll(".cl-item").forEach(el => {
    el.addEventListener("click", () => toggle(parseInt(el.dataset.gi)));
    el.addEventListener("keydown", (e) => { if (e.key === " " || e.key === "Enter") { e.preventDefault(); toggle(parseInt(el.dataset.gi)); } });
  });

  updateProgress();
}

function toggle(gi) {
  state[gi] = !state[gi];
  const el = document.querySelector(`[data-gi="${gi}"]`);
  if (el) {
    el.classList.toggle("is-checked", state[gi]);
    el.setAttribute("aria-checked", state[gi]);
    el.querySelector(".cl-checkmark").style.display = state[gi] ? "block" : "none";
    el.querySelector(".cl-checkbox").style.background = state[gi] ? "var(--navy)" : "";
    el.querySelector(".cl-checkbox").style.borderColor = state[gi] ? "var(--navy)" : "";
  }
  updateProgress();
}

document.getElementById("cl-download-btn").addEventListener("click", () => window.print());
document.getElementById("cl-download-btn-2").addEventListener("click", () => window.print());
document.getElementById("cl-reset-btn").addEventListener("click", () => {
  state.fill(false);
  render();
});

render();
</script>
