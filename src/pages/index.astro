<script is:inline>
const toggle = document.querySelector(".nav-toggle");
const links = document.getElementById("nav-links");
const pathwaySvg = document.querySelector(".pathway-svg");
const pathwayLabel = document.getElementById("pathway-label");
const pathwayPointer = document.getElementById("pathway-pointer");
const stations = Array.from(document.querySelectorAll(".station"));
const flagship = document.querySelector(".flagship");
let flagshipFrame = null;
let flagshipExpanded = false;
let activeStation = stations.find((station) => station.dataset.key === "FRAME") || stations[0];

toggle.addEventListener("click", () => {
  const expanded = toggle.getAttribute("aria-expanded") === "true";
  toggle.setAttribute("aria-expanded", String(!expanded));
  links.classList.toggle("is-open");
  document.body.classList.toggle("nav-open");
});

function mixChannel(start, end, amount) {
  return Math.round(start + (end - start) * amount);
}

function mixColour(start, end, amount) {
  return `rgb(${mixChannel(start[0], end[0], amount)}, ${mixChannel(start[1], end[1], amount)}, ${mixChannel(start[2], end[2], amount)})`;
}

function clamp(value, min, max) {
  return Math.min(max, Math.max(min, value));
}

function setPathwayLabel(station) {
  if (station && pathwayLabel && pathwayPointer) {
    const x = Number(station.dataset.x);
    const y = Number(station.dataset.y);
    const labelX = Math.min(910, Math.max(130, x));
    const labelY = Math.max(24, y - 76);
    pathwayLabel.textContent = station.dataset.label;
    pathwayLabel.setAttribute("x", labelX);
    pathwayLabel.setAttribute("y", labelY);
    pathwayPointer.setAttribute("d", `M${labelX} ${labelY + 10} L${x} ${y - 22}`);
  }
}

function selectStation(station) {
  if (!station) return;
  activeStation = station;
  setPathwayLabel(activeStation);
  renderStations();
}

function renderStations(pointer) {
  const navy = [38, 36, 92];
  const terracotta = [193, 95, 60];
  const pale = [255, 247, 243];

  stations.forEach((station) => {
    const ring = station.querySelector(".station-ring");
    const core = station.querySelector(".station-core");
    const x = Number(station.dataset.x);
    const y = Number(station.dataset.y);
    const selected = station === activeStation;
    const distance = pointer ? Math.hypot(pointer.x - x, pointer.y - y) : 999;
    const proximity = selected ? 1 : Math.max(0, 1 - distance / 150);
    const r = selected ? 11 : 8 + proximity * 5;
    const stroke = selected ? "rgb(193, 95, 60)" : mixColour(navy, terracotta, proximity);
    const fill = selected ? "rgb(193, 95, 60)" : mixColour([255, 255, 255], pale, proximity);

    ring.setAttribute("r", r.toFixed(2));
    ring.setAttribute("stroke", stroke);
    ring.setAttribute("fill", fill);
    ring.setAttribute("stroke-width", selected ? "2.6" : (2 + proximity * 0.6).toFixed(2));
    core.setAttribute("r", selected ? "4" : (proximity * 2.8).toFixed(2));
    core.setAttribute("fill", selected ? "#fff" : mixColour([255, 255, 255], terracotta, proximity));
  });
}

function svgPointFromEvent(event) {
  const point = pathwaySvg.createSVGPoint();
  point.x = event.clientX;
  point.y = event.clientY;
  return point.matrixTransform(pathwaySvg.getScreenCTM().inverse());
}

if (pathwaySvg && stations.length) {
  setPathwayLabel(activeStation);
  renderStations();

  pathwaySvg.addEventListener("mousemove", (event) => {
    const pointer = svgPointFromEvent(event);
    renderStations(pointer);
  });

  pathwaySvg.addEventListener("mouseleave", () => {
    renderStations();
    setPathwayLabel(activeStation);
  });

  stations.forEach((station) => {
    station.addEventListener("mouseenter", () => selectStation(station));
    station.addEventListener("click", () => {
      selectStation(station);
    });
    station.addEventListener("focus", () => selectStation(station));
    station.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        selectStation(station);
      }
    });
  });
}

function updateFlagshipState() {
  if (!flagship) return;

  const rect = flagship.getBoundingClientRect();
  const visible = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
  const coverage = clamp(visible / window.innerHeight, 0, 1);

  if (!flagshipExpanded && coverage >= 0.32) {
    flagshipExpanded = true;
    flagship.classList.add("is-expanded");
  } else if (flagshipExpanded && coverage < 0.28) {
    flagshipExpanded = false;
    flagship.classList.remove("is-expanded");
  }
}

function scheduleFlagshipUpdate() {
  if (flagshipFrame) return;
  flagshipFrame = window.requestAnimationFrame(() => {
    flagshipFrame = null;
    updateFlagshipState();
  });
}

if (flagship) {
  updateFlagshipState();
  window.addEventListener("scroll", scheduleFlagshipUpdate, { passive:true });
  window.addEventListener("resize", scheduleFlagshipUpdate);
}
</script>
