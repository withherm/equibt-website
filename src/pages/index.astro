---
import Footer from "../components/Footer.astro";
import Icon from "../components/icons/Icon.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import "../styles/home.css";
---

<Layout
  title="EQUIBT | Operational capability advisory"
  description="EQUIBT helps leaders simplify complex operating work and make capability stick."
>
  <Nav />
<main>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <div class="eyebrow">OPERATIONAL CAPABILITY ADVISORY</div>
        <h1>
          Build improvement that holds after we leave.
        </h1>
        <p class="hero-subhead">We embed inside your operations, build capability in your team, and exit when the work is yours. Six services, from first diagnosis to embedded capability.</p>
        <div class="hero-actions">
          <a href="/capability-statement/" class="btn-text"><span class="link-label">View capability statement</span> <span class="ar">&rsaquo;</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span data-hero-icon><Icon name="hero-home" /></span>
      </div>
    </div>
  </section>

  <section class="section beige">
    <div class="section-inner">
      <div class="section-head">
        <div class="eyebrow">THE EQUIBT DIFFERENCE</div>
        <h2 class="section-title">We build capability, not dependency.</h2>
        <p class="section-intro">The work is only finished when your team can run it without us.</p>
      </div>
      <div class="statement-rows">
        <div class="statement-row">
          <h3>We embed inside your operations.</h3>
          <p>Most consultants parachute in and hand over a document. We sit in your workshops, work through your data, and stay until your team can run the process without us.</p>
        </div>
        <div class="statement-row">
          <h3>We build your team's capability.</h3>
          <p>The engagement succeeds or fails based on what your people can do when we leave. Training is not an add-on, it is the centre of the work.</p>
        </div>
        <div class="statement-row">
          <h3>We exit when the work is yours.</h3>
          <p>A successful engagement means less of us over time, not more. The project outcome is an operation that runs independently.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section white">
    <div class="section-inner">
      <div class="section-head">
        <div class="eyebrow">HOW WE HELP</div>
        <h2 class="section-title">Six services. One focus: capability that holds.</h2>
        <p class="section-intro">Each service can stand alone, but the system is strongest when evidence, capability and control build together.</p>
      </div>
      <div class="svc-list">
        <a href="/services/frame/" class="svc-row">
          <span class="svc-icon" aria-hidden="true"><Icon name="frame" /></span>
          <span class="svc-body">
            <span class="svc-kicker">FRAME · DEFINE</span>
            <h3>Problem Framing.</h3>
            <p>Align on the real problem before anything else moves.</p>
            <span class="btn-text"><span class="link-label">Explore FRAME</span> <span class="ar">&rsaquo;</span></span>
          </span>
        </a>
        <a href="/services/plan/" class="svc-row">
          <span class="svc-icon" aria-hidden="true"><Icon name="plan" /></span>
          <span class="svc-body">
            <span class="svc-kicker">PLAN · MEASURE</span>
            <h3>Operations Diagnostic.</h3>
            <p>See the full picture before you act.</p>
            <span class="btn-text"><span class="link-label">Explore PLAN</span> <span class="ar">&rsaquo;</span></span>
          </span>
        </a>
        <a href="/services/solve/" class="svc-row">
          <span class="svc-icon" aria-hidden="true"><Icon name="solve" /></span>
          <span class="svc-body">
            <span class="svc-kicker">SOLVE · ANALYSE</span>
            <h3>Iterative Improvement.</h3>
            <p>Root cause analysis, solution design, and the capability to keep improving independently.</p>
            <span class="btn-text"><span class="link-label">Explore SOLVE</span> <span class="ar">&rsaquo;</span></span>
          </span>
        </a>
        <a href="/services/evolve/" class="svc-row">
          <span class="svc-icon" aria-hidden="true"><Icon name="evolve" /></span>
          <span class="svc-body">
            <span class="svc-kicker">EVOLVE · IMPROVE</span>
            <h3>Rapid Pilot.</h3>
            <p>Validate the future state before you commit.</p>
            <span class="btn-text"><span class="link-label">Explore EVOLVE</span> <span class="ar">&rsaquo;</span></span>
          </span>
        </a>
        <a href="/services/govern/" class="svc-row">
          <span class="svc-icon" aria-hidden="true"><Icon name="govern" /></span>
          <span class="svc-body">
            <span class="svc-kicker">GOVERN · CONTROL</span>
            <h3>Architecture &amp; Governance.</h3>
            <p>Build the infrastructure that prevents drift.</p>
            <span class="btn-text"><span class="link-label">Explore GOVERN</span> <span class="ar">&rsaquo;</span></span>
          </span>
        </a>
        <a href="/services/scale/" class="svc-row">
          <span class="svc-icon" aria-hidden="true"><Icon name="scale" /></span>
          <span class="svc-body">
            <span class="svc-kicker">SCALE · OPERATE</span>
            <h3>Operational Embedding.</h3>
            <p>Scale the proven solution and make it self-sustaining.</p>
            <span class="btn-text"><span class="link-label">Explore SCALE</span> <span class="ar">&rsaquo;</span></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section beige">
    <div class="section-inner">
      <div class="section-head">
        <div class="eyebrow">THE WORK</div>
        <h2 class="section-title">Operational gains that stay visible after the project ends.</h2>
      </div>
      <div class="evidence">
        <div class="ev-row">
          <p class="ev-act">Simplified the loan approval process. Approval time fell <span class="m">9 to 4 days</span>.</p>
          <p class="ev-sec">Retail bank · Financial Services · Illustrative</p>
        </div>
        <div class="ev-row">
          <p class="ev-act">Cut scrap at the source. Scrap rate dropped <span class="m">6% to 2%</span>.</p>
          <p class="ev-sec">Precision manufacturer · Advanced Manufacturing · Illustrative</p>
        </div>
        <div class="ev-row">
          <p class="ev-act">Cleared the assessment backlog across claims teams. Throughput rose <span class="m">320 to 540 a week</span>.</p>
          <p class="ev-sec">Federal agency · Government and Public Sector · Illustrative</p>
        </div>
      </div>
      <div class="flagship">
        <div class="flagship-copy">
          <div class="eyebrow light">OUR WORK · FLAGSHIP</div>
          <h3>Redesigned customer retention across five call-centre partners.</h3>
          <p class="flag-copy">Churn was high and each partner ran its own retention method with no shared data. We mapped the end-to-end process, fixed the failure points, and handed the teams a model they now run without us.</p>
          <div class="flag-metric"><strong>18% to 24%</strong><span>retention save rate</span></div>
          <a href="/our-work/" class="flag-link"><span class="link-label">Read the case</span> <span class="ar">&rsaquo;</span></a>
        </div>
        <div class="flagship-media" aria-hidden="true">
          <img src="/assets/flagship-mesh-placeholder.svg" alt="">
        </div>
      </div>
    </div>
  </section>

  <section class="section white">
    <div class="section-inner">
      <div class="logo-strip">
        <div class="eyebrow">CLIENTS</div>
        <h2>Worked across complex, regulated operating environments.</h2>
        <div class="logo-marks" aria-label="Selected client logos">
          <img class="client-logo" src="/assets/logos/clients/logo-01.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-02.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-03.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-04.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-05.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-06.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-07.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-08.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-09.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-10.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-11.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-12.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-13.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-14.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-15.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-16.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-17.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-18.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-19.svg" alt="" loading="lazy">
          <img class="client-logo" src="/assets/logos/clients/logo-20.svg" alt="" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <section class="section beige">
    <div class="section-inner">
      <div class="section-head">
        <div class="eyebrow">INDUSTRIES WE SERVE</div>
        <h2 class="section-title">Built for complex, regulated operations.</h2>
        <p class="section-intro">The work suits environments where throughput, controls, evidence and capability all matter at once.</p>
      </div>
      <div class="industry-list">
        <article class="ind-row">
          <span class="ic" aria-hidden="true"><Icon name="financial-services" /></span>
          <div>
            <h3>Financial Services.</h3>
            <p class="hook">Fix the process, not the symptom.</p>
            <p>Tight margins and high regulatory compliance. We work with retail banks, investment advisers, and insurance providers to simplify operations and reduce risk simultaneously.</p>
            <a href="/industries/financial-services/" class="btn-text"><span class="link-label">Financial services</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
        <article class="ind-row">
          <span class="ic" aria-hidden="true"><Icon name="government" /></span>
          <div>
            <h3>Government and Public Sector.</h3>
            <p class="hook">Make delivery reliable under constraint.</p>
            <p>Service delivery balanced with budget constraint and procedural rigour. We help departments streamline investigation cycles, reduce rework, and build capability.</p>
            <a href="/industries/government/" class="btn-text"><span class="link-label">Government</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
        <article class="ind-row">
          <span class="ic" aria-hidden="true"><Icon name="utilities" /></span>
          <div>
            <h3>Utilities.</h3>
            <p class="hook">Stabilise service under load.</p>
            <p>Critical services under regulatory requirement. Process consistency and safety are non-negotiable.</p>
            <a href="/industries/utilities/" class="btn-text"><span class="link-label">Utilities</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
        <article class="ind-row">
          <span class="ic" aria-hidden="true"><Icon name="manufacturing" /></span>
          <div>
            <h3>Advanced Manufacturing.</h3>
            <p class="hook">Reduce waste at the source.</p>
            <p>Precision, throughput, and quality under tight tolerances. We help manufacturers cut waste, stabilise processes, and build improvement capability on the floor.</p>
            <a href="/industries/manufacturing/" class="btn-text"><span class="link-label">Advanced manufacturing</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section white">
    <div class="section-inner">
      <div class="section-head">
        <div class="eyebrow">OUR WORK</div>
        <h2 class="section-title">Proven in practice.</h2>
        <p class="section-intro">Problem, approach and outcome stay visible, without dressing anonymised work as a marketing claim.</p>
      </div>
      <div class="case-list">
        <article class="case">
          <div>
            <div class="case-sector">Energy retailer</div>
            <div class="case-number">18% to 24%</div>
            <div class="case-caption">retention save rate</div>
          </div>
          <div>
            <h3>Redesigned the customer retention process.</h3>
            <div class="case-block"><p class="case-label">Problem</p><p>High churn across the residential customer base. Third-party call centres were operating without data integration or a consistent retention method, and each centre was running its own approach with little visibility of outcomes.</p></div>
            <div class="case-block"><p class="case-label">Approach</p><p>Mapped the end-to-end retention process across the call-centre partners, identified the failure points driving churn, and redesigned the process with the retention teams.</p></div>
            <div class="case-block"><p class="case-label">Outcome</p><p>The retention model now runs independently across partner teams without external support.</p></div>
            <a href="/our-work/" class="btn-text"><span class="link-label">View our work</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
        <article class="case">
          <div>
            <div class="case-sector">Utilities ombudsman</div>
            <div class="case-number">52 to 31 days</div>
            <div class="case-caption">investigation cycle time</div>
          </div>
          <div>
            <h3>Standardised the investigation process across teams.</h3>
            <div class="case-block"><p class="case-label">Problem</p><p>Five investigation teams were each running a different variant of the complaints process. A large backlog was building, resolution times varied by team, and the variation was creating compliance exposure.</p></div>
            <div class="case-block"><p class="case-label">Approach</p><p>Mapped the existing process across all five teams, identified variation points and root causes, and worked with investigators to redesign one standard process.</p></div>
            <div class="case-block"><p class="case-label">Outcome</p><p>All teams now operate from a single consistent investigation process with independent improvement capability.</p></div>
            <a href="/our-work/" class="btn-text"><span class="link-label">View our work</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section beige pathway">
    <div class="section-inner">
      <div class="section-head">
        <div class="eyebrow">WHERE IT LEADS</div>
        <h2 class="section-title">You don't start all six at once.</h2>
        <p class="section-intro">The path is not a forced programme. It is a way to find the right starting point, then build only what the operation can sustain.</p>
      </div>
      <div class="pathway-box">
        <svg class="pathway-svg" viewBox="0 0 1040 150" role="img" aria-label="FRAME to SCALE progression">
          <g class="station-callout">
            <text id="pathway-label" class="pathway-label" x="70" y="24" text-anchor="middle">DEFINE THE REAL PROBLEM</text>
            <path id="pathway-pointer" class="pathway-pointer" d="M70 34 L70 78"/>
          </g>
          <path class="hd-f2" d="M70 100 Q300 90 520 99 Q760 109 970 98"/>
          <g class="station is-active" tabindex="0" data-key="FRAME" data-x="70" data-y="100" data-label="DEFINE THE REAL PROBLEM">
            <circle class="station-hit" cx="70" cy="100" r="34"/>
            <circle class="station-ring" cx="70" cy="100" r="11" fill="#C15F3C" stroke="#C15F3C" stroke-width="2.6"/>
            <circle class="station-core" cx="70" cy="100" r="4" fill="#fff"/>
            <text x="70" y="138" fill="#26245C" font-family="Montserrat,sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">FRAME</text>
          </g>
          <g class="station" tabindex="0" data-key="PLAN" data-x="250" data-y="97" data-label="DIAGNOSE HOW IT RUNS">
            <circle class="station-hit" cx="250" cy="97" r="34"/>
            <circle class="station-ring" cx="250" cy="97" r="8" fill="#fff" stroke="#26245C" stroke-width="2"/>
            <circle class="station-core" cx="250" cy="97" r="0" fill="#fff"/>
            <text x="250" y="138" fill="#26245C" font-family="Montserrat,sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">PLAN</text>
          </g>
          <g class="station" tabindex="0" data-key="SOLVE" data-x="430" data-y="99" data-label="FIX THE ROOT CAUSES">
            <circle class="station-hit" cx="430" cy="99" r="34"/>
            <circle class="station-ring" cx="430" cy="99" r="8" fill="#fff" stroke="#26245C" stroke-width="2"/>
            <circle class="station-core" cx="430" cy="99" r="0" fill="#fff"/>
            <text x="430" y="138" fill="#26245C" font-family="Montserrat,sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">SOLVE</text>
          </g>
          <g class="station" tabindex="0" data-key="EVOLVE" data-x="610" data-y="101" data-label="PROVE IT WITH A PILOT">
            <circle class="station-hit" cx="610" cy="101" r="34"/>
            <circle class="station-ring" cx="610" cy="101" r="8" fill="#fff" stroke="#26245C" stroke-width="2"/>
            <circle class="station-core" cx="610" cy="101" r="0" fill="#fff"/>
            <text x="610" y="138" fill="#26245C" font-family="Montserrat,sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">EVOLVE</text>
          </g>
          <g class="station" tabindex="0" data-key="GOVERN" data-x="790" data-y="98" data-label="LOCK IN THE CONTROLS">
            <circle class="station-hit" cx="790" cy="98" r="34"/>
            <circle class="station-ring" cx="790" cy="98" r="8" fill="#fff" stroke="#26245C" stroke-width="2"/>
            <circle class="station-core" cx="790" cy="98" r="0" fill="#fff"/>
            <text x="790" y="138" fill="#26245C" font-family="Montserrat,sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">GOVERN</text>
          </g>
          <g class="station" tabindex="0" data-key="SCALE" data-x="970" data-y="98" data-label="EMBED THE NEW STANDARD">
            <circle class="station-hit" cx="970" cy="98" r="34"/>
            <circle class="station-ring" cx="970" cy="98" r="8" fill="#fff" stroke="#26245C" stroke-width="2"/>
            <circle class="station-core" cx="970" cy="98" r="0" fill="#fff"/>
            <text x="970" y="138" fill="#26245C" font-family="Montserrat,sans-serif" font-size="13" font-weight="700" letter-spacing="1.2" text-anchor="middle">SCALE</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section white lmi-handover">
    <div class="section-inner training-inner">
      <div class="eyebrow">TRAINING</div>
      <h2 class="section-title">Need to build the skills in-house?</h2>
      <p class="training-copy">Lean Methods Institute is our specialist training division. If your team needs Lean and AI capability built through structured courses rather than an advisory engagement, that is where to start.</p>
      <a href="https://leanmethods.com.au" aria-label="Lean Methods Institute" class="lmi-logo-link">
      <svg class="lmi-logo" viewBox="0 0 1700 440" role="img" aria-label="Lean Methods Institute" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(2.03985 -1.676)">
          <g transform="translate(491.278 116.5003)"><path class="lmi-logo-fill" d="M0 113.663 0-.854 24.922-.854 24.922 92.026 79.071 92.026 78.699 114.517 0 113.663Z"/></g>
          <g transform="translate(616.5521 212.1266)"><path class="lmi-logo-fill" d="M0-51.964C-10.453-51.964-18.245-45.45-20.335-34.966L-20.587-33.688 20.445-33.688 20.187-34.966C18.073-45.45 10.336-51.964 0-51.964M2.937 19.333C-24.937 19.333-44.403.701-44.403-25.982-44.403-52.241-25.792-71.297-.154-71.297 25.263-71.297 43.017-52.529 43.017-25.656 43.017-24.249 42.863-22.498 42.722-20.801L42.556-18.767-20.292-18.767-19.923-17.415C-17.164-7.233-8.382-1.149 3.552-1.149 12.088-1.149 18.516-3.761 24.384-9.611L37.179 5.089 37.148 5.125C29.344 14.552 17.834 19.333 2.937 19.333"/></g>
          <g transform="translate(702.3645 178.9303)"><path class="lmi-logo-fill" d="M0 14.429C-9.863 14.429-14.859 17.889-14.859 24.71-14.859 31.255-9.642 35.317-1.235 35.317 7.362 35.317 13.821 31.033 16.488 23.567L16.549 14.429 0 14.429ZM-7.258 52.53C-25.786 52.53-38.236 41.806-38.236 25.853-38.236 8.868-25.589-.492-2.624-.492L16.574-.492 16.531-1.604C16.107-12.192 9.482-17.784-2.624-17.784-11.369-17.784-20.519-14.675-26.523-9.654L-35.163-27.469-35.139-27.488C-26.332-34.131-12.966-38.101.615-38.101 26.738-38.101 40.546-24.581 40.546 1.002L40.546 51.221 18.098 51.221 18.098 40.571 16.18 43.041C11.375 49.248 3.269 52.53-7.258 52.53"/></g>
          <g transform="translate(814.5032 140.83)"><path class="lmi-logo-fill" d="M0 89.321 0 42.863C0 25.718-9.169 22.116-16.863 22.116-29.54 22.116-36.81 30.751-36.81 45.806L-36.81 89.321-60.801 89.321-60.801 1.309-37.892 1.309-37.892 11.534-36.073 9.74C-29.694 3.459-20.574 0-10.379 0 11.147 0 23.997 14.558 23.997 38.936L23.997 89.321 0 89.321Z"/></g>
          <g transform="translate(973.3519 115.646)"><path class="lmi-logo-fill" d="M0 114.505-.154 45.678-32.035 102.405-43.213 102.405-74.935 47.153-74.935 114.505-98.312 114.505-98.312 0-77.713 0-37.24 71.206 2.618 0 23.063 0 23.37 114.505 0 114.505Z"/></g>
