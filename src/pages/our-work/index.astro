---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Icon from "../../components/icons/Icon.astro";
import lmiLogo from "../../../brand/assets/logos/lmi/LMI-LOGO-702_MAIN-R1_TRANSPARENT.svg";
import "../../styles/our-work.css";

const allCases = await getCollection("cases", ({ data }) => !data.draft);

// Pillar phrasing (monochrome dotted eyebrow) + section sub-line + line-art icon, in fixed display order.
const pillarGroups = [
  { pillar: "FRAME", icon: "frame", eyebrow: "FRAME · DEFINE", intro: "Framing that aligns the team on the real problem before anything moves." },
  { pillar: "PLAN", icon: "plan", eyebrow: "PLAN · MEASURE", intro: "Diagnostics that find where the time and cost actually go." },
  { pillar: "SOLVE", icon: "solve", eyebrow: "SOLVE · ANALYSE", intro: "Root-cause redesign that cuts rework and cycle time." },
  { pillar: "EVOLVE", icon: "evolve", eyebrow: "EVOLVE · IMPROVE", intro: "Piloted changes that lift performance and stay in place." },
  { pillar: "GOVERN", icon: "govern", eyebrow: "GOVERN · CONTROL", intro: "Operating models and frameworks the team owns and runs." },
  { pillar: "SCALE", icon: "scale", eyebrow: "SCALE · OPERATE", intro: "Standards embedded so the new way of working scales without us." },
] as const;

const groups = pillarGroups
  .map((group) => ({
    ...group,
    cases: allCases
      .filter((entry) => entry.data.pillar === group.pillar)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((group) => group.cases.length > 0);
---

<Layout
  title="Our Work | EQUIBT"
  description="Operations problems, redesigned with the teams who own them. Anonymised engagements across financial services, government, utilities, and manufacturing."
>
  <Nav />
  <main>
    <section class="ow-hero ow-reveal">
      <div class="ow-hero-inner">
        <div class="ow-hero-copy">
          <div class="eyebrow">OUR WORK</div>
          <h1>See it proven in practice.</h1>
          <p class="ow-hero-lede">Operations problems, redesigned with the teams who own them. Every result below was built to run without us.</p>
          <p class="ow-hero-lede muted">Anonymised engagements across financial services, government, utilities and manufacturing, each naming the problem, what the team changed, and the result they now run themselves.</p>

        </div>
        <div class="ow-hero-art" aria-hidden="true">
          <span data-hero-icon><Icon name="hero-our-work" /></span>
        </div>
      </div>
      <div class="ow-inner">
        <div class="ow-filter" role="group" aria-label="Filter by service area">
          <button class="ow-chip is-active" type="button" data-filter="all">All</button>
          {pillarGroups.map((g) => (
            <button class="ow-chip" type="button" data-filter={g.pillar.toLowerCase()}>{g.pillar}</button>
          ))}
        </div>
      </div>
    </section>

    {groups.map((group, index) => (
      <section class:list={["ow-section", index % 2 === 0 ? "beige" : "white", "ow-reveal"]} data-pillar={group.pillar.toLowerCase()}>
        <div class="ow-inner">
          <div class="ow-group-head">
            <span class="ow-group-icon" aria-hidden="true"><Icon name={group.icon} /></span>
            <div>
              <div class="eyebrow">{group.eyebrow}</div>
              <p class="ow-pillar-intro">{group.intro}</p>
            </div>
          </div>
          <div class="ow-case-list">
            {group.cases.map((entry) => {
              const c = entry.data;
              return (
                <article class="ow-case">
                  <div class="ow-case-sector">{c.sector}</div>
                  <div class="ow-case-metric">{c.metric}</div>
                  <h3>{c.title}</h3>
                  <p class="ow-case-context">{c.problem}</p>
                  {c.fullStudy && (
                    <a href={`/our-work/${entry.id}/`} class="btn-text"><span class="link-label">Full case study</span> <span class="ar">&rsaquo;</span></a>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      </section>
    ))}

    <section class:list={["ow-section", groups.length % 2 === 0 ? "beige" : "white", "ow-reveal"]}>
      <div class="ow-inner ow-cta-grid">
        <div class="ow-cta-copy">
          <div class="eyebrow">WORK WITH US</div>
          <h2>Start with the problem that won't stay fixed.</h2>
          <p>Tell us where the operation is under strain. We will tell you straight whether it is a fixable process gap, and whether we are the right firm for it.</p>
          <a href="/contact/" class="btn-primary">Get in touch</a>
        </div>
        <div class="ow-cta-art" aria-hidden="true">
          <span><Icon name="hero-motif" /></span>
        </div>
      </div>
    </section>

    <section class="ow-section beige ow-lmi ow-reveal">
      <div class="ow-inner">
        <div class="eyebrow">TRAINING</div>
        <h2 class="ow-lmi-title">Build the capability your operation runs on.</h2>
        <p class="ow-lmi-copy">Lean Methods Institute contextualises our training to your operations context — not generic case studies or simulations. Your team learns the methods behind this work so the capability stays with them.</p>
        <a href="https://leanmethods.com.au" class="ow-lmi-logo-link" aria-label="Lean Methods Institute">
          <img src={lmiLogo.src} class="ow-lmi-logo-img" alt="Lean Methods Institute" loading="lazy" />
        </a>
        <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initialiseOwFilter() {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.ow-chip'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.ow-section[data-pillar]'));
    if (!chips.length) return;
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter;
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        sections.forEach((section) => {
          const match = filter === 'all' || section.dataset.pillar === filter;
          section.classList.toggle('is-hidden', !match);
        });
      });
    });
  }

  function initialiseOwReveals() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".ow-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("ow-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.16 });
    sections.forEach((section) => observer.observe(section));
  }

  initialiseOwFilter();
  initialiseOwReveals();
</script>
