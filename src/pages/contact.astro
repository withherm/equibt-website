---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Dialogue from "../components/icons/glyphs/Dialogue.astro";
import "../styles/contact.css";

const mapQuery = encodeURIComponent("Level 15, 470 Collins Street, Melbourne VIC 3000, Australia");
---

<Layout
  title="Contact EQUIBT | Start with a 15-minute conversation"
  description="Tell EQUIBT about an operational problem in Australia or New Zealand. Send the problem, not a polished brief: a plain description of the operational issue is enough to start."
>
  <Nav />
  <main>
    <!-- 1. HERO (small) -->
    <section class="cx-hero compact cx-reveal">
      <div class="cx-hero-inner">
        <div class="cx-hero-content">
          <div class="eyebrow">CONTACT</div>
          <h1>Start with a 15-minute conversation.</h1>
          <p class="cx-hero-subhead">It is enough to tell you whether EQUIBT is the right fit for your operation. No obligation.</p>
        </div>
        <div class="cx-hero-art glyph" aria-hidden="true">
          <!-- hero art: firm motif at hero scale, fine-line interim — page hero scene swaps in here later (artwork-authority, EQT-274/275) -->
          <Dialogue />
        </div>
      </div>
    </section>

    <!-- 2. THE FORM (right after the hero; v6x hairline inputs; mailto interim, no live handler this issue) -->
    <section class="cx-section beige cx-reveal" id="contact-form">
      <div class="cx-inner">
        <div class="cx-head">
          <div class="eyebrow">GET IN TOUCH</div>
          <h2 class="cx-title">Tell us what is under strain.</h2>
          <p>Share enough context for us to understand the strain point and decide whether a conversation is useful.</p>
        </div>
        <form class="cx-form" action="mailto:hello@equibt.com" method="post" enctype="text/plain">
          <div class="cx-form-row">
            <div class="cx-field">
              <label for="first-name">First name <span class="cx-req" aria-hidden="true">*</span></label>
              <input id="first-name" name="first_name" type="text" autocomplete="given-name" required />
            </div>
            <div class="cx-field">
              <label for="last-name">Last name <span class="cx-req" aria-hidden="true">*</span></label>
              <input id="last-name" name="last_name" type="text" autocomplete="family-name" required />
            </div>
          </div>
          <div class="cx-form-row">
            <div class="cx-field">
              <label for="email">Email <span class="cx-req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="cx-field">
              <label for="phone">Phone number <span class="cx-opt">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="cx-field">
            <label for="organisation">Organisation <span class="cx-opt">(optional)</span></label>
            <input id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>
          <div class="cx-field">
            <label for="problem">How might we help? <span class="cx-req" aria-hidden="true">*</span></label>
            <textarea id="problem" name="problem" required></textarea>
          </div>
          <div class="cx-field cx-captcha">
            <label for="human-check">Quick check: what is six plus three? <span class="cx-req" aria-hidden="true">*</span></label>
            <input id="human-check" name="human_check" type="text" inputmode="numeric" autocomplete="off" required />
            <p class="cx-field-error" id="human-check-error" hidden>That answer is not right. Try again.</p>
          </div>
          <div class="cx-hp" aria-hidden="true">
            <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="cx-form-actions">
            <button class="btn-primary" type="submit">Get in touch</button>
            <p class="cx-form-note">Prefer email? Write to <a href="mailto:hello@equibt.com">hello@equibt.com</a> directly.</p>
          </div>
          <p class="cx-form-legend"><span class="cx-req">*</span> required</p>
        </form>
      </div>
    </section>

    <!-- 3. WHAT TO EXPECT (facts as hanging-label rows) -->
    <section class="cx-section white cx-reveal">
      <div class="cx-inner">
        <div class="cx-head">
          <div class="eyebrow">WHAT TO EXPECT</div>
          <h2 class="cx-title">The facts before we talk.</h2>
          <p>You should know how we engage before a conversation starts.</p>
        </div>
        <div class="cx-rows">
          <div class="cx-row">
            <p class="cx-row-label">Engagement model</p>
            <p class="cx-row-body">Advisory and capability transfer, not staff augmentation.</p>
          </div>
          <div class="cx-row">
            <p class="cx-row-label">Typical start</p>
            <p class="cx-row-body">Two to three weeks from the first conversation.</p>
          </div>
          <div class="cx-row">
            <p class="cx-row-label">Geography</p>
            <p class="cx-row-body">Australia and New Zealand.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. REACH US (email, LinkedIn, office phone numbers) -->
    <section class="cx-section beige cx-reveal">
      <div class="cx-inner">
        <div class="cx-head">
          <div class="eyebrow">REACH US</div>
          <h2 class="cx-title">Send the problem, not a polished brief.</h2>
          <p>A plain description of the operational issue is enough to start.</p>
        </div>
        <div class="cx-rows">
          <div class="cx-row">
            <p class="cx-row-label">Email</p>
            <p class="cx-row-body"><a href="mailto:hello@equibt.com">hello@equibt.com</a></p>
          </div>
          <div class="cx-row">
            <p class="cx-row-label">Melbourne</p>
            <p class="cx-row-body"><a href="tel:+61390282288">+61 (03) 9028 2288</a></p>
          </div>
          <div class="cx-row">
            <p class="cx-row-label">Sydney</p>
            <p class="cx-row-body"><a href="tel:+61280033022">+61 (02) 8003 3022</a></p>
          </div>
          <div class="cx-row">
            <p class="cx-row-label">LinkedIn</p>
            <p class="cx-row-body"><a href="https://www.linkedin.com/company/equibt/" target="_blank" rel="noopener">EQUIBT <span class="ext">&#8599;</span></a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. VISIT US (map + address) -->
    <section class="cx-section white cx-reveal">
      <div class="cx-inner">
        <div class="cx-head">
          <div class="eyebrow">VISIT US</div>
          <h2 class="cx-title">Find us in the Melbourne CBD.</h2>
        </div>
        <div class="cx-visit-grid">
          <div class="cx-map">
            <iframe
              title="Map showing the EQUIBT office at Level 15, 470 Collins Street, Melbourne"
              src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="cx-address">
            <span class="cx-address-label">Office</span>
            <p>Level 15, 470 Collins Street,<br />Melbourne VIC 3000,<br />Australia</p>
            <a class="btn-text cx-directions" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener"><span class="link-label">Get directions</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    function initialiseContactReveals() {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const sections = Array.from(document.querySelectorAll(".cx-reveal"));
      if (reduceMotion || !("IntersectionObserver" in window)) return;
      document.documentElement.classList.add("cx-reveal-enabled");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16 });
      sections.forEach((section) => observer.observe(section));
    }
    initialiseContactReveals();

    // Lightweight bot gate (interim). Real protection = Cloudflare Turnstile at go-live (EQT-262),
    // which needs server-side verification the static page cannot do yet.
    function initialiseContactGuard() {
      const form = document.querySelector(".cx-form");
      if (!form) return;
      form.addEventListener("submit", (event) => {
        const honeypot = form.querySelector('[name="company_website"]');
        const human = form.querySelector('[name="human_check"]');
        const error = document.getElementById("human-check-error");
        const answer = (human && "value" in human ? String(human.value) : "").trim().toLowerCase();
        const humanOk = answer === "9" || answer === "nine";
        const honeypotTripped = honeypot && "value" in honeypot && String(honeypot.value).length > 0;
        if (honeypotTripped || !humanOk) {
          event.preventDefault();
          if (!humanOk && error) {
            error.hidden = false;
            if (human && "focus" in human) human.focus();
          }
        }
      });
    }
    initialiseContactGuard();
  </script>
</Layout>
