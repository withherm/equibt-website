---
import Footer from "../components/Footer.astro";
import Icon from "../components/icons/Icon.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import "../styles/contact.css";

const mapQuery = encodeURIComponent("Level 15, 470 Collins Street, Melbourne VIC 3000, Australia");
---

<Layout
  title="Contact EQUIBT | Start with a 15-minute conversation"
  description="Tell EQUIBT about an operational problem in Australia. Send the problem, not a polished brief: a plain description of the operational issue is enough to start."
>
  <Nav />
  <main>
    <!-- 1. HERO (small) -->
    <section class="cx-hero compact cx-reveal">
      <div class="cx-hero-inner">
        <div class="cx-hero-content">
          <div class="eyebrow">CONTACT</div>
          <h1>Let us know how we can assist.</h1>
          <p class="cx-hero-subhead">A 15-minute conversation is enough to tell you whether EQUIBT is the right fit for your operation. No obligation.</p>
        </div>
        <div class="cx-hero-art" aria-hidden="true">
          <span data-hero-icon><Icon name="hero-contact" /></span>
        </div>
      </div>
    </section>

    <!-- 2. THE FORM (right after the hero; v6x hairline inputs) -->
    <section class="cx-section beige cx-reveal" id="contact-form">
      <div class="cx-inner">
        <div class="cx-head">
          <div class="eyebrow">GET IN TOUCH</div>
          <h2 class="cx-title">Let's talk about your operation.</h2>
          <p>A plain description of the operational issue or goal is enough to start.</p>
        </div>
        <form class="cx-form" method="post">
          <div class="cx-form-row">
            <div class="cx-field">
              <label for="first-name">First name <span class="cx-req" aria-hidden="true">*</span></label>
              <input id="first-name" name="first_name" type="text" autocomplete="given-name" required />
            </div>
            <div class="cx-field">
              <label for="last-name">Last name <span class="cx-req" aria-hidden="true">*</span></label>
              <input id="last-name" name="last_name" type="text" autocomplete="family-name" required />
            </div>
          </div>
          <div class="cx-form-row">
            <div class="cx-field">
              <label for="email">Email <span class="cx-req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="cx-field">
              <label for="phone">Phone number <span class="cx-opt">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="cx-field">
            <label for="organisation">Organisation <span class="cx-opt">(optional)</span></label>
            <input id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>
          <div class="cx-field">
            <label for="problem">How might we help? <span class="cx-req" aria-hidden="true">*</span></label>
            <textarea id="problem" name="problem" required></textarea>
          </div>
          <div class="cx-field cx-captcha">
            <span class="cx-captcha-label">Verification <span class="cx-req" aria-hidden="true">*</span></span>
            <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-theme="light"></div>
            <p class="cx-field-error" id="captcha-error" hidden>Please complete the verification.</p>
          </div>
          <div class="cx-hp" aria-hidden="true">
            <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="cx-form-actions">
            <button class="btn-primary" type="submit">Get in touch</button>
            <p class="cx-form-note">Prefer email? Write to <a href="mailto:hello@equibt.com">hello@equibt.com</a> directly.</p>
          </div>
          <p class="cx-field-error" id="contact-error" hidden>Something went wrong, please email <a href="mailto:hello@equibt.com">hello@equibt.com</a>.</p>
          <p class="cx-form-legend"><span class="cx-req">*</span> required</p>
        </form>
        <p class="cx-form-note" id="contact-success" role="status" hidden>Thanks, we'll be in touch.</p>
      </div>
    </section>

    <!-- 3. REACH US (monochrome map left, contact details right) -->
    <section class="cx-section white cx-reveal">
      <div class="cx-inner">
        <div class="cx-head">
          <div class="eyebrow">REACH US</div>
          <h2 class="cx-title">Reach us directly.</h2>
        </div>
        <div class="cx-reach-grid">
          <div class="cx-map">
            <iframe
              title="Map showing the EQUIBT office at Level 15, 470 Collins Street, Melbourne"
              src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="cx-reach-details">
            <div class="cx-contact-row">
              <p class="cx-contact-label">Email</p>
              <p class="cx-contact-val"><a href="mailto:hello@equibt.com">hello@equibt.com</a></p>
            </div>
            <div class="cx-contact-row">
              <p class="cx-contact-label">Melbourne</p>
              <p class="cx-contact-val"><a href="tel:+61390282288">+61 (03) 9028 2288</a></p>
            </div>
            <div class="cx-contact-row">
              <p class="cx-contact-label">Sydney</p>
              <p class="cx-contact-val"><a href="tel:+61280033022">+61 (02) 8003 3022</a></p>
            </div>
            <div class="cx-contact-row">
              <p class="cx-contact-label">LinkedIn</p>
              <p class="cx-contact-val"><a href="https://www.linkedin.com/company/equibt/" target="_blank" rel="noopener">EQUIBT <span class="ext">&#8599;</span></a></p>
            </div>
            <div class="cx-contact-row">
              <p class="cx-contact-label">Office</p>
              <p class="cx-contact-val">
                Level 15, 470 Collins Street,<br />Melbourne VIC 3000, Australia
                <a class="btn-text cx-directions" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener"><span class="link-label">Get directions</span> <span class="ar">&rsaquo;</span></a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <!-- Cloudflare Turnstile loader (auto-renders .cf-turnstile widgets) -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

  <script>
    function initialiseContactReveals() {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const sections = Array.from(document.querySelectorAll(".cx-reveal"));
      if (reduceMotion || !("IntersectionObserver" in window)) return;
      document.documentElement.classList.add("cx-reveal-enabled");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16 });
      sections.forEach((section) => observer.observe(section));
    }
    initialiseContactReveals();

    function initialiseContactGuard() {
      const form = document.querySelector(".cx-form");
      if (!form) return;
      const captchaError = document.getElementById("captcha-error");
      const contactError = document.getElementById("contact-error");
      const success = document.getElementById("contact-success");
      const submit = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (captchaError) captchaError.hidden = true;
        if (contactError) contactError.hidden = true;

        const honeypot = form.querySelector('[name="company_website"]');
        const token = form.querySelector('[name="cf-turnstile-response"]');
        const tokenOk = token && "value" in token && String(token.value).length > 0;
        const honeypotTripped = honeypot && "value" in honeypot && String(honeypot.value).length > 0;
        if (honeypotTripped) return;
        if (!tokenOk) {
          if (captchaError) captchaError.hidden = false;
          return;
        }

        if (submit) submit.setAttribute("disabled", "true");

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            body: new FormData(form),
          });
          const result = await response.json().catch(() => null);

          if (response.ok && result && result.ok === true) {
            form.hidden = true;
            if (success) success.hidden = false;
            return;
          }

          if (contactError) contactError.hidden = false;
          window.turnstile?.reset();
        } catch {
          if (contactError) contactError.hidden = false;
          window.turnstile?.reset();
        } finally {
          if (!form.hidden && submit) submit.removeAttribute("disabled");
        }
      });
    }
    initialiseContactGuard();
  </script>
</Layout>
