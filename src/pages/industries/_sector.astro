    ctaTitle: "Get more out of the line you already run.",
    ctaBody: "Tell us where throughput or quality is leaking. We will tell you whether there is a process fix worth scoping.",
    lmiPhrase: "advanced manufacturing operations",
  },
} as const;

type SectorKey = keyof typeof sectors;
const { sector } = Astro.props as { sector: SectorKey };
const data = sectors[sector];
const initialService = data.services.frame;
---

<Layout title={data.title} description={data.description}>
  <Nav />
  <main>
    <section class="industry-hero industry-reveal">
      <div class="industry-hero-inner">
        <div>
          <div class="eyebrow">{data.sectorName}</div>
          <h1>{data.heroTitle}</h1>
          <p class="industry-hero-subhead">{data.heroSubhead}</p>
          <p class="industry-hero-body">{data.heroBody}</p>
          <div class="industry-actions">
            <a href="/industries/" class="btn-text"><span class="link-label">View all industries</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
        <div class="industry-hero-art" aria-hidden="true">
          <!-- hero art: sector icon at hero scale, fine-line interim. Per-sector hero scene swaps in here later (EQT-275). -->
          <span data-hero-icon><Icon name={data.icon} /></span>
        </div>
      </div>
    </section>

    <div class="subnav-pin-scope">
    <nav class="sector-subnav" aria-label={`${data.sectorName} sections`}>
      <button type="button" class="sector-subnav-arrow sector-subnav-arrow--prev" aria-label="Scroll sections left" tabindex="-1" aria-hidden="true">‹</button>
      <div class="sector-subnav-inner">
        <a href="#challenges" class="is-active">Challenges</a>
        <a href="#how-we-help">How we help</a>
        <a href="#results">Results</a>
        <a href="#our-work">Our work</a>
        <a href="#where-to-start">Where to start</a>
      </div>
      <button type="button" class="sector-subnav-arrow sector-subnav-arrow--next" aria-label="Scroll sections right" tabindex="-1" aria-hidden="true">›</button>
    </nav>

    <section id="challenges" class="industry-section beige industry-reveal" data-subnav-section>
      <div class="industry-inner">
        <div class="industry-head">
          <div class="eyebrow">WHY THIS SECTOR IS DIFFERENT</div>
          <h2 class="industry-title">{data.challengesTitle}</h2>
          <p>{data.challengesNote}</p>
        </div>
        <div class="challenge-grid">
          {data.challenges.map((challenge) => {
            const Glyph = glyphs[challenge.glyph];
            return (
              <article class="challenge-item">
                <span class="challenge-glyph" aria-hidden="true"><Glyph /></span>
                <h3>{challenge.title}</h3>
                <p>{challenge.body}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section id="how-we-help" class="industry-section white industry-reveal" data-subnav-section>
      <div class="industry-inner">
        <div class="industry-head">
          <div class="eyebrow">HOW WE HELP IN {data.sectorName.toUpperCase()}</div>
          <h2 class="industry-title">{data.selectorTitle}</h2>
          <p>{data.selectorNote}</p>
        </div>
        <div class="service-selector" data-service-selector>
          <div class="selector-list" role="list" aria-label={`${data.sectorName} service selector`}>
            {Object.entries(serviceMeta).map(([pillar, meta], index) => (
              <button
                class:list={["selector-item", { "is-active": index === 0 }]}
                type="button"
                data-pillar={pillar}
                data-title={data.services[pillar].title}
                data-copy={data.services[pillar].copy}
                data-description={data.services[pillar].description}
                data-challenges={data.services[pillar].challenges.join("|")}
                data-deliverables={data.services[pillar].deliverables.join("|")}
                data-href={meta.href}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="selector-icon" aria-hidden="true"><Icon name={pillar} /></span>
                <span>
                  <span class="selector-kicker">{meta.eyebrow}</span>
                  <span class="selector-service">{meta.name}</span>
                </span>
              </button>
            ))}
          </div>
          <div class="selector-panel" aria-live="polite">
            <h3 data-selector-title>{initialService.title}</h3>
            <p class="selector-panel-copy" data-selector-copy>{initialService.copy}</p>
            <p class="selector-panel-desc" data-selector-description>{initialService.description}</p>
            <p class="selector-label">Sector challenges addressed</p>
            <ul class="selector-chips" data-selector-challenges>
              {initialService.challenges.map((item) => <li>{item}</li>)}
            </ul>
            <p class="selector-label">Deliverables</p>
            <ul class="selector-deliverables" data-selector-deliverables>
              {initialService.deliverables.map((item) => <li>{item}</li>)}
            </ul>
            <a href="/services/frame/" class="btn-text" data-selector-link><span class="link-label">Explore FRAME</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </div>
      </div>
    </section>

    <section id="results" class="industry-section beige industry-reveal" data-subnav-section>
      <div class="proof-shell">
        <div class="eyebrow light">CLIENT RESULTS</div>
        <h2>{data.proofTitle}</h2>
        <p>{data.proofIntro}</p>
        <div class="proof-carousel" data-proof-carousel>
          <div class="proof-track">
            {data.proofSlides.map((slide) => (
              <article class="proof-slide">
                {slide.comment && <Fragment set:html={`<!-- ${slide.comment} -->`} />}
                <p class="proof-action">{slide.action} <span class="metric">{slide.metric}</span> {slide.rest}</p>
                <p class="proof-caption">{slide.caption}</p>
              </article>
            ))}
          </div>
          <div class="proof-controls">
            <div class="proof-dots">
              {data.proofSlides.map((_, index) => (
                <button class:list={["proof-dot", { "is-active": index === 0 }]} type="button" data-proof-dot={index} aria-label={`Show result ${index + 1}`}></button>
              ))}
            </div>
            <button class="proof-arrow" type="button" data-proof-prev aria-label="Previous result">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19"/></svg>
            </button>
            <button class="proof-arrow" type="button" data-proof-next aria-label="Next result">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="our-work" class="industry-section white industry-reveal" data-subnav-section>
      <div class="industry-inner">
        <div class="industry-head">
          <div class="eyebrow">OUR WORK</div>
          <h2 class="industry-title">Proven in practice.</h2>
        </div>
        <article class="industry-case">
          <div>
            <div class="case-sector">{data.caseStudy.sector}</div>
            {data.caseStudy.comment && <Fragment set:html={`<!-- ${data.caseStudy.comment} -->`} />}
            <div class="case-number">{data.caseStudy.metric}</div>
            <div class="case-caption">{data.caseStudy.caption}</div>
          </div>
          <div>
            <h3>{data.caseStudy.title}</h3>
            <div class="case-block"><p class="case-label">Problem</p><p>{data.caseStudy.problem}</p></div>
            <div class="case-block"><p class="case-label">Approach</p><p>{data.caseStudy.approach}</p></div>
            <div class="case-block"><p class="case-label">Outcomes</p><p>{data.caseStudy.outcome}</p></div>
            <a href="/our-work/" class="btn-text"><span class="link-label">View our work</span> <span class="ar">&rsaquo;</span></a>
          </div>
        </article>
      </div>
    </section>

    <section id="where-to-start" class="industry-section beige industry-reveal" data-subnav-section>
      <div class="industry-inner">
        <div class="industry-head">
          <div class="eyebrow">WHERE TO START</div>
          <h2 class="industry-title">{data.startTitle}</h2>
          <p>{data.startNote}</p>
        </div>
        <div class="pathway-box">
          <svg viewBox="0 0 1040 150" role="img" aria-label={`${data.sectorName} recommended service pathway`}>
            <path class="pathway-line hd-f2" d="M70 100 Q300 90 520 99 Q760 109 970 98"/>
            {stations.map((station) => (
              <a href={serviceMeta[station.pillar].href} class:list={["station-link", { "is-recommended": data.recommended.includes(station.pillar) }]} aria-label={`${station.key} service`}>
                <circle class="station-ring" cx={station.x} cy={station.y}/>
                <circle class="station-core" cx={station.x} cy={station.y}/>
                <text class="station-label" x={station.x} y="138">{station.key}</text>
              </a>
            ))}
          </svg>
        </div>
        <div class="entry-grid">
          {data.entryPoints.map((entry) => {
            const meta = serviceMeta[entry.pillar];
            return (
              <article class="entry-card">
                <span class="entry-icon" aria-hidden="true"><Icon name={entry.pillar} /></span>
                <div class="entry-kicker">{meta.eyebrow}</div>
                <h3>{meta.name}</h3>
                <p>{entry.summary}</p>
                <a href={meta.href} class="btn-text"><span class="link-label">Explore {entry.pillar.toUpperCase()}</span> <span class="ar">&rsaquo;</span></a>
              </article>
            );
          })}
        </div>
      </div>
    </section>
    </div>

    <section class="industry-section white cta-light industry-reveal">
      <div class="industry-inner cta-grid">
        <div>
          <div class="eyebrow">WORK WITH US</div>
          <h2 class="industry-title">{data.ctaTitle}</h2>
          <p>{data.ctaBody}</p>
          <a href="/contact/" class="btn-primary">Get in touch</a>
        </div>
        <div class="cta-art" aria-hidden="true">
          <Icon name={data.icon} />
        </div>
      </div>
    </section>

    <section class="industry-section white lmi-handover section-after-white industry-reveal">
      <div class="industry-inner training-inner">
        <div class="eyebrow">TRAINING</div>
        <h2 class="industry-title">Train your team in your own context.</h2>
        <p class="training-copy">Lean Methods Institute contextualises our training to {data.lmiPhrase}, not generic case studies or simulations. Your team learns the methods and tools relevant to the problems they actually face, so the capability stays with them.</p>
        <a href="https://leanmethods.com.au" class="lmi-logo-link" aria-label="Lean Methods Institute">
          <img src={lmiLogo.src} class="lmi-logo-img" alt="Lean Methods Institute" loading="lazy" />
        </a>
        <a href="https://leanmethods.com.au" class="btn-text"><span class="link-label">Explore training at Lean Methods Institute</span> <span class="ar">&rsaquo;</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const navToggle = document.querySelector(".nav-toggle");
  const navLinks = document.getElementById("nav-links");
  navToggle?.addEventListener("click", () => {
    const expanded = navToggle.getAttribute("aria-expanded") === "true";
    navToggle.setAttribute("aria-expanded", String(!expanded));
    navLinks?.classList.toggle("is-open");
    document.body.classList.toggle("nav-open");
  });

  function syncNavHeight() {
    const nav = document.querySelector(".site-nav");
    if (!nav) return;
    document.documentElement.style.setProperty("--nav-h", nav.offsetHeight + "px");
  }

  function initialiseIndustryReveals() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = Array.from(document.querySelectorAll(".industry-reveal"));
    if (reduceMotion || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("industry-reveal-enabled");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.16 });
    sections.forEach((section) => observer.observe(section));
  }

  // The sector subnav is always visible: it sits at the top of the sector
  // content on load and pins under the main nav on scroll (normal sticky).
  // No hide-until-stuck — it must never pop in or disappear near the hero.

  function initialiseSubnav() {
    const links = Array.from(document.querySelectorAll(".sector-subnav a"));
    const sections = Array.from(document.querySelectorAll("[data-subnav-section]"));
    if (!links.length || !sections.length || !("IntersectionObserver" in window)) return;
    const byId = new Map(links.map((link) => [link.getAttribute("href")?.replace("#", ""), link]));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => link.classList.remove("is-active"));
        byId.get(entry.target.id)?.classList.add("is-active");
      });
    }, { rootMargin: "-35% 0px -55% 0px", threshold: 0.01 });
    sections.forEach((section) => observer.observe(section));
  }

  // Overflow affordance: on narrow widths the tab strip scrolls horizontally with
  // the scrollbar hidden, so later tabs (e.g. "Where to start") can sit off-screen
  // with no cue. Show a chevron on each side only while the strip can scroll that
  // way; tapping it nudges the strip toward the hidden tabs. (EQT-296)
  function initialiseSubnavOverflow() {
    const nav = document.querySelector(".sector-subnav");
    const scroller = nav && nav.querySelector(".sector-subnav-inner");
    if (!nav || !scroller) return;
    const prev = nav.querySelector(".sector-subnav-arrow--prev");
    const next = nav.querySelector(".sector-subnav-arrow--next");
    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      nav.classList.toggle("can-scroll-prev", scroller.scrollLeft > 1);
      nav.classList.toggle("can-scroll-next", scroller.scrollLeft < max - 1);
    };
    const nudge = (dir) => scroller.scrollBy({ left: dir * scroller.clientWidth * 0.7, behavior: "smooth" });
    prev && prev.addEventListener("click", () => nudge(-1));
    next && next.addEventListener("click", () => nudge(1));
    scroller.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  // JS-driven pin (EQT-296). CSS position:sticky is unreliable in Safari/WebKit
  // here (drops the pin mid-page even with a clean ancestor chain), so we drive
  // the bar with position:fixed, which behaves the same in every browser.
  // A spacer holds the bar's flow space while it is lifted out. The bar pins
  // under the nav while its scope is the reading area and parks at the scope
  // bottom (released) before the next section. scope must be position:relative.
  function initialiseBarPin(bar, scope) {
    if (!bar || !scope) return;
    const spacer = document.createElement("div");
    spacer.setAttribute("aria-hidden", "true");
    spacer.style.height = "0px";
    bar.insertAdjacentElement("beforebegin", spacer);
    const navH = () => {
      const n = document.querySelector(".site-nav");
      return n ? n.offsetHeight : 81;
    };
    const update = () => {
      const barH = bar.offsetHeight;
      const spTop = spacer.getBoundingClientRect().top;
      const scBottom = scope.getBoundingClientRect().bottom;
      const nH = navH();
      if (spTop > nH) {
        bar.classList.remove("is-pinned", "is-parked");
        spacer.style.height = "0px";
      } else if (scBottom <= nH + barH) {
        bar.classList.remove("is-pinned");
        bar.classList.add("is-parked");
        spacer.style.height = barH + "px";
      } else {
        bar.classList.remove("is-parked");
        bar.classList.add("is-pinned");
        spacer.style.height = barH + "px";
      }
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  function initialiseServiceSelector(selector) {
    const buttons = Array.from(selector.querySelectorAll(".selector-item"));
    const title = selector.querySelector("[data-selector-title]");
    const copy = selector.querySelector("[data-selector-copy]");
    const description = selector.querySelector("[data-selector-description]");
    const challenges = selector.querySelector("[data-selector-challenges]");
    const deliverables = selector.querySelector("[data-selector-deliverables]");
    const link = selector.querySelector("[data-selector-link]");
    const setList = (element, values) => {
      if (!element) return;
      element.innerHTML = "";
      values.forEach((value) => {
        const item = document.createElement("li");
        item.textContent = value;
        element.appendChild(item);
      });
    };
    const select = (button) => {
      buttons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", active ? "true" : "false");
      });
      if (title) title.textContent = button.dataset.title || "";
      if (copy) copy.textContent = button.dataset.copy || "";
      if (description) description.textContent = button.dataset.description || "";
      setList(challenges, (button.dataset.challenges || "").split("|").filter(Boolean));
      setList(deliverables, (button.dataset.deliverables || "").split("|").filter(Boolean));
      if (link) {
        const pillar = (button.dataset.pillar || "").toUpperCase();
        link.setAttribute("href", button.dataset.href || "#");
        const label = link.querySelector(".link-label");
        if (label) label.textContent = `Explore ${pillar}`;
      }
    };
    buttons.forEach((button) => button.addEventListener("click", () => select(button)));
  }

  function initialiseProofCarousel(carousel) {
    const track = carousel.querySelector(".proof-track");
    if (!track) return;
    const slides = Array.from(track.querySelectorAll(".proof-slide"));
    const dots = Array.from(carousel.querySelectorAll(".proof-dot"));
    const previous = carousel.querySelector("[data-proof-prev]");
    const next = carousel.querySelector("[data-proof-next]");
    const gap = () => parseFloat(window.getComputedStyle(track).columnGap) || 0;
    const step = () => slides[0] ? slides[0].getBoundingClientRect().width + gap() : track.clientWidth;
    const sync = () => {
      const index = Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / step())));
      dots.forEach((dot, position) => dot.classList.toggle("is-active", position === index));
    };
    previous?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    dots.forEach((dot) => dot.addEventListener("click", () => track.scrollTo({ left: Number(dot.dataset.proofDot || 0) * step(), behavior: "smooth" })));
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  }

  syncNavHeight();
  window.addEventListener("resize", syncNavHeight);
  initialiseIndustryReveals();
  initialiseSubnav();
  initialiseSubnavOverflow();
  initialiseBarPin(document.querySelector(".sector-subnav"), document.querySelector(".subnav-pin-scope"));
  document.querySelectorAll("[data-service-selector]").forEach(initialiseServiceSelector);
  document.querySelectorAll("[data-proof-carousel]").forEach(initialiseProofCarousel);
</script>
